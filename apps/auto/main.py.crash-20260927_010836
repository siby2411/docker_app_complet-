            client_id = client['id']

        # Créer une pré-réservation (vente en statut 'devis' ou location 'reservee')
        if type_demande == 'location' and f.get('date_debut') and f.get('date_fin'):
            jours, tarif_j, montant_ht = calcul_prix_location(
