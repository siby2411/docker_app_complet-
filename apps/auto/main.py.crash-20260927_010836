# HELPERS PAPIERS / ALERTES
# ───────────────────────────────────────────────────────────
def jours_restants(date_expiration):
    """Retourne le nombre de jours restants (négatif si expiré)."""
    if not date_expiration:
        return None
    try:
        exp = datetime.fromisoformat(str(date_expiration)[:10]).date()
        return (exp - datetime.now().date()).days
    except Exception:
        return None


def statut_papier(date_expiration):
    """Retourne 'expire' | 'critique' | 'bientot' | 'valide'."""
    j = jours_restants(date_expiration)
    if j is None:
        return 'valide'
    if j < 0:
        return 'expire'
    if j <= 7:
        return 'critique'
    if j <= 30:
        return 'bientot'
    return 'valide'


def maj_statuts_papiers():
    """Met à jour le statut de tous les papiers + alerte WhatsApp auto."""
    papiers = query("""
        SELECT p.*, v.code AS veh_code, v.immatriculation
        FROM papiers p
        LEFT JOIN vehicules v ON v.id=p.vehicule_id
        WHERE p.date_expiration IS NOT NULL
    """)
    changes = 0
    for p in papiers:
        s = statut_papier(p['date_expiration'])
        if s != p['statut']:
            execute("UPDATE papiers SET statut=? WHERE id=?", (s, p['id']))
            changes += 1
            # Log WhatsApp d'alerte si expiré/critique
            if s in ('expire', 'critique'):
                msg = (f"⚠️ ALERTE OMEGA AUTO\n"
                       f"Document {p['type']} du véhicule {p['veh_code']} "
                       f"({p['immatriculation']})\n"
                       f"Statut : {s.upper()}\n"
                       f"Expiration : {p['date_expiration']}")
                execute("""
                    INSERT INTO whatsapp_log (destinataire, type, vehicule_id, message,
                        statut, mode, date_envoi, created_at)
                    VALUES (?,?,?,?,?,?,?,?)
                """, ('admin', 'alerte_papier', p['vehicule_id'], msg,
                      'envoye', 'simulation', datetime.now().isoformat(),
                      datetime.now().isoformat()))
    return changes


def generer_qr_papier(papier_id):
    """Génère un payload QR anti-fraude pour un papier."""
    p = query("""
        SELECT p.*, v.immatriculation, v.vin_chassis, v.code AS veh_code
        FROM papiers p
        LEFT JOIN vehicules v ON v.id=p.vehicule_id
        WHERE p.id=?
    """, (papier_id,), one=True)
    if not p:
        return None
    payload = {
        'app': 'OMEGA_AUTO',
        'type': 'PAPIER',
        'pid': p['id'],
        'veh_code': p['veh_code'],
        'immat': p['immatriculation'],
        'vin': p['vin_chassis'],
        'papier_type': p['type'],
        'numero': p['numero'],
        'emission': p['date_emission'],
        'expiration': p['date_expiration'],
        'ts': datetime.now().isoformat(),
    }
    return json.dumps(payload, ensure_ascii=False, separators=(',', ':'))


def verifier_qr_payload(payload_json):
    """Vérifie un payload QR et retourne (ok, message, data)."""
    try:
        d = json.loads(payload_json)
    except Exception:
        return False, "QR illisible", None

    if d.get('app') != 'OMEGA_AUTO':
        return False, "QR non-OMEGA", None

    if d.get('type') == 'PAPIER':
        p = query("""
            SELECT p.*, v.immatriculation, v.vin_chassis, v.code AS veh_code
            FROM papiers p
            LEFT JOIN vehicules v ON v.id=p.vehicule_id
            WHERE p.id=?
        """, (d.get('pid'),), one=True)
        if not p:
            return False, "❌ Document inconnu — FRAUDE POSSIBLE", d

        # Vérifications croisées
        alerts = []
        if p['numero'] != d.get('numero'):
            alerts.append("Numéro divergent")
        if p['vehicule_id'] != query("SELECT id FROM vehicules WHERE code=?",
                                     (d.get('veh_code'),), one=True)['id'] if query(
                                     "SELECT id FROM vehicules WHERE code=?", (d.get('veh_code'),),
                                     one=True) else True:
            alerts.append("Véhicule non concordant")
        if p['immatriculation'] != d.get('immat'):
            alerts.append("Immatriculation divergente")
        if p['vin_chassis'] != d.get('vin'):
            alerts.append("VIN/Châssis divergent")

        if alerts:
            return False, "🚨 FRAUDE DÉTECTÉE : " + " · ".join(alerts), d

        s = statut_papier(p['date_expiration'])
        if s == 'expire':
            return False, "⚠️ Document EXPIRÉ", d

        return True, f"✅ Document authentique ({p['type']})", d

    elif d.get('type') == 'VEH':
        v = query("""
            SELECT v.*, m.nom AS marque_nom, mo.nom AS modele_nom
            FROM vehicules v
            LEFT JOIN marques m ON m.id=v.marque_id
            LEFT JOIN modeles mo ON mo.id=v.modele_id
            WHERE v.id=?
        """, (d.get('vid'),), one=True)
        if not v:
            return False, "❌ Véhicule inconnu", d
        return True, f"✅ Véhicule {v['code']} authentique", d

    return False, "Type de QR inconnu", d


