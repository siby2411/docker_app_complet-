    c.setFont('Helvetica', 7)
    c.setFillColor(colors.grey)
    c.drawString(15*mm, 10*mm, "PHARMACIE PRO — Dakar, Sénégal")

    c.showPage()
    c.save()
    buf.seek(0)

    from flask import send_file
    log_action(current_user.id, 'RAPPORT_FINANCIER_PDF', 'États financiers', 'finances')
    return send_file(buf, mimetype='application/pdf',
                     download_name=f'finances_pharmacie_{datetime.now().strftime("%Y%m%d")}.pdf')


