@app.route('/stock')
@login_required
def stock_liste():
    db = get_db()
    cur = db.cursor()
    cur.execute("""
        SELECT l.*, m.nom_commercial, m.dci, o.nom AS officine_nom,
               CAST(julianday(l.date_peremption) - julianday('now') AS INTEGER) AS jours_restants
        FROM lots l
        JOIN medicaments m ON m.id=l.medicament_id
        JOIN officines o ON o.id=l.officine_id
        WHERE l.statut='disponible'
        ORDER BY l.date_peremption ASC LIMIT 300
    """)
    lots = cur.fetchall()

    rows = ''
    for l in lots:
        jours = l['jours_restants'] or 0
        color = '#10b981'
        if jours <= 30: color = '#ef4444'
        elif jours <= 90: color = '#f59e0b'

        rows += f"""
        <tr>
          <td><strong>{l['numero_lot']}</strong></td>
          <td>{l['nom_commercial']}</td>
          <td>{l['officine_nom']}</td>
          <td style="text-align:right">{l['quantite']}</td>
          <td style="color:{color};font-weight:700">{l['date_peremption']}</td>
          <td style="color:{color}">{jours} j</td>
          <td>{l['emplacement'] or '—'}</td>
        </tr>"""

    content = f"""
    <h1>📦 Stock des lots — {len(lots)}</h1>
    <div style="margin-bottom:16px;font-size:13px;color:#6b7280">
      🟢 DLC &gt; 90j · 🟠 DLC 30-90j · 🔴 DLC &lt; 30j
    </div>
    <div class="card" style="padding:0;overflow:hidden">
      <table>
        <thead><tr>
          <th>N° Lot</th><th>Médicament</th><th>Officine</th>
          <th style="text-align:right">Quantité</th><th>DLC</th>
          <th>Jours restants</th><th>Emplacement</th>
        </tr></thead>
        <tbody>{rows or '<tr><td colspan="7" style="padding:40px;text-align:center;color:#9ca3af">Aucun lot</td></tr>'}</tbody>
      </table>
    </div>
    """
    return render_page(content, active='stock', page_title='Stock')


