    y -= 6*mm
    c.drawString(15*mm, y, f"Charges (achats) : {cout:,.0f} FCFA")
    y -= 6*mm
    c.setFillColor(colors.HexColor('#047857'))
    c.setFont('Helvetica-Bold', 11)
    c.drawString(15*mm, y, f"RÉSULTAT NET : {ca_an - cout:,.0f} FCFA")

    y -= 15*mm
    c.setFillColor(colors.black)
