@app.route('/recherche')
@login_required
def recherche_globale():
    """Recherche multi-tables avec focus automatique sur le champ."""
    db = get_db()
    cur = db.cursor()
    q = request.args.get('q', '').strip()
    results = {'medicaments': [], 'ordonnances': [], 'lots': []}

    if q and len(q) >= 2:
        # Médicaments
        cur.execute("""
            SELECT m.*, c.code_interne, c.code_barre_ean13
            FROM medicaments m
            LEFT JOIN codes_produits c ON c.medicament_id=m.id AND c.type='medicament'
            WHERE m.nom_commercial LIKE ? OR m.dci LIKE ? OR m.code LIKE ? OR c.code_barre_ean13 LIKE ?
            LIMIT 20
        """, (f'%{q}%',) * 4)
        results['medicaments'] = [dict(r) for r in cur.fetchall()]

        # Ordonnances
        cur.execute("""
            SELECT * FROM ordonnances
            WHERE numero LIKE ? OR patient_nom LIKE ? OR medecin_nom LIKE ?
            LIMIT 10
        """, (f'%{q}%',) * 3)
        results['ordonnances'] = [dict(r) for r in cur.fetchall()]

        # Lots
        cur.execute("""
            SELECT l.*, m.nom_commercial, o.nom AS officine_nom
            FROM lots l
            JOIN medicaments m ON m.id=l.medicament_id
            JOIN officines o ON o.id=l.officine_id
            WHERE l.numero_lot LIKE ?
            LIMIT 10
        """, (f'%{q}%',))
        results['lots'] = [dict(r) for r in cur.fetchall()]

    total = sum(len(v) for v in results.values())

    meds_html = ''.join(f"""
        <tr>
          <td><a href="/medicament/{m['id']}" style="color:#06b6d4;text-decoration:none;font-weight:600">{m['nom_commercial']}</a></td>
          <td>{m['dci']}</td>
          <td><code>{m.get('code_interne') or '—'}</code></td>
          <td><code>{m.get('code_barre_ean13') or '—'}</code></td>
          <td style="text-align:right">{m['prix_vente']:,.0f} F</td>
        </tr>
    """ for m in results['medicaments'])

    ords_html = ''.join(f"""
        <tr>
          <td><strong>{o['numero']}</strong></td>
          <td>{o['patient_nom']}</td>
          <td>{o['medecin_nom'] or '—'}</td>
          <td>{o['statut']}</td>
        </tr>
    """ for o in results['ordonnances'])

    lots_html = ''.join(f"""
        <tr>
          <td><strong>{l['numero_lot']}</strong></td>
          <td>{l['nom_commercial']}</td>
          <td>{l['officine_nom']}</td>
          <td style="text-align:right">{l['quantite']}</td>
        </tr>
    """ for l in results['lots'])

    content = f"""
    <h1>🔍 Recherche globale</h1>

    <form method="get" style="margin-bottom:24px">
      <input type="text" name="q" id="search-input" value="{q}"
             placeholder="Nom médicament, DCI, code-barres, n° ordonnance, n° lot..."
             autofocus
             style="font-size:16px;padding:16px;border:3px solid #06b6d4;border-radius:12px;max-width:700px">
      <button type="submit" class="btn btn-primary" style="margin-left:10px;padding:16px 30px">🔍 Rechercher</button>
    </form>

    <script>
      // Focus automatique au chargement
      document.getElementById('search-input').focus();
      document.getElementById('search-input').select();

      // Raccourci Ctrl+K pour focus
      document.addEventListener('keydown', (e) => {{
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {{
          e.preventDefault();
          const input = document.getElementById('search-input');
          input.focus();
          input.select();
        }}
      }});

      // Relance auto quand on tape ≥ 2 caractères + Enter
      document.getElementById('search-input').addEventListener('keydown', (e) => {{
        if (e.key === 'Enter' && e.target.value.length >= 2) {{
          e.target.form.submit();
        }}
      }});
    </script>

    <div style="margin-top:24px;padding:14px;background:#f0f9ff;border-left:4px solid #06b6d4;border-radius:8px;font-size:13px">
      💡 <strong>Astuce</strong> : Ctrl+K pour revenir au champ. Tapez 2 caractères minimum.
      {f'<br>📊 <strong>{total} résultat(s)</strong> pour "{q}"' if q else ''}
    </div>

    {f'''
    <div class="card" style="margin-top:20px">
      <h3 style="margin-top:0;color:#0e7490">💊 Médicaments ({len(results["medicaments"])})</h3>
      <table><thead><tr><th>Nom</th><th>DCI</th><th>Code interne</th><th>Code-barre</th><th style="text-align:right">Prix</th></tr></thead>
      <tbody>{meds_html or '<tr><td colspan="5" style="text-align:center;color:#9ca3af;padding:20px">Aucun médicament</td></tr>'}</tbody></table>
    </div>

    <div class="card">
      <h3 style="margin-top:0;color:#0e7490">📋 Ordonnances ({len(results["ordonnances"])})</h3>
      <table><thead><tr><th>N°</th><th>Patient</th><th>Médecin</th><th>Statut</th></tr></thead>
      <tbody>{ords_html or '<tr><td colspan="4" style="text-align:center;color:#9ca3af;padding:20px">Aucune ordonnance</td></tr>'}</tbody></table>
    </div>

    <div class="card">
      <h3 style="margin-top:0;color:#0e7490">📦 Lots ({len(results["lots"])})</h3>
      <table><thead><tr><th>N° Lot</th><th>Médicament</th><th>Officine</th><th style="text-align:right">Qté</th></tr></thead>
      <tbody>{lots_html or '<tr><td colspan="4" style="text-align:center;color:#9ca3af;padding:20px">Aucun lot</td></tr>'}</tbody></table>
    </div>
    ''' if q else ''}
    """
    return render_page(content, active='recherche', page_title='Recherche')


