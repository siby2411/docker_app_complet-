      }}

      function removeFromCart(id) {{
        delete cart[id];
        renderCart();
      }}

      function renderCart() {{
        const cont = document.getElementById('cart-items');
        const items = Object.values(cart);
        if (items.length === 0) {{
          cont.innerHTML = '<div style="text-align:center;color:#9ca3af;padding:40px 0;font-size:13px">Panier vide</div>';
          document.getElementById('cart-total').textContent = '0 F';
          document.getElementById('btn-total').textContent = '0';
          return;
        }}
        let html = '';
        let total = 0;
        items.forEach(it => {{
          const st = it.prix * it.qte;
          total += st;
          html += '<div class="cart-line">' +
            '<div><strong>' + it.nom + '</strong><br><small style="color:#6b7280">' + it.qte + ' × ' + it.prix.toLocaleString('fr-FR') + ' F</small></div>' +
            '<div style="display:flex;align-items:center;gap:8px"><strong>' + st.toLocaleString('fr-FR') + ' F</strong>' +
            '<button onclick="removeFromCart(' + it.id + ')">✕</button></div>' +
            '</div>';
        }});
        cont.innerHTML = html;
        document.getElementById('cart-total').textContent = total.toLocaleString('fr-FR') + ' F';
        document.getElementById('btn-total').textContent = total.toLocaleString('fr-FR');
      }}

      function clearCart() {{
        cart = {{}};
        renderCart();
      }}

      function filterProducts() {{
        const q = document.getElementById('pos-search').value.toLowerCase().trim();
        document.querySelectorAll('.pos-product').forEach(el => {{
          const match = el.textContent.toLowerCase().includes(q);
          el.style.display = match ? 'block' : 'none';
        }});
      }}

      document.getElementById('pos-search').addEventListener('input', filterProducts);
      document.addEventListener('keydown', (e) => {{
        if ((e.ctrlKey || e.metaKey) && e.key === 'k') {{
          e.preventDefault();
          document.getElementById('pos-search').focus();
        }}
      }});

      async function submitSale() {{
        const items = Object.values(cart);
        if (items.length === 0) {{ alert('Panier vide'); return; }}
        const mode = document.getElementById('payment-mode').value;

        const payload = {{
          items: items.map(it => ({{ medicament_id: it.id, quantite: it.qte, prix_unitaire: it.prix }})),
          mode_paiement: mode
        }};

        try {{
          const r = await fetch('/api/pos/vente', {{
            method: 'POST',
            credentials: 'same-origin',
            headers: {{ 'Content-Type': 'application/json' }},
            body: JSON.stringify(payload)
          }});
          const data = await r.json();
          if (data.ok) {{
            alert('✅ Vente enregistrée — N° ' + data.numero + '\\nTotal : ' + data.total.toLocaleString('fr-FR') + ' F');
            clearCart();
            location.reload();
          }} else {{
            alert('❌ Erreur : ' + (data.error || 'inconnue'));
          }}
        }} catch (e) {{
          alert('❌ Erreur réseau : ' + e.message);
        }}
      }}

      // Attacher les event listeners aux cartes produit
      function attachProductListeners() {
        document.querySelectorAll('.pos-product[data-id]').forEach(el => {
          el.addEventListener('click', function() {
            const id = parseInt(this.dataset.id);
            const nom = this.dataset.nom;
            const prix = parseFloat(this.dataset.prix);
            addToCart(id, nom, prix);
          });
        });
      }

      // Appeler au chargement
      document.addEventListener('DOMContentLoaded', function() {
        attachProductListeners();
        renderCart();
      });
    </script>
    """
    return render_page(content, active='pos', page_title='POS')


@app.route('/api/pos/vente', methods=['POST'])
@login_required
def api_pos_vente():
    """Enregistre une vente depuis le POS."""
    db = get_db()
    cur = db.cursor()
    data = request.get_json() or {}
    items = data.get('items', [])
    mode = data.get('mode_paiement') or 'especes'

    if not items:
        return jsonify({'ok': False, 'error': 'Panier vide'}), 400

    try:
        # Session ouverte ?
        cur.execute("""
            SELECT * FROM caissiers_sessions
            WHERE caissier_id=? AND statut='ouverte'
            ORDER BY id DESC LIMIT 1
        """, (current_user.id,))
        session = cur.fetchone()
        if not session:
            return jsonify({'ok': False, 'error': 'Aucune caisse ouverte'}), 400

        # Calcul total
        total = sum(it['quantite'] * it['prix_unitaire'] for it in items)
        numero = f"V-{datetime.now().strftime('%Y%m%d%H%M%S')}"

        # Créer la vente
        cur.execute("""
            INSERT INTO ventes
            (numero, officine_id, caissier_id, montant_total, mode_paiement, statut, date_vente, created_at)
            VALUES (?,?,?,?,?,'payee',?,?)
        """, (numero, session['officine_id'], current_user.id, total, mode,
              datetime.now().isoformat(), datetime.now().isoformat()))
        vente_id = cur.lastrowid

        # Lignes + décrément stock
        for it in items:
            cur.execute("""
                INSERT INTO vente_lignes
                (vente_id, medicament_id, quantite, prix_unitaire, montant)
                VALUES (?,?,?,?,?)
            """, (vente_id, it['medicament_id'], it['quantite'],
                  it['prix_unitaire'], it['quantite'] * it['prix_unitaire']))

            # Décrémenter le lot le plus ancien (FIFO)
            reste = it['quantite']
            cur.execute("""
                SELECT id, quantite FROM lots
                WHERE medicament_id=? AND officine_id=? AND statut='disponible' AND quantite > 0
                ORDER BY date_peremption ASC
            """, (it['medicament_id'], session['officine_id']))
            for lot in cur.fetchall():
                if reste <= 0: break
                prend = min(reste, lot['quantite'])
                cur.execute("UPDATE lots SET quantite=quantite-? WHERE id=?",
                            (prend, lot['id']))
                reste -= prend

        db.commit()
        log_action(current_user.id, 'VENTE_POS',
                   f'{numero} — {total} F — {mode}', 'ventes', vente_id)
        return jsonify({'ok': True, 'numero': numero, 'total': total, 'vente_id': vente_id})
    except Exception as e:
        db.rollback()
        return jsonify({'ok': False, 'error': str(e)}), 500


