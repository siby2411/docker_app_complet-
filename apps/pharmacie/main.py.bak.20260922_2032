            db.rollback()
            flash(f'❌ {e}', 'error')

    cur.execute("SELECT id, nom, region FROM officines WHERE actif=1")
    offs = cur.fetchall()
    opts = ''.join(f'<option value="{o["id"]}">{o["nom"]} ({o["region"]})</option>' for o in offs)

