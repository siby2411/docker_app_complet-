@app.route('/api/codes/medicament/<int:mid>')
@login_required
def api_code_medicament(mid):
    db = get_db()
    cur = db.cursor()
    cur.execute("""
        SELECT c.*, m.nom_commercial, m.dci
        FROM codes_produits c
        JOIN medicaments m ON m.id=c.medicament_id
        WHERE c.medicament_id=? AND c.type='medicament'
        LIMIT 1
    """, (mid,))
    r = cur.fetchone()
    if not r:
        return jsonify({'error': 'code introuvable'}), 404
    return jsonify(dict(r))


