@app.route('/finances')
@login_required
def finances_dashboard():
    db = get_db()
    cur = db.cursor()

    # CA du jour / mois / an
    def sc(sql, default=0):
        try:
            cur.execute(sql)
            r = cur.fetchone()
            return r[0] if r and r[0] is not None else default
        except Exception:
            return default

    ca_jour = sc("SELECT COALESCE(SUM(montant_total),0) FROM ventes WHERE date(date_vente)=date('now')")
    ca_mois = sc("SELECT COALESCE(SUM(montant_total),0) FROM ventes WHERE strftime('%Y-%m',date_vente)=strftime('%Y-%m','now')")
    ca_an = sc("SELECT COALESCE(SUM(montant_total),0) FROM ventes WHERE strftime('%Y',date_vente)=strftime('%Y','now')")
    nb_ventes = sc("SELECT COUNT(*) FROM ventes")
    panier_moyen = (ca_an / nb_ventes) if nb_ventes > 0 else 0

    # Charges estimées : achats fournisseurs (via lots)
    charges_stock = sc("SELECT COALESCE(SUM(quantite * prix_achat_unitaire),0) FROM lots WHERE statut='disponible'")
    # Valeur du stock de vente
    valeur_stock_vente = sc("""
        SELECT COALESCE(SUM(l.quantite * m.prix_vente),0)
        FROM lots l JOIN medicaments m ON m.id=l.medicament_id
        WHERE l.statut='disponible'
    """)

    # Marge théorique
    cout_achat = sc("""
        SELECT COALESCE(SUM(l.quantite * l.prix_achat_unitaire),0)
        FROM lots l WHERE l.statut='disponible'
    """)
    marge_brute = valeur_stock_vente - cout_achat

    # Espèces attendues en caisse (sessions ouvertes)
