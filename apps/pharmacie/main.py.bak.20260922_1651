@app.route('/rapports')
@login_required
def rapports_index():
    db = get_db()
    cur = db.cursor()
    cur.execute("""
        SELECT m.categorie,
               COUNT(DISTINCT m.id) AS nb_meds,
               COALESCE(SUM(l.quantite),0) AS stock_total
        FROM medicaments m
        LEFT JOIN lots l ON l.medicament_id=m.id AND l.statut='disponible'
