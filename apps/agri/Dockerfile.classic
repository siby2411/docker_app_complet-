FROM python:3.10-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONFAULTHANDLER=1
ENV PIP_NO_CACHE_DIR=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1
ENV PIP_DEFAULT_TIMEOUT=300
ENV PIP_RETRIES=10

# Dépendances système pour géo + IA
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ python3-dev \
    libgdal-dev libgeos-dev libproj-dev \
    libjpeg-dev zlib1g-dev \
    sqlite3 curl wget \
    && rm -rf /var/lib/apt/lists/* || true

WORKDIR /app

COPY requirements.txt .

RUN pip install --upgrade pip setuptools wheel --quiet \
        --index-url https://pypi.tuna.tsinghua.edu.cn/simple \
        --trusted-host pypi.tuna.tsinghua.edu.cn \
        --timeout 300 --retries 10 && \
    pip install -r requirements.txt \
        --index-url https://pypi.tuna.tsinghua.edu.cn/simple \
        --trusted-host pypi.tuna.tsinghua.edu.cn \
        --timeout 300 --retries 10

COPY main.py /app/
COPY auth.py /app/
COPY init_db.py /app/
COPY init_db_v2.py /app/
COPY crud.py /app/
COPY agri_logic.py /app/
COPY agri_ia.py /app/
COPY agri_iot.py /app/
COPY agri_finance.py /app/
COPY rapports.py /app/
COPY portail.py /app/
COPY entrypoint.sh /app/

RUN mkdir -p /app/data /app/data/documents /app/data/photos /app/data/uploads \
             /app/data/satellite /app/data/exports && \
    chmod +x /app/entrypoint.sh && \
    chmod 755 /app/data

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]
