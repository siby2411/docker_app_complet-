@app.route('/consultations')
@login_required
def consultations_liste():
    db = get_db()
    cur = db.cursor()
    statut_f = request.args.get('statut', '')

    sql = """
        SELECT c.*, m.nom AS medecin_nom, m.prenom AS medecin_prenom,
               p.nom_encrypted, p.prenom_encrypted, p.code AS patient_code
        FROM consultations c
        LEFT JOIN medecins m ON m.id=c.medecin_id
        LEFT JOIN patients p ON p.id=c.patient_id
        WHERE 1=1
    """
    params = []
    if statut_f:
        sql += " AND c.statut=?"
        params.append(statut_f)
    sql += " ORDER BY c.id DESC LIMIT 200"
    cur.execute(sql, params)
    consult_rows = cur.fetchall()

    stats = {}
    for k, s in [
        ('total', "SELECT COUNT(*) FROM consultations"),
        ('planifiee', "SELECT COUNT(*) FROM consultations WHERE statut='planifiee'"),
        ('en_cours', "SELECT COUNT(*) FROM consultations WHERE statut='en_cours'"),
        ('terminee', "SELECT COUNT(*) FROM consultations WHERE statut='terminee'"),
    ]:
        cur.execute(s)
