    content += '<div class="card"><h2>💬 Chat sécurisé (AES-256)</h2>'
    content += '<div style="background:#f8fafc;padding:14px;border-radius:8px;height:180px;overflow-y:auto;margin-bottom:12px">'
    content += '<div style="font-size:12.5px;color:#94a3b8;text-align:center;padding:20px">🔐 Messages chiffrés avant envoi</div>'
    content += '</div>'
    content += '<div style="display:flex;gap:8px">'
