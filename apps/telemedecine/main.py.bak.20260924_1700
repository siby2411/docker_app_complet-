      } catch (e) {
        alert('❌ Caméra/micro non accessible : ' + e.message);
      }
    }

    function toggleMute() {
      if (localStream) {
        micEnabled = !micEnabled;
        localStream.getAudioTracks().forEach(t => t.enabled = micEnabled);
        document.getElementById('btn-mute').textContent = micEnabled ? '🎤 Couper micro' : '🔇 Activer micro';
      }
