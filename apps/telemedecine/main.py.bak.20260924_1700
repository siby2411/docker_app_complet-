    content += '<tr><td><strong>Token patient</strong></td><td><code style="font-size:10px">' + str((sv["token_patient"] if sv else "")[:60]) + '...</code></td></tr>'
    content += '<tr><td><strong>Statut</strong></td><td>' + sv_statut + '</td></tr>'
