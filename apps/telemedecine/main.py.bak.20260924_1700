@app.route('/rgpd/audit/export.csv')
@login_required
def rgpd_audit_export():
    """Export audit complet (obligation RGPD Article 30)."""
    import csv
    db = get_db()
    cur = db.cursor()
    cur.execute("""
        SELECT a.created_at, u.username, a.action, a.entity, a.entity_id, a.details, a.ip, a.user_agent
        FROM audit_rgpd a
        LEFT JOIN users u ON u.id=a.user_id
        ORDER BY a.id DESC LIMIT 10000
    """)
    rows = cur.fetchall()

    si = io.StringIO()
    w = csv.writer(si, delimiter=';')
    w.writerow(['Date', 'Utilisateur', 'Action', 'Entity', 'Entity ID', 'Détails', 'IP', 'User Agent'])
    for r in rows:
        w.writerow([r['created_at'], r['username'], r['action'], r['entity'],
                    r['entity_id'], r['details'], r['ip'], r['user_agent']])

    log_action(current_user.id, 'EXPORT_AUDIT_RGPD', f'{len(rows)} lignes', 'audit_rgpd')
    return Response(si.getvalue(), mimetype='text/csv',
                    headers={'Content-Disposition': f'attachment;filename=audit_rgpd_{datetime.now().strftime("%Y%m%d")}.csv'})


