@app.route('/ordonnances/nouvelle', methods=['GET', 'POST'])
@login_required
def ordonnances_nouvelle():
    db = get_db()
    cur = db.cursor()
    consultation_id_pre = int(request.args.get('consultation_id') or 0)

    if request.method == 'POST':
        try:
            consultation_id = int(request.form.get('consultation_id') or 0)
            medicaments = request.form.get('medicaments') or ''
            posologie = request.form.get('posologie') or ''
            duree = int(request.form.get('duree_jours') or 7)
            instructions = request.form.get('instructions') or ''

            cur.execute("SELECT patient_id, medecin_id FROM consultations WHERE id=?", (consultation_id,))
            c = cur.fetchone()
            if not c:
                raise ValueError('Consultation introuvable')

            # Signature RSA
            payload = f'ORD|{consultation_id}|{c["patient_id"]}|{c["medecin_id"]}|{medicaments}'
            signature = sign_ordonnance(payload) or 'unsigned'

            cur.execute("""
                INSERT INTO ordonnances (numero, consultation_id, patient_id, medecin_id,
                                           date_emission, medicaments, posologie, duree_jours,
                                           instructions, signature_rsa, statut, created_at)
                VALUES (?,?,?,?,?,?,?,?,?,?, 'emise', ?)
            """, (None, consultation_id, c['patient_id'], c['medecin_id'],
                  datetime.now().strftime('%Y-%m-%d'),
                  medicaments, posologie, duree, instructions,
                  signature, datetime.now().isoformat()))
            db.commit()
            ord_id = cur.lastrowid
            log_action(current_user.id, 'CREATE_ORDONNANCE',
                       f'Ordonnance #{ord_id} signée RSA', 'ordonnances', ord_id)
