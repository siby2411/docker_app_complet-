        patients.append({
            'id': p['id'], 'code': p['code'], 'nom': nom, 'prenom': prenom,
            'telephone': tel, 'date_naissance': dn, 'sexe': p['sexe'],
            'ville': p['ville'], 'groupe_sanguin': p['groupe_sanguin'], 'statut': p['statut'],
