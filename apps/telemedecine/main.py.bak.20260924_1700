@app.route('/ordonnances/<int:oid>/qr.png')
def ordonnances_qr(oid):
    """QR code de l'ordonnance (public, pour pharmacie)."""
    import qrcode
    db = get_db()
    cur = db.cursor()
    cur.execute("SELECT numero FROM ordonnances WHERE id=?", (oid,))
    o = cur.fetchone()
    if not o:
        return redirect('/')
    qr_data = 'TELEMED|ORD|' + str(oid) + '|' + (o['numero'] or '')
    qr = qrcode.QRCode(version=2, error_correction=qrcode.constants.ERROR_CORRECT_M, box_size=8, border=2)
    qr.add_data(qr_data)
    qr.make(fit=True)
    img = qr.make_image(fill_color='#0891b2', back_color='white')
    buf = io.BytesIO()
    img.save(buf, format='PNG')
    buf.seek(0)
    return send_file(buf, mimetype='image/png')


@app.route('/ordonnances/<int:oid>/pdf')
@login_required
def ordonnances_pdf(oid):
    from reportlab.lib.pagesizes import A4
    from reportlab.pdfgen import canvas
    from reportlab.lib.units import mm
    from reportlab.lib import colors
    import qrcode

    db = get_db()
    cur = db.cursor()
    cur.execute("""
        SELECT o.*, m.nom AS medecin_nom, m.prenom AS medecin_prenom, m.specialite, m.numero_ordre,
               p.nom_encrypted, p.prenom_encrypted, p.date_naissance_encrypted, p.code AS patient_code
        FROM ordonnances o
        LEFT JOIN medecins m ON m.id=o.medecin_id
        LEFT JOIN patients p ON p.id=o.patient_id
        WHERE o.id=?
    """, (oid,))
    o = cur.fetchone()
    if not o:
        flash('❌ Ordonnance introuvable', 'error')
        return redirect('/ordonnances')

    patient_nom = '—'
    if o['nom_encrypted'] and o['prenom_encrypted']:
        pn = decrypt_data(o['nom_encrypted']) or '?'
        pp = decrypt_data(o['prenom_encrypted']) or '?'
        patient_nom = pp + ' ' + pn

    payload = f'ORD|{o["consultation_id"]}|{o["patient_id"]}|{o["medecin_id"]}|{o["medicaments"]}'
    sig_ok = verify_signature(payload, o['signature_rsa']) if o['signature_rsa'] and o['signature_rsa'] != 'unsigned' else False

    # QR
    qr = qrcode.make('TELEMED|ORD|' + str(oid) + '|' + str(o['numero']))
    qr_buf = io.BytesIO()
    qr.save(qr_buf, format='PNG')
    qr_buf.seek(0)

    buf = io.BytesIO()
    c = canvas.Canvas(buf, pagesize=A4)
    w, h = A4

    # Header
    c.setFillColor(colors.HexColor('#0891b2'))
    c.rect(0, h - 35*mm, w, 35*mm, fill=1, stroke=0)
    c.setFillColor(colors.HexColor('#10b981'))
    c.rect(0, h - 35*mm, w, 3*mm, fill=1, stroke=0)
    c.setFillColor(colors.white)
    c.setFont('Helvetica-Bold', 18)
    c.drawString(15*mm, h - 15*mm, "OMEGA TÉLÉMÉDECINE")
    c.setFont('Helvetica', 10)
    c.drawString(15*mm, h - 22*mm, "ORDONNANCE MÉDICALE NUMÉRIQUE")
    c.setFont('Helvetica-Bold', 12)
    c.drawRightString(w - 15*mm, h - 15*mm, str(o["numero"] or ""))
    c.setFont('Helvetica', 9)
    c.drawRightString(w - 15*mm, h - 22*mm, "Émise le " + str((o["date_emission"] or "")[:10]))

    # Patient
    y = h - 50*mm
    c.setFillColor(colors.black)
    c.setFont('Helvetica-Bold', 11)
    c.drawString(15*mm, y, "PATIENT")
    y -= 6*mm
    c.setFont('Helvetica', 10)
    c.drawString(15*mm, y, str(patient_nom))
    y -= 5*mm
    c.drawString(15*mm, y, "Code : " + str(o["patient_code"] or ""))

    # Médecin
    y -= 8*mm
    c.setFont('Helvetica-Bold', 11)
    c.drawString(15*mm, y, "MÉDECIN")
    y -= 6*mm
    c.setFont('Helvetica', 10)
    c.drawString(15*mm, y, "Dr. " + str(o["medecin_prenom"] or "") + " " + str(o["medecin_nom"] or ""))
    y -= 5*mm
    c.drawString(15*mm, y, "Spécialité : " + str(o["specialite"] or ""))
    y -= 5*mm
    c.drawString(15*mm, y, "N° Ordre : " + str(o["numero_ordre"] or ""))

    # Prescription
    y -= 15*mm
    c.setFillColor(colors.HexColor('#f0fdf4'))
    c.rect(15*mm, y - 40*mm, w - 30*mm, 42*mm, fill=1, stroke=0)
    c.setFillColor(colors.HexColor('#047857'))
    c.setFont('Helvetica-Bold', 11)
    c.drawString(17*mm, y - 5*mm, "PRESCRIPTION")
    y -= 12*mm
    c.setFillColor(colors.black)
    c.setFont('Helvetica-Bold', 12)
    txt = str(o["medicaments"] or "")
    for i in range(0, len(txt), 70):
        c.drawString(17*mm, y, txt[i:i+70])
        y -= 6*mm
    y -= 2*mm
    c.setFont('Helvetica', 10)
    c.drawString(17*mm, y, "Posologie : " + str(o["posologie"] or "—"))
    y -= 5*mm
    c.drawString(17*mm, y, "Durée : " + str(o["duree_jours"]) + " jours")
    y -= 5*mm
    c.drawString(17*mm, y, "Instructions : " + str(o["instructions"] or "—"))

    # QR + signature
    y -= 15*mm
    qr_size = 30*mm
    c.drawImage(qr_buf, w - qr_size - 15*mm, y - qr_size, qr_size, qr_size)

    c.setFillColor(colors.HexColor('#047857') if sig_ok else colors.HexColor('#dc2626'))
    c.setFont('Helvetica-Bold', 10)
    c.drawString(15*mm, y - 5*mm, "Signature RSA-2048 : " + ("VALIDÉE ✅" if sig_ok else "INVALIDE ❌"))
    c.setFillColor(colors.grey)
    c.setFont('Helvetica', 8)
    c.drawString(15*mm, y - 12*mm, "Ordonnance vérifiable en scannant le QR code en pharmacie partenaire")
    c.drawString(15*mm, y - 17*mm, "Signée le " + str((o["date_emission"] or "")[:10]))

    # Footer
    c.setFillColor(colors.grey)
    c.setFont('Helvetica', 7)
    c.drawString(15*mm, 10*mm, "OMEGA Télémédecine · Dakar, Sénégal · Document chiffré AES-256 · RGPD conforme")
    c.drawRightString(w - 15*mm, 10*mm, "Ordonnance n° " + str(o["numero"]))

    c.showPage()
    c.save()
    buf.seek(0)

    log_action(current_user.id, 'PDF_ORDONNANCE', str(o['numero']), 'ordonnances', oid)
    return send_file(buf, mimetype='application/pdf',
                     download_name='ordonnance_' + str(o['numero']) + '.pdf')


