@app.route('/api/consultations/<int:cid>/terminer', methods=['POST'])
@login_required
def api_consultation_terminer(cid):
    db = get_db()
    cur = db.cursor()
    try:
        cur.execute("SELECT debut_video FROM sessions_video WHERE consultation_id=?", (cid,))
        sv = cur.fetchone()
        duree = 0
        if sv and sv['debut_video']:
            try:
                d = datetime.fromisoformat(sv['debut_video'])
                duree = int((datetime.now() - d).total_seconds() / 60)
            except Exception:
                pass

        cur.execute("""
            UPDATE consultations SET statut='terminee', heure_fin=?, duree_minutes=? WHERE id=?
        """, (datetime.now().isoformat(), duree, cid))
        cur.execute("""
            UPDATE sessions_video SET statut='terminee', fin_video=?, duree_reelle=? WHERE consultation_id=?
        """, (datetime.now().isoformat(), duree, cid))
        db.commit()
        log_action(current_user.id, 'VIDEO_END', f'Consultation terminée #{cid} ({duree}min)', 'consultations', cid)
        return jsonify({'ok': True, 'duree': duree})
    except Exception as e:
        db.rollback()
        return jsonify({'ok': False, 'error': str(e)}), 500


