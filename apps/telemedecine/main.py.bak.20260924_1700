          '<div style="font-size:11px;color:#64748b">' + m.expediteur + ' · ' + m.heure + '</div>' +
          '<div style="font-size:13px;color:#1e293b;margin-top:4px">' + m.contenu + '</div>' +
          '</div>'
        ).join('');
        cont.scrollTop = cont.scrollHeight;
      } catch (e) {}
    }

    setInterval(loadMessages, 3000);
    loadMessages();
    </script>
    '''
    return render_page(content, active='consultations', page_title='Salle vidéo')


