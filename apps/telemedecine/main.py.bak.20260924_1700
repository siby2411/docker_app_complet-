@app.route('/rgpd/patient/<int:pid>/delete', methods=['POST'])
@login_required
def rgpd_patient_anonymize(pid):
    """Droit à l'effacement RGPD Art. 17 — anonymisation."""
    if current_user.role not in ('admin',):
        flash('❌ Seul l\'admin peut anonymiser', 'error')
        return redirect('/patients')

    db = get_db()
    cur = db.cursor()
    try:
        anon = encrypt_data('[ANONYMISÉ RGPD]')
        cur.execute("""
            UPDATE patients SET
                nom_encrypted=?, prenom_encrypted=?,
                date_naissance_encrypted=?, telephone_encrypted=?,
                adresse_encrypted=?, allergies_encrypted=?,
                antecedents_encrypted=?, statut='anonymise'
            WHERE id=?
        """, (anon, anon, anon, anon, anon, anon, anon, pid))
        db.commit()
        log_action(current_user.id, 'RGPD_ANONYMIZE',
                   f'Patient #{pid} anonymisé (Art.17)', 'patients', pid)
        flash('✅ Patient anonymisé (RGPD Art.17)', 'success')
    except Exception as e:
        db.rollback()
        flash('❌ ' + str(e), 'error')
    return redirect('/patients')


