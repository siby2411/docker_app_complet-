def render_page(content, active='dashboard', page_title='Télémédecine'):
    from flask import get_flashed_messages
    user_name = current_user.nom_complet if current_user.is_authenticated else ''
    langue = current_user.langue if current_user.is_authenticated else 'fr'
    msgs = get_flashed_messages(with_categories=True)
    flashes = ''
    for cat, msg in msgs:
        flashes += f'<div class="flash flash-{cat}">{msg}</div>'

    return LAYOUT.format(
        title=page_title,
        user_name=user_name,
        content=content,
        flashes=flashes,
        lang=langue,
        tr_dash=tr('dashboard', langue),
        tr_med=tr('medecins', langue),
        tr_pat=tr('patients', langue),
        tr_cons=tr('consultations', langue),
        tr_ord=tr('ordonnances', langue),
        tr_phar=tr('pharmacies', langue),
        a_dash='active' if active == 'dashboard' else '',
        a_med='active' if active == 'medecins' else '',
        a_pat='active' if active == 'patients' else '',
        a_cons='active' if active == 'consultations' else '',
        a_ord='active' if active == 'ordonnances' else '',
        a_phar='active' if active == 'pharmacies' else '',
        a_suivi='active' if active == 'suivi' else '',
        a_rgpd='active' if active == 'rgpd' else '',
        lang_fr='active' if langue == 'fr' else '',
        lang_wo='active' if langue == 'wo' else '',
        lang_en='active' if langue == 'en' else '',
    )


