class User(UserMixin):
    def __init__(self, id, username, role, nom_complet, langue='fr'):
        self.id = id
        self.username = username
        self.role = role
        self.nom_complet = nom_complet
        self.langue = langue


def get_db():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    return conn


def log_action(user_id, action, details='', entity=None, entity_id=None):
    """Journal RGPD - toutes les actions sur données santé."""
    try:
        db = get_db()
        cur = db.cursor()
        cur.execute("""
            INSERT INTO audit_rgpd (user_id, action, entity, entity_id, details, ip, user_agent, created_at)
            VALUES (?,?,?,?,?,?,?,?)
        """, (user_id, action, entity, entity_id, details,
              request.remote_addr if request else '',
              request.headers.get('User-Agent', '')[:200] if request else '',
              datetime.now().isoformat()))
        db.commit()
    except Exception:
        pass


@login_manager.user_loader
def load_user(user_id):
    db = get_db()
    cur = db.cursor()
    cur.execute("SELECT * FROM users WHERE id=?", (user_id,))
    r = cur.fetchone()
    if r:
        return User(r['id'], r['username'], r['role'], r['nom_complet'], r['langue'] or 'fr')
    return None


