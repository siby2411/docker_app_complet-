@app.route('/consultations/nouvelle', methods=['GET', 'POST'])
@login_required
def consultations_nouvelle():
    db = get_db()
    cur = db.cursor()
    patient_id_pre = int(request.args.get('patient_id') or 0)
    medecin_id_pre = int(request.args.get('medecin_id') or 0)

    if request.method == 'POST':
        try:
            motif = request.form.get('motif') or ''
            symptomes = request.form.get('symptomes') or ''
            niveau = request.form.get('niveau_urgence') or 'normal'
            type_c = request.form.get('type') or 'video'
            date_c = request.form.get('date_consultation') or datetime.now().strftime('%Y-%m-%d')
            medecin_id = int(request.form.get('medecin_id') or 0)
            montant = float(request.form.get('montant') or 0)

            if montant == 0 and medecin_id:
                cur.execute("SELECT tarif_consultation FROM medecins WHERE id=?", (medecin_id,))
                r = cur.fetchone()
                if r:
                    montant = r['tarif_consultation'] or 5000

            cur.execute("""
                INSERT INTO consultations (numero, patient_id, medecin_id, date_consultation,
                                             motif, symptomes, type, statut, niveau_urgence,
                                             montant, mode_paiement, statut_paiement, created_at)
                VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?)
            """, (None,
                  int(request.form.get('patient_id') or 0),
                  medecin_id or None,
                  date_c, motif, symptomes, type_c, 'planifiee', niveau,
                  montant, request.form.get('mode_paiement') or 'mobile_money',
                  'en_attente', datetime.now().isoformat()))
            db.commit()
            log_action(current_user.id, 'CREATE_CONSULTATION',
                       f'Nouvelle consultation pour patient #{patient_id_pre}',
                       'consultations', cur.lastrowid)
            flash('✅ Consultation créée', 'success')
            return redirect('/consultations/' + str(cur.lastrowid))
        except Exception as e:
            db.rollback()
            flash('❌ ' + str(e), 'error')

    cur.execute("SELECT * FROM patients WHERE statut='actif' ORDER BY id DESC LIMIT 200")
    patients_rows = cur.fetchall()
    patients = []
    for p in patients_rows:
        patients.append({
            'id': p['id'],
            'code': p['code'],
            'nom': decrypt_data(p['nom_encrypted']) or '?',
            'prenom': decrypt_data(p['prenom_encrypted']) or '?',
        })

    cur.execute("SELECT * FROM medecins WHERE disponible=1 ORDER BY nom")
    medecins = cur.fetchall()

    opts_p = ''.join('<option value="' + str(p["id"]) + '"' + (' selected' if p["id"] == patient_id_pre else '') + '>' + str(p["code"] or "") + ' — ' + p["prenom"] + ' ' + p["nom"] + '</option>' for p in patients)
    opts_m = ''.join('<option value="' + str(m["id"]) + '"' + (' selected' if m["id"] == medecin_id_pre else '') + ' data-tarif="' + str(m["tarif_consultation"]) + '">Dr. ' + str(m["prenom"] or "") + ' ' + str(m["nom"]) + ' — ' + str(m["specialite"] or "") + '</option>' for m in medecins)

    content = '<h1>📹 Nouvelle consultation</h1>'
    content += '<form method="post" class="card" style="max-width:900px">'
    content += '<div style="display:grid;grid-template-columns:1fr 1fr;gap:16px">'
    content += '<div style="grid-column:1/-1"><label>Patient *</label><select name="patient_id" required>'
    content += '<option value="">— Sélectionner —</option>' + opts_p + '</select></div>'
    content += '<div style="grid-column:1/-1"><label>Médecin *</label><select name="medecin_id" id="medecin_select" required onchange="updateTarif()">'
    content += '<option value="">— Sélectionner —</option>' + opts_m + '</select></div>'
    content += '<div><label>Date consultation</label><input type="date" name="date_consultation" value="' + datetime.now().strftime('%Y-%m-%d') + '"></div>'
    content += '<div><label>Type</label><select name="type">'
    content += '<option value="video">📹 Vidéo</option>'
    content += '<option value="audio">📞 Audio</option>'
    content += '<option value="chat">💬 Chat</option>'
    content += '</select></div>'
    content += '<div><label>Niveau d\'urgence</label><select name="niveau_urgence">'
    content += '<option value="faible">🟢 Faible</option>'
    content += '<option value="normal" selected>🔵 Normal</option>'
    content += '<option value="urgent">🔴 Urgent</option>'
    content += '</select></div>'
    content += '<div><label>Montant (FCFA)</label><input type="number" step="500" name="montant" id="montant" value="5000"></div>'
    content += '<div><label>Mode paiement</label><select name="mode_paiement">'
    content += '<option value="mobile_money">📱 Mobile Money</option>'
    content += '<option value="especes">💵 Espèces</option>'
    content += '<option value="mutuelle">🏥 Mutuelle</option>'
    content += '</select></div>'
    content += '<div style="grid-column:1/-1"><label>Motif de consultation *</label>'
    content += '<input type="text" name="motif" required placeholder="Fièvre, toux, maux de tête..."></div>'
    content += '<div style="grid-column:1/-1"><label>Symptômes détaillés</label>'
    content += '<textarea name="symptomes" rows="3" placeholder="Description des symptômes..."></textarea></div>'
    content += '</div>'
    content += '<script>'
    content += 'function updateTarif() {'
    content += 'var sel = document.getElementById("medecin_select");'
    content += 'var opt = sel.options[sel.selectedIndex];'
