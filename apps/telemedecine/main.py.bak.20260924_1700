    content += '<div class="card"><h2>🎮 Contrôles de session</h2>'
    content += '<div style="display:flex;gap:10px;flex-wrap:wrap">'
    if sv_statut == 'attente':
        content += '<form method="post" style="display:inline"><input type="hidden" name="action" value="start"><button type="submit" class="btn btn-success">🟢 Démarrer</button></form>'
    elif sv_statut == 'active':
        content += '<form method="post" style="display:inline"><input type="hidden" name="action" value="end"><button type="submit" class="btn btn-danger">🔴 Terminer</button></form>'
