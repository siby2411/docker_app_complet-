@app.route('/consultations/<int:cid>/video', methods=['GET', 'POST'])
@login_required
def consultations_video(cid):
    db = get_db()
    cur = db.cursor()
    cur.execute("""
        SELECT c.*, m.nom AS medecin_nom, m.prenom AS medecin_prenom,
               p.nom_encrypted, p.prenom_encrypted
        FROM consultations c
        LEFT JOIN medecins m ON m.id=c.medecin_id
        LEFT JOIN patients p ON p.id=c.patient_id
        WHERE c.id=?
    """, (cid,))
    c = cur.fetchone()
    if not c:
        flash('❌ Consultation introuvable', 'error')
        return redirect('/consultations')

    cur.execute("SELECT * FROM sessions_video WHERE consultation_id=?", (cid,))
    sv = cur.fetchone()
    if not sv:
        token_patient = generate_jwt({'consultation': cid, 'role': 'patient'}, expires_hours=2)
        token_medecin = generate_jwt({'consultation': cid, 'role': 'medecin'}, expires_hours=2)
        room_id = 'omega_room_' + str(cid) + '_' + str(int(datetime.now().timestamp()))

        cur.execute("""
            INSERT INTO sessions_video (consultation_id, room_id, token_patient, token_medecin,
                                          statut, created_at)
            VALUES (?,?,?,?, 'attente', ?)
        """, (cid, room_id, token_patient, token_medecin, datetime.now().isoformat()))
        db.commit()
        cur.execute("SELECT * FROM sessions_video WHERE consultation_id=?", (cid,))
        sv = cur.fetchone()

    if request.method == 'POST':
        action = request.form.get('action') or ''
        try:
            if action == 'start':
                cur.execute("UPDATE sessions_video SET statut='active', debut_video=? WHERE consultation_id=?",
                            (datetime.now().isoformat(), cid))
                cur.execute("UPDATE consultations SET statut='en_cours' WHERE id=?", (cid,))
                db.commit()
                flash('🎥 Session vidéo démarrée', 'success')
            elif action == 'end':
                now = datetime.now()
                debut = sv['debut_video']
                duree = 0
                if debut:
                    try:
                        duree = int((now - datetime.fromisoformat(debut)).total_seconds() / 60)
                    except Exception:
                        duree = 0
                cur.execute("""
                    UPDATE sessions_video SET statut='terminee', fin_video=?, duree_reelle=?
                    WHERE consultation_id=?
                """, (now.isoformat(), duree, cid))
                cur.execute("UPDATE consultations SET statut='terminee', date_fin=? WHERE id=?",
                            (now.isoformat(), cid))
                db.commit()
                flash('✅ Session terminée', 'success')
            return redirect('/consultations/' + str(cid) + '/video')
        except Exception as e:
            db.rollback()
            flash('❌ ' + str(e), 'error')

    pn = decrypt_data(c['nom_encrypted']) or '?'
    pp = decrypt_data(c['prenom_encrypted']) or '?'
    med_nom = 'Dr. ' + str(c['medecin_prenom'] or '') + ' ' + str(c['medecin_nom'] or '')
    sv_statut = sv['statut'] if sv else 'attente'
    sv_badge = {'attente': 'badge-blue', 'active': 'badge-orange', 'terminee': 'badge-green'}.get(sv_statut, 'badge-gray')

    content = '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">'
    content += '<h1 style="margin:0">🎥 Salle vidéo <span class="badge ' + sv_badge + '">' + str(sv_statut) + '</span></h1>'
    content += '<a href="/consultations/' + str(cid) + '" class="btn btn-secondary">← Retour</a></div>'

    content += '<div style="margin-bottom:16px"><span class="secure-badge">🔐 WebRTC chiffré · Tokens JWT signés HMAC-SHA256</span></div>'

    content += '''
    <div class="video-room">
      <h3>🎥 Consultation en direct</h3>
      <p style="color:#94a3b8;margin-bottom:16px">''' + med_nom + ''' ↔ ''' + pp + ' ' + pn + '''</p>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-bottom:16px">
        <div>
          <div style="background:#1e293b;border-radius:10px;height:240px;display:flex;align-items:center;justify-content:center;font-size:60px">🩺</div>
          <div style="margin-top:8px;color:#10b981;font-weight:700">🟢 Vous</div>
        </div>
        <div>
          <div style="background:#1e293b;border-radius:10px;height:240px;display:flex;align-items:center;justify-content:center;font-size:60px">👨‍⚕️</div>
          <div style="margin-top:8px;color:#94a3b8;font-weight:700">📡 En attente</div>
        </div>
      </div>
      <div style="display:flex;gap:8px;justify-content:center">
        <button style="background:#10b981;color:#fff;border:none;padding:12px 20px;border-radius:8px;font-weight:700;cursor:pointer">🎤 Micro</button>
        <button style="background:#0891b2;color:#fff;border:none;padding:12px 20px;border-radius:8px;font-weight:700;cursor:pointer">📹 Caméra</button>
        <button style="background:#f59e0b;color:#fff;border:none;padding:12px 20px;border-radius:8px;font-weight:700;cursor:pointer">💬 Chat</button>
      </div>
