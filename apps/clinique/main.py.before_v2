.user-badge{display:flex;align-items:center;gap:10px;padding:8px 15px;background:#f0f7f9;border-radius:30px;border:1px solid #cbe4ec}
.user-badge .avatar{width:36px;height:36px;background:linear-gradient(135deg,#088395,#05bfdb);border-radius:50%;display:flex;justify-content:center;align-items:center;color:white;font-weight:700;font-size:0.9rem}
.user-badge .info{display:flex;flex-direction:column;line-height:1.2}
.user-badge .name{font-weight:600;font-size:0.85rem;color:#0a4d68}
.user-badge .role{font-size:0.7rem;color:#05bfdb;text-transform:uppercase;font-weight:600;letter-spacing:0.5px}
.btn-logout{background:#dc2626;color:white;padding:8px 15px;border-radius:8px;text-decoration:none;font-size:0.8rem;font-weight:600;transition:0.3s}
.btn-logout:hover{background:#b91c1c;transform:translateY(-1px)}
/* ============ NAV ============ */
.nav{background:white;padding:0 25px;display:flex;gap:3px;border-bottom:1px solid #e2e8f0;flex-wrap:wrap;box-shadow:0 2px 6px rgba(0,0,0,0.03)}
.nav a{padding:14px 18px;color:#475569;text-decoration:none;border-bottom:3px solid transparent;transition:0.3s;font-size:0.85rem;display:flex;align-items:center;gap:7px;font-weight:500}
.nav a:hover{color:#0a4d68;background:#f0f7f9}
.nav a.active{color:#05bfdb;border-bottom-color:#05bfdb;background:#f0f7f9;font-weight:600}
/* ============ CONTAINER ============ */
.container{max-width:1500px;margin:25px auto;padding:0 25px}
/* ============ PAGE HEADER ============ */
.page-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:25px;flex-wrap:wrap;gap:15px}
.page-header h2{font-size:1.6rem;color:#0a4d68;font-weight:700;display:flex;align-items:center;gap:12px}
