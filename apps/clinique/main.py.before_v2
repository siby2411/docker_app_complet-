.stat-card.purple{border-left-color:#7c3aed}.stat-card.purple .stat-icon{color:#7c3aed}
/* ============ CARDS ============ */
.card{background:white;border-radius:14px;padding:25px;box-shadow:0 4px 15px rgba(10,77,104,0.06);margin-bottom:20px}
.card-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;flex-wrap:wrap;gap:10px;padding-bottom:15px;border-bottom:2px solid #f0f7f9}
