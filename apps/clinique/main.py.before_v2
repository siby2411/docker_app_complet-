# ==================== SALLES ====================
@app.route('/salles')
@admin_required
def salles():
    conn = get_db()
    c = conn.cursor()
    c.execute("""SELECT s.*, si.nom as site_nom, d.nom as dept_nom FROM salles s
                 LEFT JOIN sites si ON s.site_id = si.id
                 LEFT JOIN departements d ON s.departement_id = d.id
                 WHERE s.actif=1 ORDER BY si.nom, s.batiment, s.etage, s.code""")
    rows = c.fetchall()
    conn.close()

    content = """
    <div class="page-header">
      <div>
        <h2><i class="fas fa-door-open"></i> Salles & Localisation</h2>
        <div class="page-subtitle">Bâtiments, étages et affectation des salles</div>
      </div>
    </div>
    <div class="card">
      <div class="table-wrap">
        <table>
          <thead><tr><th>Code</th><th>Salle</th><th>Site</th><th>Bâtiment</th><th>Étage</th><th>Type</th><th>Département</th><th>Capacité</th></tr></thead>
          <tbody>
    """
    for s in rows:
        content += f"""
        <tr>
          <td><strong>{s['code']}</strong></td>
          <td><i class="fas fa-door-closed" style="color:#05bfdb"></i> {s['nom']}</td>
          <td>{s['site_nom'] or '-'}</td>
          <td><span class="badge badge-info"><i class="fas fa-building"></i> {s['batiment']}</span></td>
          <td>Étage {s['etage']}</td>
          <td>{s['type']}</td>
          <td>{s['dept_nom'] or '-'}</td>
          <td>{s['capacite']}</td>
        </tr>
        """
    content += "</tbody></table></div></div>"
    return render_page(content, active='salles', page_title='Salles')


# ==================== FACTURATION ====================
@app.route('/facturation')
@role_required('admin', 'caisse')
def facturation():
    conn = get_db()
    c = conn.cursor()
    c.execute("""SELECT f.*, p.nom as p_nom, p.prenom as p_prenom, p.numero_dossier
                 FROM factures f JOIN patients p ON f.patient_id = p.id
                 ORDER BY f.date_emission DESC LIMIT 100""")
    rows = c.fetchall()

    c.execute("SELECT COALESCE(SUM(montant_total),0), COALESCE(SUM(montant_paye),0) FROM factures")
    totaux = c.fetchone()
    conn.close()

    total_emis, total_paye = totaux[0], totaux[1]
    total_impaye = total_emis - total_paye

    content = f"""
    <div class="page-header">
      <div>
        <h2><i class="fas fa-file-invoice-dollar"></i> Facturation</h2>
        <div class="page-subtitle">Gestion financière et encaissements</div>
      </div>
    </div>

    <div class="stats">
      <div class="stat-card">
        <i class="fas fa-file-invoice stat-icon"></i>
        <div class="stat-value">{total_emis:,.0f}</div>
        <div class="stat-label">Total émis (FCFA)</div>
      </div>
      <div class="stat-card green">
        <i class="fas fa-check-circle stat-icon"></i>
        <div class="stat-value">{total_paye:,.0f}</div>
        <div class="stat-label">Encaissé (FCFA)</div>
      </div>
      <div class="stat-card rose">
        <i class="fas fa-exclamation-triangle stat-icon"></i>
        <div class="stat-value">{total_impaye:,.0f}</div>
        <div class="stat-label">Impayés (FCFA)</div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h3><i class="fas fa-list"></i> Dernières factures</h3>
        <span class="badge badge-primary">{len(rows)} factures</span>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>N° Facture</th><th>Patient</th><th>Date</th><th>Montant</th><th>Payé</th><th>Reste</th><th>Mode</th><th>Statut</th></tr></thead>
          <tbody>
    """
    for f in rows:
        reste = f['montant_total'] - f['montant_paye']
        if f['statut']=='Payé':
            badge = 'badge-success'
        elif f['statut']=='Partiel':
            badge = 'badge-warning'
        else:
            badge = 'badge-danger'
        content += f"""
        <tr>
          <td><strong>{f['numero']}</strong></td>
          <td>{f['p_nom']} {f['p_prenom']}<br><small style="color:#94a3b8">{f['numero_dossier']}</small></td>
          <td>{f['date_emission'][:10]}</td>
          <td><strong>{f['montant_total']:,.0f}</strong> FCFA</td>
          <td style="color:#16a34a"><strong>{f['montant_paye']:,.0f}</strong></td>
          <td style="color:#dc2626"><strong>{reste:,.0f}</strong></td>
          <td>{f['mode_paiement'] or '-'}</td>
          <td><span class="badge {badge}">{f['statut']}</span></td>
        </tr>
        """
    content += "</tbody></table></div></div>"
    return render_page(content, active='facturation', page_title='Facturation')


# ==================== HOSPITALISATIONS ====================
@app.route('/hospitalisations')
@role_required('admin', 'medecin', 'infirmier')
def hospitalisations():
    conn = get_db()
    c = conn.cursor()
    c.execute("""SELECT h.*, p.nom as p_nom, p.prenom as p_prenom, p.numero_dossier,
                 s.nom as salle_nom, s.batiment, s.etage
                 FROM hospitalisations h
                 JOIN patients p ON h.patient_id = p.id
                 JOIN salles s ON h.salle_id = s.id
                 ORDER BY h.date_entree DESC LIMIT 100""")
    rows = c.fetchall()
    conn.close()

    content = """
    <div class="page-header">
      <div>
        <h2><i class="fas fa-bed-pulse"></i> Hospitalisations</h2>
        <div class="page-subtitle">Gestion des séjours et occupation des lits</div>
      </div>
    </div>
    <div class="card">
      <div class="table-wrap">
        <table>
          <thead><tr><th>N°</th><th>Patient</th><th>Chambre</th><th>Localisation</th><th>Lit</th><th>Entrée</th><th>Sortie</th><th>Motif</th><th>Coût/jour</th><th>Statut</th></tr></thead>
          <tbody>
    """
    for h in rows:
        badge = 'badge-warning' if h['statut']=='En cours' else 'badge-success'
        content += f"""
        <tr>
          <td><strong>{h['numero']}</strong></td>
          <td>{h['p_nom']} {h['p_prenom']}<br><small style="color:#94a3b8">{h['numero_dossier']}</small></td>
          <td>{h['salle_nom']}</td>
          <td><small><i class="fas fa-building"></i> {h['batiment']} — Étage {h['etage']}</small></td>
          <td><span class="badge badge-info">{h['lit_numero'] or '-'}</span></td>
          <td>{h['date_entree'][:10]}</td>
          <td>{h['date_sortie'][:10] if h['date_sortie'] else '<span style="color:#f59e0b">En cours</span>'}</td>
          <td>{h['motif'][:35]}</td>
          <td><strong>{h['cout_journalier']:,.0f}</strong> FCFA</td>
          <td><span class="badge {badge}">{h['statut']}</span></td>
        </tr>
        """
    content += "</tbody></table></div></div>"
    return render_page(content, active='hospitalisations', page_title='Hospitalisations')


