<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',system-ui,sans-serif}
body{background:#f0f7f9;color:#0a4d68;min-height:100vh}
/* ============ TOP BANNER OMEGA ============ */
.top-banner{background:linear-gradient(90deg,#0a4d68 0%,#088395 60%,#05bfdb 100%);color:white;padding:8px 20px;font-size:0.8rem;display:flex;justify-content:space-between;align-items:center;letter-spacing:0.5px}
