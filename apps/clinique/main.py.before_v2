}
</style>
</head>
<body>

<!-- ============ TOP BANNER OMEGA INFORMATIQUE ============ -->
<div class="top-banner">
  <div class="brand-info">
    <span><i class="fas fa-laptop-code"></i> <strong>OMEGA INFORMATIQUE</strong> — Solutions Digitales Médicales</span>
  </div>
  <div class="brand-info">
    <span><i class="fas fa-phone"></i> +221 33 800 00 00</span>
    <span><i class="fas fa-envelope"></i> contact@omega-informatique.sn</span>
    <span><i class="fas fa-location-dot"></i> Dakar, Sénégal</span>
  </div>
</div>

<!-- ============ HEADER ============ -->
<header class="header">
  <div class="logo-section">
    <div class="logo-icon"><i class="fas fa-heart-pulse"></i></div>
    <div>
      <h1>CLINIQUE <span>OMEGA</span></h1>
      <div class="subtitle"><i class="fas fa-shield-halved"></i> Gestion Médicale Conforme OMS</div>
    </div>
