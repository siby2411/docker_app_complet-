/* ============ FORMS ============ */
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.form-group{margin-bottom:15px}
.form-group label{display:block;font-weight:600;color:#0a4d68;margin-bottom:6px;font-size:0.85rem}
.form-group input,.form-group select,.form-group textarea{width:100%;padding:11px 14px;border:2px solid #e2e8f0;border-radius:8px;font-size:0.9rem;background:#f8fafc;transition:0.3s;font-family:inherit}
.form-group input:focus,.form-group select:focus,.form-group textarea:focus{outline:none;border-color:#05bfdb;background:white;box-shadow:0 0 0 4px rgba(5,191,219,0.08)}
.form-full{grid-column:1/-1}
/* ============ FOOTER ============ */
.footer{background:linear-gradient(135deg,#0a4d68,#088395);color:white;padding:25px;margin-top:50px;text-align:center;font-size:0.85rem}
