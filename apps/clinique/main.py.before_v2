/* ============ BUTTONS ============ */
.btn{padding:10px 18px;border:none;border-radius:8px;cursor:pointer;font-weight:600;display:inline-flex;align-items:center;gap:8px;text-decoration:none;transition:0.3s;font-size:0.85rem}
.btn-primary{background:linear-gradient(135deg,#0a4d68,#088395);color:white;box-shadow:0 4px 12px rgba(10,77,104,0.25)}
