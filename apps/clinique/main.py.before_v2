  <div class="user-section">
    {% if current_user and current_user.is_authenticated %}
    <div class="user-badge">
      <div class="avatar">{{ current_user.prenom[0] if current_user.prenom else 'U' }}{{ current_user.nom[0] if current_user.nom else '' }}</div>
      <div class="info">
        <span class="name">{{ current_user.prenom }} {{ current_user.nom }}</span>
        <span class="role">{{ current_user.role }}</span>
      </div>
    </div>
    <a href="/logout" class="btn-logout"><i class="fas fa-right-from-bracket"></i> Déconnexion</a>
    {% endif %}
  </div>
</header>

<!-- ============ NAVIGATION ============ -->
<nav class="nav">
  <a href="/" class="{{ 'active' if active=='dashboard' else '' }}"><i class="fas fa-chart-pie"></i> Tableau de bord</a>
  {% if current_user and current_user.is_authenticated %}
    {% if current_user.role in ['admin','medecin','infirmier'] %}
    <a href="/patients" class="{{ 'active' if active=='patients' else '' }}"><i class="fas fa-hospital-user"></i> Patients</a>
    {% endif %}
    {% if current_user.role in ['admin','medecin'] %}
    <a href="/consultations" class="{{ 'active' if active=='consultations' else '' }}"><i class="fas fa-stethoscope"></i> Consultations</a>
    {% endif %}
    {% if current_user.role in ['admin','medecin','infirmier'] %}
    <a href="/medecins" class="{{ 'active' if active=='medecins' else '' }}"><i class="fas fa-user-doctor"></i> Médecins</a>
    {% endif %}
    {% if current_user.role in ['admin'] %}
    <a href="/personnel" class="{{ 'active' if active=='personnel' else '' }}"><i class="fas fa-users"></i> Personnel</a>
    <a href="/departements" class="{{ 'active' if active=='departements' else '' }}"><i class="fas fa-building"></i> Départements</a>
    <a href="/salles" class="{{ 'active' if active=='salles' else '' }}"><i class="fas fa-door-open"></i> Salles</a>
    {% endif %}
    {% if current_user.role in ['admin','caisse'] %}
    <a href="/facturation" class="{{ 'active' if active=='facturation' else '' }}"><i class="fas fa-file-invoice-dollar"></i> Facturation</a>
    {% endif %}
    {% if current_user.role in ['admin','medecin','infirmier'] %}
    <a href="/hospitalisations" class="{{ 'active' if active=='hospitalisations' else '' }}"><i class="fas fa-bed-pulse"></i> Hospitalisations</a>
    {% endif %}
  {% endif %}
</nav>

<!-- ============ CONTAINER ============ -->
<div class="container">
  {% with messages = get_flashed_messages(with_categories=true) %}
    {% if messages %}{% for cat, msg in messages %}
      <div class="flash flash-{{ cat }}"><i class="fas fa-circle-info"></i> {{ msg }}</div>
    {% endfor %}{% endif %}
  {% endwith %}

  {% block content %}{% endblock %}
</div>

<!-- ============ FOOTER ============ -->
<footer class="footer">
  <div>&copy; 2026 <strong>CLINIQUE OMEGA</strong> — Tous droits réservés</div>
  <div class="footer-sub">
    <i class="fas fa-code"></i> Développé par <strong>OMEGA INFORMATIQUE</strong> — Solutions digitales médicales · Dakar, Sénégal
  </div>
</footer>

</body>
</html>
"""


def render_page(content, active='dashboard', page_title='Clinique Omega'):
    """Rendu de page avec le layout médical"""
    page = HTML_BASE.replace("{% block content %}{% endblock %}", content)
    return render_template_string(page, active=active, page_title=page_title, current_user=current_user)


# ==================== DASHBOARD ====================
@app.route('/')
def index():
    if not (current_user and current_user.is_authenticated):
        return redirect('/login')

    conn = get_db()
    c = conn.cursor()

    # Stats générales
    c.execute("SELECT COUNT(*) FROM patients WHERE actif=1")
    total_patients = c.fetchone()[0]

    c.execute("SELECT COUNT(*) FROM medecins WHERE actif=1")
    total_medecins = c.fetchone()[0]

    c.execute("SELECT COUNT(*) FROM consultations WHERE date(date_consultation)=date('now')")
    consultations_jour = c.fetchone()[0]

    c.execute("SELECT COUNT(*) FROM hospitalisations WHERE statut='En cours'")
    hospitalisations = c.fetchone()[0]

    c.execute("SELECT COALESCE(SUM(montant_total),0) FROM factures WHERE strftime('%Y-%m', date_emission)=strftime('%Y-%m','now')")
    ca_mois = c.fetchone()[0]

    c.execute("SELECT COALESCE(SUM(montant_total-montant_paye),0) FROM factures WHERE statut!='Payé'")
    impayes = c.fetchone()[0]

    # Dernières consultations
    c.execute("""SELECT c.*, p.nom as p_nom, p.prenom as p_prenom, p.numero_dossier,
                 m.nom as m_nom, m.prenom as m_prenom
                 FROM consultations c
                 JOIN patients p ON c.patient_id = p.id
                 JOIN medecins m ON c.medecin_id = m.id
                 ORDER BY c.date_consultation DESC LIMIT 8""")
    dernieres_consult = c.fetchall()

    # Rendez-vous à venir
    c.execute("""SELECT r.*, p.nom as p_nom, p.prenom as p_prenom, m.nom as m_nom, m.prenom as m_prenom
                 FROM rendez_vous r
                 JOIN patients p ON r.patient_id = p.id
                 JOIN medecins m ON r.medecin_id = m.id
                 WHERE r.date_rdv >= date('now')
                 ORDER BY r.date_rdv, r.heure_rdv LIMIT 5""")
    prochains_rdv = c.fetchall()

    conn.close()

    role = current_user.role
    role_badge_class = f"badge-role-{role}"

    content = f"""
    <div class="page-header">
      <div>
        <h2><i class="fas fa-chart-pie"></i> Tableau de bord</h2>
        <div class="page-subtitle">Vue d'ensemble de l'activité clinique — {datetime.now().strftime('%A %d %B %Y')}</div>
      </div>
      <div>
        <span class="badge {role_badge_class}" style="padding:8px 16px;font-size:0.8rem">
          <i class="fas fa-user-shield"></i> Connecté : {current_user.prenom} {current_user.nom} ({role})
        </span>
      </div>
    </div>

    <div class="stats">
      <div class="stat-card">
        <i class="fas fa-hospital-user stat-icon"></i>
        <div class="stat-value">{total_patients}</div>
        <div class="stat-label">Patients actifs</div>
      </div>
      <div class="stat-card green">
        <i class="fas fa-user-doctor stat-icon"></i>
        <div class="stat-value">{total_medecins}</div>
        <div class="stat-label">Médecins</div>
      </div>
      <div class="stat-card purple">
        <i class="fas fa-stethoscope stat-icon"></i>
        <div class="stat-value">{consultations_jour}</div>
        <div class="stat-label">Consultations aujourd'hui</div>
      </div>
      <div class="stat-card amber">
        <i class="fas fa-bed-pulse stat-icon"></i>
        <div class="stat-value">{hospitalisations}</div>
        <div class="stat-label">Hospitalisations en cours</div>
      </div>
      <div class="stat-card green">
        <i class="fas fa-money-bill-wave stat-icon"></i>
        <div class="stat-value">{ca_mois:,.0f}</div>
        <div class="stat-label">CA ce mois (FCFA)</div>
      </div>
      <div class="stat-card rose">
        <i class="fas fa-triangle-exclamation stat-icon"></i>
        <div class="stat-value">{impayes:,.0f}</div>
        <div class="stat-label">Impayés (FCFA)</div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h3><i class="fas fa-clock-rotate-left"></i> Dernières consultations</h3>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>N°</th><th>Patient</th><th>Médecin</th><th>Motif</th><th>Diagnostic</th><th>Date</th><th>Statut</th></tr></thead>
          <tbody>
    """
    for cons in dernieres_consult:
        badge = 'badge-success' if cons['statut']=='Terminé' else ('badge-warning' if cons['statut']=='En cours' else 'badge-info')
        content += f"""
        <tr>
          <td><strong>{cons['numero']}</strong></td>
          <td>{cons['p_nom']} {cons['p_prenom']}<br><small style="color:#94a3b8">{cons['numero_dossier']}</small></td>
          <td>Dr {cons['m_nom']} {cons['m_prenom']}</td>
          <td>{cons['motif'][:40] if cons['motif'] else '-'}</td>
          <td>{cons['diagnostic_principal'][:35] if cons['diagnostic_principal'] else '-'}</td>
          <td>{cons['date_consultation'][:10]}</td>
          <td><span class="badge {badge}">{cons['statut']}</span></td>
        </tr>
        """
    if not dernieres_consult:
        content += '<tr><td colspan="7" class="empty"><i class="fas fa-inbox"></i><br>Aucune consultation</td></tr>'
    content += """
          </tbody>
        </table>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h3><i class="fas fa-calendar-check"></i> Prochains rendez-vous</h3>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Date</th><th>Heure</th><th>Patient</th><th>Médecin</th><th>Motif</th><th>Statut</th></tr></thead>
          <tbody>
    """
    for rdv in prochains_rdv:
        content += f"""
        <tr>
          <td><strong>{rdv['date_rdv']}</strong></td>
          <td><i class="fas fa-clock" style="color:#05bfdb"></i> {rdv['heure_rdv']}</td>
          <td>{rdv['p_nom']} {rdv['p_prenom']}</td>
          <td>Dr {rdv['m_nom']} {rdv['m_prenom']}</td>
          <td>{rdv['motif'] or '-'}</td>
          <td><span class="badge badge-info">{rdv['statut']}</span></td>
        </tr>
        """
    if not prochains_rdv:
        content += '<tr><td colspan="6" class="empty"><i class="fas fa-calendar"></i><br>Aucun rendez-vous à venir</td></tr>'
    content += """
          </tbody>
        </table>
      </div>
    </div>
    """
    return render_page(content, active='dashboard', page_title='Tableau de bord')


# ==================== PATIENTS ====================
@app.route('/patients')
@role_required('admin', 'medecin', 'infirmier')
def patients():
    conn = get_db()
    c = conn.cursor()
    c.execute("SELECT * FROM patients WHERE actif=1 ORDER BY nom, prenom")
    rows = c.fetchall()
    conn.close()

    content = """
    <div class="page-header">
      <div>
        <h2><i class="fas fa-hospital-user"></i> Patients</h2>
        <div class="page-subtitle">Gestion des dossiers patients</div>
      </div>
    </div>
    <div class="card">
      <div class="card-header">
        <h3><i class="fas fa-list"></i> Liste des patients</h3>
        <span class="badge badge-primary">""" + str(len(rows)) + """ patients</span>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>N° Dossier</th><th>Carte</th><th>Nom & Prénom</th><th>Sexe</th><th>Âge</th><th>Téléphone</th><th>Ville</th><th>Groupe</th><th>Assurance</th></tr></thead>
          <tbody>
    """
    for p in rows:
        # Calcul âge
        try:
            naiss = datetime.fromisoformat(p['date_naissance'])
            age = (datetime.now() - naiss).days // 365
        except:
            age = '?'

        sexe_icon = '<i class="fas fa-mars" style="color:#2563eb"></i>' if p['sexe']=='M' else '<i class="fas fa-venus" style="color:#db2777"></i>'
        content += f"""
        <tr>
          <td><strong>{p['numero_dossier']}</strong></td>
          <td><code style="background:#f0f7f9;padding:3px 8px;border-radius:5px;font-size:0.8rem">{p['carte_medicale']}</code></td>
          <td>{p['nom']} {p['prenom']}</td>
          <td>{sexe_icon} {p['sexe']}</td>
          <td>{age} ans</td>
          <td>{p['telephone']}</td>
          <td>{p['ville'] or '-'}</td>
          <td><span class="badge badge-info">{p['groupe_sanguin'] or '?'}</span></td>
          <td>{p['assurance'] or 'Aucune'}</td>
        </tr>
        """
    content += """
          </tbody>
        </table>
      </div>
    </div>
    """
    return render_page(content, active='patients', page_title='Patients')


# ==================== CONSULTATIONS ====================
@app.route('/consultations')
@role_required('admin', 'medecin')
def consultations():
    conn = get_db()
    c = conn.cursor()
    c.execute("""SELECT c.*, p.nom as p_nom, p.prenom as p_prenom, p.numero_dossier,
                 m.nom as m_nom, m.prenom as m_prenom
                 FROM consultations c
                 JOIN patients p ON c.patient_id = p.id
                 JOIN medecins m ON c.medecin_id = m.id
                 ORDER BY c.date_consultation DESC LIMIT 100""")
    rows = c.fetchall()
    conn.close()

    content = """
    <div class="page-header">
      <div>
        <h2><i class="fas fa-stethoscope"></i> Consultations</h2>
        <div class="page-subtitle">Historique des actes médicaux</div>
      </div>
    </div>
    <div class="card">
      <div class="card-header">
        <h3><i class="fas fa-list"></i> Toutes les consultations</h3>
        <span class="badge badge-primary">""" + str(len(rows)) + """ consultations</span>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>N°</th><th>Patient</th><th>Médecin</th><th>Motif</th><th>Diagnostic</th><th>CIM-10</th><th>Coût</th><th>Date</th><th>Statut</th></tr></thead>
          <tbody>
    """
    for cs in rows:
        badge = 'badge-success' if cs['statut']=='Terminé' else 'badge-warning'
        content += f"""
        <tr>
          <td><strong>{cs['numero']}</strong></td>
          <td>{cs['p_nom']} {cs['p_prenom']}<br><small style="color:#94a3b8">{cs['numero_dossier']}</small></td>
          <td>Dr {cs['m_nom']} {cs['m_prenom']}</td>
          <td>{cs['motif'][:35] if cs['motif'] else '-'}</td>
          <td>{cs['diagnostic_principal'][:30] if cs['diagnostic_principal'] else '-'}</td>
          <td><code>{cs['code_cim10'] or '-'}</code></td>
          <td><strong>{cs['cout']:,.0f}</strong> FCFA</td>
          <td>{cs['date_consultation'][:10]}</td>
          <td><span class="badge {badge}">{cs['statut']}</span></td>
        </tr>
        """
    content += """
          </tbody>
        </table>
      </div>
    </div>
    """
    return render_page(content, active='consultations', page_title='Consultations')


# ==================== MEDECINS ====================
@app.route('/medecins')
@role_required('admin', 'medecin', 'infirmier')
def medecins():
    conn = get_db()
    c = conn.cursor()
    c.execute("""SELECT m.*, d.nom as dept_nom FROM medecins m
                 LEFT JOIN departements d ON m.departement_id = d.id
                 WHERE m.actif=1 ORDER BY m.nom""")
    rows = c.fetchall()
    conn.close()

    content = """
    <div class="page-header">
      <div>
        <h2><i class="fas fa-user-doctor"></i> Corps Médical</h2>
        <div class="page-subtitle">Médecins et spécialistes de la clinique</div>
      </div>
    </div>
    <div class="card">
      <div class="card-header">
        <h3><i class="fas fa-list"></i> Médecins</h3>
        <span class="badge badge-success">""" + str(len(rows)) + """ praticiens</span>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Code</th><th>Nom & Prénom</th><th>Spécialité</th><th>N° Ordre</th><th>Département</th><th>Expérience</th><th>Tarif</th><th>Téléphone</th><th>Langues</th></tr></thead>
          <tbody>
    """
    for m in rows:
        content += f"""
        <tr>
          <td><strong>{m['code']}</strong></td>
          <td><i class="fas fa-user-doctor" style="color:#05bfdb"></i> Dr {m['nom']} {m['prenom']}</td>
          <td><span class="badge badge-info">{m['specialite']}</span></td>
          <td><code style="font-size:0.75rem">{m['num_ordre'] or '-'}</code></td>
          <td>{m['dept_nom'] or '-'}</td>
          <td>{m['annees_experience']} ans</td>
          <td><strong>{m['tarif_consultation']:,.0f}</strong> FCFA</td>
          <td>{m['telephone']}</td>
          <td><small>{m['langues'] or '-'}</small></td>
        </tr>
        """
    content += """
          </tbody>
        </table>
      </div>
    </div>
    """
    return render_page(content, active='medecins', page_title='Médecins')


