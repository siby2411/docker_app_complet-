/* ============ HEADER ============ */
.header{background:white;box-shadow:0 4px 20px rgba(10,77,104,0.08);padding:15px 30px;display:flex;justify-content:space-between;align-items:center;border-bottom:3px solid #05bfdb;flex-wrap:wrap;gap:15px}
.header .logo-section{display:flex;align-items:center;gap:15px}
.logo-icon{width:55px;height:55px;background:linear-gradient(135deg,#0a4d68,#05bfdb);border-radius:14px;display:flex;justify-content:center;align-items:center;color:white;font-size:1.6rem;box-shadow:0 6px 20px rgba(10,77,104,0.25)}
.header h1{font-size:1.5rem;color:#0a4d68;font-weight:700;line-height:1.1}
.header h1 span{color:#05bfdb;font-weight:300}
.header .subtitle{font-size:0.75rem;color:#64748b;margin-top:3px;letter-spacing:0.5px;text-transform:uppercase}
