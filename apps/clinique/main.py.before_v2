"""
Plateforme de gestion Clinique Omega
Design médical haut de gamme — Développé par Omega Informatique
"""
from flask import Flask, render_template_string, request, redirect, url_for, flash, jsonify
from werkzeug.middleware.proxy_fix import ProxyFix
import sqlite3
import os
from datetime import datetime, timedelta

# ==================== APP ====================
app = Flask(__name__)
app.secret_key = 'omega_clinique_2026_secret_key'
app.wsgi_app = ProxyFix(app.wsgi_app, x_for=1, x_proto=1, x_host=1)

DB_PATH = "/app/data/clinique.db"

# ==================== AUTH ====================
try:
    from auth import init_auth, log_action, role_required, admin_required, staff_required, medecin_required, caisse_required
    init_auth(app)
    AUTH_OK = True
    print("[AUTH] ✅ Module auth chargé")
except Exception as e:
    print(f"[AUTH] ⚠️ {e}")
    AUTH_OK = False
    def role_required(*r):
        def deco(f): return f
        return deco
    def admin_required(f): return f
    def staff_required(f): return f
    def medecin_required(f): return f
    def caisse_required(f): return f
    def log_action(*a, **k): pass

try:
    from flask_login import current_user, login_required
except ImportError:
    current_user = None
    def login_required(f): return f

# ==================== DB ====================
def get_db():
    conn = sqlite3.connect(DB_PATH, timeout=30.0)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA busy_timeout=30000")
    conn.execute("PRAGMA journal_mode=WAL")
    return conn


# ==================== DESIGN MÉDICAL HAUT DE GAMME ====================
HTML_BASE = """
<!DOCTYPE html>
<html lang="fr">
<head>
