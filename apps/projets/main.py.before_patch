  .hero h1{font-size:1.7rem}
  .top-banner{flex-direction:column;gap:5px;text-align:center}
}
</style>
</head>
<body>

<!-- TOP BANNER -->
<div class="top-banner">
  <div class="brand-info">
    <span><i class="fas fa-diagram-project"></i> <strong>OMEGA PROJETS</strong> — Gestion de projets de haut niveau</span>
  </div>
  <div class="brand-info">
    <span class="certif">PMI®</span>
    <span class="certif">PRINCE2</span>
    <span class="certif">ISO 21500</span>
    <span class="certif">UEMOA</span>
  </div>
</div>

<!-- HEADER -->
<header class="header">
  <div class="logo-section">
    <div class="logo-icon"><i class="fas fa-diagram-project"></i></div>
    <div>
      <h1>OMEGA <span>PROJETS</span></h1>
      <div class="subtitle"><i class="fas fa-award"></i> Excellence PMI / PRINCE2</div>
    </div>
  </div>
  <div class="user-section">
    {% if current_user and current_user.is_authenticated %}
    <div class="user-badge">
      <div class="avatar">{{ current_user.prenom[0] if current_user.prenom else 'U' }}{{ current_user.nom[0] if current_user.nom else '' }}</div>
      <div class="info">
        <span class="name">{{ current_user.prenom }} {{ current_user.nom }}</span>
        <span class="role">{{ current_user.role }}</span>
      </div>
    </div>
    <a href="/logout" class="btn-logout"><i class="fas fa-right-from-bracket"></i> Déconnexion</a>
    {% endif %}
  </div>
</header>

<!-- NAV -->
<nav class="nav">
  <a href="/" class="{{ 'active' if active=='dashboard' else '' }}"><i class="fas fa-chart-pie"></i> Dashboard</a>
  {% if current_user and current_user.is_authenticated %}
    {% if current_user.role in ['admin','directeur','chef_projet','chef_chantier','membre','observateur'] %}
    <a href="/projets" class="{{ 'active' if active=='projets' else '' }}"><i class="fas fa-project-diagram"></i> Projets</a>
    {% endif %}
    {% if current_user.role in ['admin','directeur','chef_projet','chef_chantier'] %}
    <a href="/taches" class="{{ 'active' if active=='taches' else '' }}"><i class="fas fa-tasks"></i> Tâches</a>
    {% endif %}
    {% if current_user.role in ['admin','directeur','chef_projet'] %}
    <a href="/planning" class="{{ 'active' if active=='planning' else '' }}"><i class="fas fa-calendar-alt"></i> Planning</a>
    {% endif %}
    {% if current_user.role in ['admin','directeur','chef_projet','chef_chantier'] %}
    <a href="/ressources" class="{{ 'active' if active=='ressources' else '' }}"><i class="fas fa-users"></i> Ressources</a>
    {% endif %}
    {% if current_user.role in ['admin','directeur','chef_projet'] %}
    <a href="/budget" class="{{ 'active' if active=='budget' else '' }}"><i class="fas fa-money-bill-wave"></i> Budget</a>
    {% endif %}
    {% if current_user.role in ['admin','directeur','chef_projet','chef_chantier'] %}
    <a href="/risques" class="{{ 'active' if active=='risques' else '' }}"><i class="fas fa-exclamation-triangle"></i> Risques</a>
    {% endif %}
    {% if current_user.role in ['admin','directeur'] %}
    <a href="/evm" class="{{ 'active' if active=='evm' else '' }}"><i class="fas fa-chart-line"></i> EVM</a>
    <a href="/rapports" class="{{ 'active' if active=='rapports' else '' }}"><i class="fas fa-file-alt"></i> Rapports</a>
    {% endif %}
    {% if current_user.role in ['admin','directeur','chef_projet','chef_chantier','membre'] %}
    <a href="/feuilles-temps" class="{{ 'active' if active=='feuilles' else '' }}"><i class="fas fa-clock"></i> Timesheets</a>
    {% endif %}
    {% if current_user.role == 'admin' %}
    <a href="/utilisateurs" class="{{ 'active' if active=='utilisateurs' else '' }}"><i class="fas fa-user-shield"></i> Utilisateurs</a>
    {% endif %}
  {% endif %}
</nav>

<!-- CONTAINER -->
<div class="container">
  {% with messages = get_flashed_messages(with_categories=true) %}
    {% if messages %}{% for cat, msg in messages %}
      <div class="flash flash-{{ cat }}"><i class="fas fa-circle-info"></i> {{ msg }}</div>
    {% endfor %}{% endif %}
  {% endwith %}

  {% block content %}{% endblock %}
</div>

<!-- FOOTER -->
<footer class="footer">
  <div>&copy; 2026 <strong>OMEGA PROJETS</strong> — Tous droits réservés</div>
  <div class="footer-sub">
    <i class="fas fa-code"></i> Développé par <strong>OMEGA INFORMATIQUE</strong> — Excellence PMI/PRINCE2 · Dakar, Sénégal · UEMOA
  </div>
</footer>

</body>
</html>
"""


def render_page(content, active='dashboard', page_title='Omega Projets'):
    page = HTML_BASE.replace("{% block content %}{% endblock %}", content)
    return render_template_string(page, active=active, page_title=page_title, current_user=current_user)


# ==================== HEALTHCHECK ====================
@app.route('/health')
def health():
    return jsonify(status='ok', service='projets-omega', timestamp=datetime.now().isoformat())


# ==================== DASHBOARD ====================
@app.route('/')
def index():
    if not (current_user and current_user.is_authenticated):
        return redirect('/login')

    conn = get_db()
    c = conn.cursor()

    # KPIs portefeuille
    c.execute("SELECT COUNT(*) FROM projets WHERE actif=1")
    total_projets = c.fetchone()[0]

    c.execute("SELECT COUNT(*) FROM projets WHERE actif=1 AND statut='En cours'")
    projets_en_cours = c.fetchone()[0]

    c.execute("SELECT COUNT(*) FROM projets WHERE actif=1 AND sante_projet='Vert'")
    projets_verts = c.fetchone()[0]

    c.execute("SELECT COUNT(*) FROM projets WHERE actif=1 AND sante_projet='Jaune'")
    projets_jaunes = c.fetchone()[0]

    c.execute("SELECT COUNT(*) FROM projets WHERE actif=1 AND sante_projet='Rouge'")
    projets_rouges = c.fetchone()[0]

    c.execute("SELECT COALESCE(SUM(budget_prevu), 0) FROM projets WHERE actif=1")
    budget_total = c.fetchone()[0]

    c.execute("SELECT COALESCE(SUM(budget_consomme), 0) FROM projets WHERE actif=1")
    budget_consomme = c.fetchone()[0]

    c.execute("SELECT COALESCE(AVG(avancement_pct), 0) FROM projets WHERE actif=1")
    avancement_moyen = c.fetchone()[0]

    # Risques ouverts
    c.execute("SELECT COUNT(*) FROM risques WHERE statut='Ouvert'")
    risques_ouverts = c.fetchone()[0]

    c.execute("""SELECT COUNT(*) FROM risques WHERE statut='Ouvert' AND niveau_risque IN ('Critique','Élevé')""")
    risques_critiques = c.fetchone()[0]

    # Tâches
    c.execute("SELECT COUNT(*) FROM taches WHERE statut='En cours'")
    taches_en_cours = c.fetchone()[0]

    c.execute("SELECT COUNT(*) FROM taches WHERE statut='À faire'")
    taches_a_faire = c.fetchone()[0]

    # Projets actifs
    c.execute("""SELECT p.*, cl.nom as client_nom, u.nom as chef_nom, u.prenom as chef_prenom,
                        pr.nom as prog_nom
                 FROM projets p
                 LEFT JOIN clients cl ON p.client_id = cl.id
                 LEFT JOIN utilisateurs u ON p.chef_projet_id = u.id
                 LEFT JOIN programmes pr ON p.programme_id = pr.id
                 WHERE p.actif=1
                 ORDER BY p.priorite DESC, p.date_fin_prevue ASC LIMIT 8""")
    projets_liste = c.fetchall()

    # Risques critiques
    c.execute("""SELECT r.*, p.nom as projet_nom
                 FROM risques r
                 JOIN projets p ON r.projet_id = p.id
                 WHERE r.statut='Ouvert' AND r.niveau_risque IN ('Critique','Élevé')
                 ORDER BY r.criticite DESC LIMIT 6""")
    risques_alerte = c.fetchall()

    # EVM dernier
    c.execute("""SELECT e.*, p.nom as projet_nom
                 FROM evm e JOIN projets p ON e.projet_id = p.id
                 ORDER BY e.date_mesure DESC LIMIT 1""")
    evm_last = c.fetchone()

    # Budget par portefeuille
    c.execute("""SELECT pf.nom, COALESCE(SUM(p.budget_prevu), 0) as budget,
                        COALESCE(SUM(p.budget_consomme), 0) as consomme
                 FROM portefeuilles pf
                 LEFT JOIN programmes pr ON pr.portefeuille_id = pf.id
                 LEFT JOIN projets p ON p.programme_id = pr.id AND p.actif=1
                 WHERE pf.actif=1
                 GROUP BY pf.id ORDER BY budget DESC""")
    par_portefeuille = c.fetchall()

    conn.close()

    content = f"""
    <div class="hero">
      <h1>Bienvenue <span>{current_user.prenom}</span> 👋</h1>
      <p>Tableau de bord portefeuille projets — Vision stratégique UEMOA temps réel</p>
      <div class="certifs">
        <span>PMI® PMBOK 7</span>
        <span>PRINCE2</span>
        <span>ISO 21500</span>
        <span>EVM</span>
        <span>UEMOA 8 pays</span>
      </div>
    </div>

    <div class="kpi-grid">
      <div class="kpi-card" style="border-top-color:#2563eb">
        <div class="kpi-icon" style="background:linear-gradient(135deg,#1e3a8a,#2563eb)">
          <i class="fas fa-project-diagram"></i>
        </div>
        <div class="kpi-content">
          <div class="kpi-label">Projets actifs</div>
          <div class="kpi-value">{total_projets}</div>
          <div class="kpi-sub">{projets_en_cours} en cours · 3 portefeuilles</div>
        </div>
      </div>

      <div class="kpi-card" style="border-top-color:#10b981">
        <div class="kpi-icon" style="background:linear-gradient(135deg,#10b981,#22c55e)">
          <i class="fas fa-check-circle"></i>
        </div>
        <div class="kpi-content">
          <div class="kpi-label">Santé portefeuille</div>
          <div class="kpi-value">
            <span class="health-dot health-vert"></span>{projets_verts}
            <span class="health-dot health-jaune" style="margin-left:10px"></span>{projets_jaunes}
            <span class="health-dot health-rouge" style="margin-left:10px"></span>{projets_rouges}
          </div>
          <div class="kpi-sub">Vert · Jaune · Rouge</div>
        </div>
      </div>

      <div class="kpi-card" style="border-top-color:#f59e0b">
        <div class="kpi-icon" style="background:linear-gradient(135deg,#d97706,#f59e0b)">
          <i class="fas fa-money-bill-wave"></i>
        </div>
        <div class="kpi-content">
          <div class="kpi-label">Budget total</div>
          <div class="kpi-value">{budget_total/1e9:.1f}B</div>
          <div class="kpi-sub">FCFA · Consommé {budget_consomme/1e9:.1f}B</div>
        </div>
      </div>

      <div class="kpi-card" style="border-top-color:#7c3aed">
        <div class="kpi-icon" style="background:linear-gradient(135deg,#7c3aed,#a855f7)">
          <i class="fas fa-chart-line"></i>
        </div>
        <div class="kpi-content">
          <div class="kpi-label">Avancement moyen</div>
          <div class="kpi-value">{avancement_moyen:.0f}%</div>
          <div class="kpi-sub">Global portefeuille</div>
        </div>
      </div>

      <div class="kpi-card" style="border-top-color:#dc2626">
        <div class="kpi-icon" style="background:linear-gradient(135deg,#dc2626,#ef4444)">
          <i class="fas fa-exclamation-triangle"></i>
        </div>
        <div class="kpi-content">
          <div class="kpi-label">Risques ouverts</div>
          <div class="kpi-value">{risques_ouverts}</div>
          <div class="kpi-sub">{risques_critiques} critiques/élevés</div>
        </div>
      </div>

      <div class="kpi-card" style="border-top-color:#0891b2">
        <div class="kpi-icon" style="background:linear-gradient(135deg,#0891b2,#06b6d4)">
          <i class="fas fa-tasks"></i>
        </div>
        <div class="kpi-content">
          <div class="kpi-label">Tâches</div>
          <div class="kpi-value">{taches_en_cours}</div>
          <div class="kpi-sub">{taches_a_faire} à faire</div>
        </div>
      </div>
    </div>

    <div style="display:grid;grid-template-columns:2fr 1fr;gap:20px">
      <div>
        <div class="card">
          <div class="card-header">
            <h3><i class="fas fa-project-diagram"></i> Projets prioritaires</h3>
            <a href="/projets" class="btn btn-primary btn-sm"><i class="fas fa-arrow-right"></i> Voir tout</a>
          </div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Code</th><th>Projet</th><th>Client</th>
                  <th>Chef</th><th>Budget</th><th>Avanc.</th><th>Santé</th>
                </tr>
              </thead>
              <tbody>
    """
    for p in projets_liste:
        health_class = 'health-vert' if p['sante_projet'] == 'Vert' else ('health-jaune' if p['sante_projet'] == 'Jaune' else 'health-rouge')
        budget_m = p['budget_prevu'] / 1e6
        av = p['avancement_pct'] or 0

        content += f"""
        <tr>
          <td><strong>{p['code']}</strong></td>
          <td>
            <div style="font-weight:700">{p['nom'][:45]}</div>
            <small style="color:#94a3b8">{p['type_projet']} · {p['methodologie']}</small>
          </td>
          <td>{p['client_nom'][:25] if p['client_nom'] else '-'}</td>
          <td>{p['chef_prenom'] or '?'} {p['chef_nom'] or ''}</td>
          <td><strong>{budget_m:,.0f}M</strong><br><small style="color:#94a3b8">FCFA</small></td>
          <td>
            <strong style="color:#2563eb">{av:.0f}%</strong>
            <div style="background:#eff6ff;border-radius:6px;height:6px;margin-top:4px;overflow:hidden">
              <div style="background:#2563eb;height:100%;width:{av}%"></div>
            </div>
          </td>
          <td><span class="health-dot {health_class}"></span>{p['sante_projet']}</td>
        </tr>
        """
    if not projets_liste:
        content += '<tr><td colspan="7" class="empty"><i class="fas fa-project-diagram"></i><br>Aucun projet</td></tr>'

    content += """
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div>
        <div class="card">
          <div class="card-header"><h3><i class="fas fa-chart-pie"></i> Budget par portefeuille</h3></div>
    """
    for pf in par_portefeuille:
        pct = (pf['consomme'] / pf['budget'] * 100) if pf['budget'] else 0
        content += f"""
        <div style="margin-bottom:15px">
          <div style="display:flex;justify-content:space-between;margin-bottom:5px">
            <span style="font-weight:700;font-size:0.85rem">{pf['nom'][:30]}</span>
            <strong style="color:#2563eb">{pf['budget']/1e9:.1f}B</strong>
          </div>
          <div style="background:#eff6ff;border-radius:6px;height:10px;overflow:hidden">
            <div style="background:{'#dc2626' if pct > 90 else ('#f59e0b' if pct > 70 else '#10b981')};height:100%;width:{pct}%"></div>
          </div>
          <small style="color:#94a3b8;font-size:0.7rem">Consommé : {pf['consomme']/1e9:.1f}B ({pct:.0f}%)</small>
        </div>
        """

    content += """
        </div>

        <div class="card" style="border-left:5px solid #dc2626">
          <div class="card-header"><h3 style="color:#991b1b"><i class="fas fa-exclamation-triangle"></i> Risques critiques</h3></div>
    """
    for r in risques_alerte:
        color = '#dc2626' if r['niveau_risque'] == 'Critique' else '#f59e0b'
        content += f"""
        <div style="padding:10px 0;border-bottom:1px dashed #fee2e2">
          <div style="display:flex;justify-content:space-between;align-items:center">
            <strong style="font-size:0.85rem;color:#991b1b">{r['code']}</strong>
            <span class="badge" style="background:{color}20;color:{color}">{r['niveau_risque']}</span>
          </div>
          <div style="font-size:0.8rem;color:#475569;margin-top:4px">{r['titre'][:60]}</div>
          <small style="color:#94a3b8;font-size:0.7rem">{r['projet_nom'][:35]}</small>
        </div>
        """
    if not risques_alerte:
        content += '<div class="empty" style="padding:20px"><i class="fas fa-check-circle" style="color:#10b981"></i><br>Aucun risque critique 🎉</div>'

    content += """
        </div>
      </div>
    </div>
    """

    if evm_last:
        spi_class = 'evm-good' if evm_last['spi'] >= 0.95 else ('evm-warning' if evm_last['spi'] >= 0.85 else 'evm-bad')
        cpi_class = 'evm-good' if evm_last['cpi'] >= 0.95 else ('evm-warning' if evm_last['cpi'] >= 0.85 else 'evm-bad')
        content += f"""
        <div class="card">
          <div class="card-header">
            <h3><i class="fas fa-chart-line"></i> EVM — Earned Value Management</h3>
            <a href="/evm" class="btn btn-primary btn-sm">Détails</a>
          </div>
          <p style="color:#64748b;font-size:0.85rem;margin-bottom:15px">
            <strong>Dernière mesure :</strong> {evm_last['date_mesure']} — {evm_last['projet_nom'][:50]}
          </p>
          <div class="kpi-grid">
            <div class="kpi-card" style="border-top-color:#2563eb">
              <div class="kpi-icon" style="background:linear-gradient(135deg,#1e3a8a,#2563eb)">
                <i class="fas fa-calendar-check"></i>
              </div>
              <div class="kpi-content">
                <div class="kpi-label">SPI (Schedule)</div>
                <div class="kpi-value"><span class="evm-badge {spi_class}">{evm_last['spi']:.2f}</span></div>
                <div class="kpi-sub">{'🟢 À l heure' if evm_last['spi'] >= 0.95 else ('🟡 Léger retard' if evm_last['spi'] >= 0.85 else '🔴 En retard')}</div>
              </div>
            </div>

            <div class="kpi-card" style="border-top-color:#10b981">
              <div class="kpi-icon" style="background:linear-gradient(135deg,#10b981,#22c55e)">
                <i class="fas fa-coins"></i>
              </div>
              <div class="kpi-content">
                <div class="kpi-label">CPI (Cost)</div>
                <div class="kpi-value"><span class="evm-badge {cpi_class}">{evm_last['cpi']:.2f}</span></div>
                <div class="kpi-sub">{'🟢 Sous budget' if evm_last['cpi'] >= 0.95 else ('🟡 Juste' if evm_last['cpi'] >= 0.85 else '🔴 Dépassement')}</div>
              </div>
            </div>

            <div class="kpi-card" style="border-top-color:#f59e0b">
              <div class="kpi-icon" style="background:linear-gradient(135deg,#d97706,#f59e0b)">
                <i class="fas fa-calculator"></i>
              </div>
              <div class="kpi-content">
                <div class="kpi-label">EAC (Estimation)</div>
                <div class="kpi-value">{evm_last['eac']/1e9:.2f}B</div>
                <div class="kpi-sub">FCFA · Budget : {evm_last['bac']/1e9:.2f}B</div>
              </div>
            </div>

            <div class="kpi-card" style="border-top-color:#dc2626">
              <div class="kpi-icon" style="background:linear-gradient(135deg,#dc2626,#ef4444)">
                <i class="fas fa-exclamation-circle"></i>
              </div>
              <div class="kpi-content">
                <div class="kpi-label">VAC (Variance)</div>
                <div class="kpi-value" style="color:{'#dc2626' if evm_last['vac'] < 0 else '#10b981'}">{evm_last['vac']/1e9:.2f}B</div>
                <div class="kpi-sub">{'🔴 Dépassement prévu' if evm_last['vac'] < 0 else '🟢 Économie prévue'}</div>
              </div>
            </div>
          </div>
        </div>
        """

    return render_page(content, active='dashboard', page_title='Dashboard')


if __name__ == '__main__':
    app.run(host='0.0.0.0', port=8000, debug=False)
