"""
Omega Projets — Plateforme de gestion de projets haut niveau
Conforme PMI / PRINCE2 / ISO 21500 — UEMOA
Design bleu corporate + accents dorés
"""
from flask import Flask, render_template_string, request, redirect, url_for, flash, jsonify
from werkzeug.middleware.proxy_fix import ProxyFix
import sqlite3
import os
from datetime import datetime, timedelta

app = Flask(__name__)
app.secret_key = 'omega_projets_2026_secret_key_premium'
app.wsgi_app = ProxyFix(app.wsgi_app, x_for=1, x_proto=1, x_host=1, x_prefix=1)

DB_PATH = "/app/data/projets.db"

# ==================== AUTH ====================
try:
    from auth import (init_auth, log_action, role_required, admin_required,
                      directeur_required, chef_required, staff_required, membre_required)
    init_auth(app)
    AUTH_OK = True
    print("[AUTH] ✅ Module auth chargé")
except Exception as e:
    print(f"[AUTH] ⚠️ {e}")
    AUTH_OK = False
    def role_required(*r):
        def d(f): return f
        return d
    def admin_required(f): return f
    def directeur_required(f): return f
    def chef_required(f): return f
    def staff_required(f): return f
    def membre_required(f): return f
    def log_action(*a, **k): pass

try:
    from flask_login import current_user, login_required
except ImportError:
    current_user = None
    def login_required(f): return f


def get_db():
    conn = sqlite3.connect(DB_PATH, timeout=30.0)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA busy_timeout=30000")
    conn.execute("PRAGMA journal_mode=WAL")
    return conn


# ==================== DESIGN CORPORATE ====================
HTML_BASE = """
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Omega Projets — {{ page_title or 'Gestion de projets' }}</title>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',system-ui,sans-serif}
body{background:#f0f4f8;color:#1e3a8a;min-height:100vh}

/* TOP BANNER */
.top-banner{background:linear-gradient(90deg,#1e3a8a 0%,#2563eb 60%,#3b82f6 100%);color:white;padding:10px 25px;font-size:0.82rem;display:flex;justify-content:space-between;align-items:center;font-weight:600;letter-spacing:0.3px}
.top-banner i{color:#fbbf24}
.top-banner .brand-info{display:flex;align-items:center;gap:20px;flex-wrap:wrap}
.top-banner strong{color:#fbbf24;font-weight:800}
.top-banner .certif{background:rgba(251,191,36,0.2);padding:3px 10px;border-radius:20px;font-size:0.7rem;letter-spacing:0.5px;font-weight:700;color:#fbbf24}

/* HEADER */
.header{background:white;box-shadow:0 4px 24px rgba(30,58,138,0.08);padding:16px 30px;display:flex;justify-content:space-between;align-items:center;border-bottom:3px solid #2563eb;flex-wrap:wrap;gap:15px}
.header .logo-section{display:flex;align-items:center;gap:15px}
.logo-icon{width:56px;height:56px;background:linear-gradient(135deg,#1e3a8a,#2563eb);border-radius:14px;display:flex;justify-content:center;align-items:center;color:white;font-size:1.7rem;box-shadow:0 8px 24px rgba(30,58,138,0.3)}
.header h1{font-size:1.55rem;color:#1e3a8a;font-weight:900;line-height:1.05;letter-spacing:-0.5px}
.header h1 span{color:#f59e0b}
.header .subtitle{font-size:0.72rem;color:#64748b;margin-top:4px;letter-spacing:1px;text-transform:uppercase;font-weight:700}
.user-section{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.user-badge{display:flex;align-items:center;gap:10px;padding:8px 16px;background:#eff6ff;border-radius:30px;border:1.5px solid #bfdbfe}
.user-badge .avatar{width:38px;height:38px;background:linear-gradient(135deg,#1e3a8a,#2563eb);border-radius:50%;display:flex;justify-content:center;align-items:center;color:white;font-weight:800;font-size:0.9rem}
.user-badge .info{display:flex;flex-direction:column;line-height:1.15}
.user-badge .name{font-weight:700;font-size:0.85rem;color:#1e3a8a}
.user-badge .role{font-size:0.68rem;color:#2563eb;text-transform:uppercase;font-weight:800;letter-spacing:0.5px}
.btn-logout{background:linear-gradient(135deg,#dc2626,#ef4444);color:white;padding:9px 16px;border-radius:10px;text-decoration:none;font-size:0.82rem;font-weight:700;transition:0.3s;box-shadow:0 4px 12px rgba(220,38,38,0.25)}
.btn-logout:hover{transform:translateY(-2px);box-shadow:0 6px 18px rgba(220,38,38,0.35)}

/* NAV */
.nav{background:white;padding:0 25px;display:flex;gap:2px;border-bottom:1px solid #dbeafe;flex-wrap:wrap;box-shadow:0 2px 8px rgba(0,0,0,0.03)}
.nav a{padding:15px 18px;color:#475569;text-decoration:none;border-bottom:3px solid transparent;transition:0.3s;font-size:0.85rem;display:flex;align-items:center;gap:7px;font-weight:600}
.nav a:hover{color:#2563eb;background:#f0f9ff}
