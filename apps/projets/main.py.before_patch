.hero::before{content:'';position:absolute;top:-80px;right:-80px;width:280px;height:280px;background:rgba(251,191,36,0.15);border-radius:50%}
.hero::after{content:'';position:absolute;bottom:-100px;left:-50px;width:220px;height:220px;background:rgba(251,191,36,0.1);border-radius:50%}
