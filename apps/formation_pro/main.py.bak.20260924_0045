        'inscriptions': sc("SELECT COUNT(*) FROM inscriptions"),
        'certificats': sc("SELECT COUNT(*) FROM certificats WHERE statut='valide'"),
        'placements': sc("SELECT COUNT(*) FROM placements WHERE statut='actif'"),
