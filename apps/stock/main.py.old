from flask import Flask, render_template_string, request, redirect, url_for, jsonify
from werkzeug.middleware.proxy_fix import ProxyFix
import sqlite3
from datetime import datetime
import os
import secrets

app = Flask(__name__)
app.secret_key = secrets.token_hex(16)

# FIX: Support pour les préfixes de proxy
app.wsgi_app = ProxyFix(app.wsgi_app, x_for=1, x_proto=1, x_host=1, x_prefix=1)

DB_PATH = "/app/data/stock.db"

# ==================== INITIALISATION ====================
def init_db():
    os.makedirs("/app/data", exist_ok=True)
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    
    # Table produits simplifiée
    c.execute("""
        CREATE TABLE IF NOT EXISTS produits (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            code TEXT UNIQUE NOT NULL,
            nom TEXT NOT NULL,
            description TEXT,
            categorie TEXT,
            prix_achat REAL DEFAULT 0,
            prix_vente REAL DEFAULT 0,
            quantite INTEGER DEFAULT 0,
            seuil_alerte INTEGER DEFAULT 5,
            unite TEXT DEFAULT 'pièce',
            emplacement TEXT,
            fournisseur_id INTEGER,
            date_creation TEXT,
            date_modification TEXT,
            statut TEXT DEFAULT 'Actif'
        )
    """)
    
    # Table fournisseurs
    c.execute("""
        CREATE TABLE IF NOT EXISTS fournisseurs (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            code TEXT UNIQUE NOT NULL,
            nom TEXT NOT NULL,
            contact TEXT,
            telephone TEXT,
            email TEXT,
            adresse TEXT,
            ville TEXT,
            pays TEXT,
            date_creation TEXT,
            statut TEXT DEFAULT 'Actif'
        )
    """)
    
    # Table clients
    c.execute("""
        CREATE TABLE IF NOT EXISTS clients (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            code TEXT UNIQUE NOT NULL,
            nom TEXT NOT NULL,
            prenom TEXT,
            email TEXT,
            telephone TEXT,
            adresse TEXT,
            ville TEXT,
            date_creation TEXT,
            statut TEXT DEFAULT 'Actif'
        )
    """)
    
    # Table factures
    c.execute("""
        CREATE TABLE IF NOT EXISTS factures (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            numero TEXT UNIQUE NOT NULL,
            client_id INTEGER NOT NULL,
            date_facture TEXT,
            date_echeance TEXT,
            statut TEXT DEFAULT 'En attente',
            montant_ht REAL DEFAULT 0,
            tva REAL DEFAULT 18,
            montant_ttc REAL DEFAULT 0,
            observations TEXT,
            date_creation TEXT
        )
    """)
    
    # Table details factures
    c.execute("""
        CREATE TABLE IF NOT EXISTS facture_details (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            facture_id INTEGER NOT NULL,
            produit_id INTEGER NOT NULL,
            quantite INTEGER DEFAULT 1,
            prix_unitaire REAL DEFAULT 0,
            remise REAL DEFAULT 0,
            total REAL DEFAULT 0
        )
    """)
    
    # Insertion des données initiales
    c.execute("SELECT COUNT(*) FROM produits")
    if c.fetchone()[0] == 0:
        # Fournisseurs
        fournisseurs = [
            ("F001", "Omega Supplies", "Mamadou Diop", "771234567", "mamadou@omega.sn", "Dakar", "Dakar", "Sénégal", datetime.now().isoformat()),
            ("F002", "Tech Import", "Aminata Fall", "772345678", "aminata@tech.sn", "Thiès", "Thiès", "Sénégal", datetime.now().isoformat())
        ]
        c.executemany("""INSERT INTO fournisseurs (code, nom, contact, telephone, email, adresse, ville, pays, date_creation, statut) 
                        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 'Actif')""", fournisseurs)
        
        # Clients
        clients = [
            ("C001", "Sarr", "Aliou", "aliou.sarr@client.sn", "771234568", "Dakar", "Dakar", datetime.now().isoformat()),
            ("C002", "Ba", "Aissatou", "aissatou.ba@client.sn", "772345679", "Thiès", "Thiès", datetime.now().isoformat())
        ]
        c.executemany("""INSERT INTO clients (code, nom, prenom, email, telephone, adresse, ville, date_creation, statut) 
                        VALUES (?, ?, ?, ?, ?, ?, ?, ?, 'Actif')""", clients)
        
        # Produits
        produits = [
            ("P001", "Cahier A4", "Cahier 96 pages", "Fourniture", 500, 1000, 150, 30, "pièce", "Etagère A1", 1, datetime.now().isoformat(), datetime.now().isoformat()),
            ("P002", "Stylo Bleu", "Stylo à bille bleu", "Fourniture", 300, 600, 200, 50, "pièce", "Etagère A2", 1, datetime.now().isoformat(), datetime.now().isoformat()),
            ("P003", "Papier A4", "Ramette 500 feuilles", "Fourniture", 2000, 3500, 50, 10, "ramette", "Etagère B1", 2, datetime.now().isoformat(), datetime.now().isoformat())
        ]
        c.executemany("""INSERT INTO produits (code, nom, description, categorie, prix_achat, prix_vente, quantite, seuil_alerte, unite, emplacement, fournisseur_id, date_creation, date_modification, statut) 
                        VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'Actif')""", produits)
        
        conn.commit()
    conn.close()

init_db()

# ==================== FONCTIONS UTILITAIRES ====================

def generer_code(prefix, table, champ):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute(f"SELECT MAX(CAST(SUBSTR({champ}, LENGTH(?) + 1) AS INTEGER)) FROM {table} WHERE {champ} LIKE ?", (prefix, prefix + '%'))
    max_id = c.fetchone()[0]
    conn.close()
    next_id = (max_id or 0) + 1
    return f"{prefix}{next_id:04d}"

