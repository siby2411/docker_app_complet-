# ==================== ROUTES ====================

@app.route("/")
def index():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    
    c.execute("SELECT COUNT(*) FROM produits")
    total_produits = c.fetchone()[0]
    
    c.execute("SELECT COUNT(*) FROM produits WHERE quantite <= seuil_alerte")
    alerte_stock = c.fetchone()[0]
    
    c.execute("SELECT COUNT(*) FROM fournisseurs WHERE statut='Actif'")
    total_fournisseurs = c.fetchone()[0]
    
    c.execute("SELECT COUNT(*) FROM clients WHERE statut='Actif'")
    total_clients = c.fetchone()[0]
    
    c.execute("""
        SELECT p.*, f.nom as fournisseur_nom 
        FROM produits p 
        LEFT JOIN fournisseurs f ON p.fournisseur_id = f.id 
        WHERE p.quantite <= p.seuil_alerte 
        ORDER BY p.quantite ASC LIMIT 10
    """)
    alertes = c.fetchall()
    
    c.execute("""
        SELECT p.*, f.nom as fournisseur_nom 
        FROM produits p 
        LEFT JOIN fournisseurs f ON p.fournisseur_id = f.id 
        ORDER BY p.id DESC LIMIT 10
    """)
    produits = c.fetchall()
    conn.close()
    
    content = f"""
    <div class="stats">
        <div class="stat-card"><div class="icon"><i class="fas fa-box"></i></div><div class="num">{total_produits}</div><div class="label">Total Produits</div></div>
        <div class="stat-card" style="border-left-color:#e53e3e;"><div class="icon"><i class="fas fa-exclamation-triangle"></i></div><div class="num">{alerte_stock}</div><div class="label">Alerte Stock</div></div>
        <div class="stat-card" style="border-left-color:#3182ce;"><div class="icon"><i class="fas fa-truck"></i></div><div class="num">{total_fournisseurs}</div><div class="label">Fournisseurs</div></div>
        <div class="stat-card" style="border-left-color:#38a169;"><div class="icon"><i class="fas fa-users"></i></div><div class="num">{total_clients}</div><div class="label">Clients</div></div>
    </div>
    
    <div class="card">
        <div class="card-header">
            <h2><i class="fas fa-exclamation-triangle"></i> Alertes Stock</h2>
            <a href="/stock/produits" class="btn btn-primary"><i class="fas fa-plus"></i> Gérer Produits</a>
        </div>
        <table>
            <thead><tr><th>Code</th><th>Produit</th><th>Quantité</th><th>Seuil</th><th>Statut</th></tr></thead>
            <tbody>
    """
    if alertes:
        for a in alertes:
            content += f"""
            <tr>
                <td><strong>{a[1]}</strong></td>
                <td>{a[2]}</td>
                <td class="alert">{a[7]}</td>
                <td>{a[8]}</td>
                <td><span class="badge badge-danger">URGENT</span></td>
            </tr>
            """
    else:
        content += "<tr><td colspan='5' style='text-align:center;color:#718096;'>✅ Tous les stocks sont bons</td></tr>"
    content += """
            </tbody>
        </table>
    </div>
    
    <div class="card">
        <div class="card-header">
            <h2><i class="fas fa-box"></i> Derniers Produits</h2>
            <a href="/stock/produits/ajouter" class="btn btn-success"><i class="fas fa-plus"></i> Ajouter</a>
        </div>
        <table>
            <thead><tr><th>Code</th><th>Nom</th><th>Catégorie</th><th>Prix Vente</th><th>Quantité</th><th>Actions</th></tr></thead>
            <tbody>
    """
    for p in produits:
        content += f"""
            <tr>
                <td><strong>{p[1]}</strong></td>
                <td>{p[2]}</td>
                <td>{p[4] or '-'}</td>
                <td>{p[6]:,} FCFA</td>
                <td>{p[7]}</td>
                <td>
                    <a href="/stock/produits/{p[0]}" class="btn btn-info btn-sm"><i class="fas fa-eye"></i></a>
                    <a href="/stock/produits/{p[0]}/edit" class="btn btn-primary btn-sm"><i class="fas fa-edit"></i></a>
                </td>
            </tr>
        """
    content += """
            </tbody>
        </table>
    </div>
    """
    
    return render_template_string(HTML_BASE.replace('{% block content %}{% endblock %}', content))

@app.route("/produits")
def produits():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("""
        SELECT p.*, f.nom as fournisseur_nom 
        FROM produits p 
        LEFT JOIN fournisseurs f ON p.fournisseur_id = f.id 
        ORDER BY p.nom
    """)
    produits = c.fetchall()
    conn.close()
    
    rows = "".join(f"""
        <tr>
            <td><strong>{p[1]}</strong></td>
            <td>{p[2]}</td>
            <td>{p[4] or '-'}</td>
            <td>{p[6]:,} FCFA</td>
            <td>{p[7]}</td>
            <td>{p[8]}</td>
            <td><span class="badge {"badge-danger" if p[7] <= p[8] else "badge-success"}">{"CRITIQUE" if p[7] <= p[8] else "OK"}</span></td>
            <td>
                <a href="/stock/produits/{p[0]}" class="btn btn-info btn-sm"><i class="fas fa-eye"></i></a>
                <a href="/stock/produits/{p[0]}/edit" class="btn btn-primary btn-sm"><i class="fas fa-edit"></i></a>
            </td>
        </tr>
    """ for p in produits)
    
    content = f"""
    <div class="card">
        <div class="card-header">
            <h2><i class="fas fa-box"></i> Liste des Produits</h2>
            <a href="/stock/produits/ajouter" class="btn btn-success"><i class="fas fa-plus"></i> Ajouter</a>
        </div>
        <table>
            <thead><tr><th>Code</th><th>Nom</th><th>Catégorie</th><th>Prix Vente</th><th>Quantité</th><th>Seuil</th><th>Statut</th><th>Actions</th></tr></thead>
            <tbody>{rows}</tbody>
        </table>
    </div>
    """
    return render_template_string(HTML_BASE.replace('{% block content %}{% endblock %}', content))

@app.route("/produits/ajouter", methods=["GET", "POST"])
def ajouter_produit():
    if request.method == "POST":
        conn = sqlite3.connect(DB_PATH)
        c = conn.cursor()
        code = generer_code("P", "produits", "code")
        c.execute("""
            INSERT INTO produits (code, nom, description, categorie, prix_achat, prix_vente, quantite, seuil_alerte, unite, emplacement, fournisseur_id, date_creation, date_modification, statut)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, datetime('now'), datetime('now'), 'Actif')
        """, (
            code,
            request.form['nom'],
            request.form.get('description', ''),
            request.form.get('categorie', ''),
            float(request.form.get('prix_achat', 0)),
            float(request.form.get('prix_vente', 0)),
            int(request.form.get('quantite', 0)),
            int(request.form.get('seuil_alerte', 5)),
            request.form.get('unite', 'pièce'),
            request.form.get('emplacement', ''),
            int(request.form['fournisseur_id']) if request.form.get('fournisseur_id') else None
        ))
        conn.commit()
        conn.close()
        return redirect("/stock/produits")
    
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT id, nom FROM fournisseurs WHERE statut='Actif' ORDER BY nom")
    fournisseurs = c.fetchall()
    conn.close()
    
    options = "".join(f'<option value="{f[0]}">{f[1]}</option>' for f in fournisseurs)
    
    content = f"""
    <div class="form-container">
        <h2><i class="fas fa-plus"></i> Ajouter un Produit</h2>
        <form method="POST">
            <div class="form-row">
                <div class="form-group"><label>Nom *</label><input type="text" name="nom" required></div>
                <div class="form-group"><label>Catégorie</label>
                    <select name="categorie">
                        <option value="">Sélectionner</option>
                        <option value="Fourniture">Fourniture</option>
                        <option value="Informatique">Informatique</option>
                        <option value="Électroménager">Électroménager</option>
                        <option value="Alimentaire">Alimentaire</option>
                    </select>
                </div>
            </div>
            <div class="form-group"><label>Description</label><input type="text" name="description"></div>
            <div class="form-row">
                <div class="form-group"><label>Prix Achat (FCFA)</label><input type="number" name="prix_achat" step="0.01" min="0"></div>
                <div class="form-group"><label>Prix Vente (FCFA)</label><input type="number" name="prix_vente" step="0.01" min="0"></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Quantité</label><input type="number" name="quantite" min="0" value="0"></div>
                <div class="form-group"><label>Seuil d'alerte</label><input type="number" name="seuil_alerte" min="0" value="5"></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Unité</label>
                    <select name="unite">
                        <option value="pièce">pièce</option>
                        <option value="ramette">ramette</option>
                        <option value="kg">kg</option>
                        <option value="litre">litre</option>
                    </select>
                </div>
                <div class="form-group"><label>Emplacement</label><input type="text" name="emplacement"></div>
            </div>
            <div class="form-group"><label>Fournisseur</label>
                <select name="fournisseur_id">
                    <option value="">Aucun</option>
                    {options}
                </select>
            </div>
            <button type="submit" class="btn btn-success" style="width:100%;"><i class="fas fa-save"></i> Enregistrer</button>
        </form>
        <br><a href="/stock/produits" class="btn btn-info"><i class="fas fa-arrow-left"></i> Retour</a>
    </div>
    """
    return render_template_string(HTML_BASE.replace('{% block content %}{% endblock %}', content))

@app.route("/produits/<int:id>")
def detail_produit(id):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("""
        SELECT p.*, f.nom as fournisseur_nom 
        FROM produits p 
        LEFT JOIN fournisseurs f ON p.fournisseur_id = f.id 
        WHERE p.id = ?
    """, (id,))
    p = c.fetchone()
    conn.close()
    
    if not p:
        return redirect("/stock/produits")
    
    content = f"""
    <div class="card">
        <h2>{p[2]}</h2>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:15px;background:#f7fafc;padding:15px;border-radius:8px;margin:15px 0;">
            <div><strong>Code:</strong> {p[1]}</div>
            <div><strong>Catégorie:</strong> {p[4] or '-'}</div>
            <div><strong>Description:</strong> {p[3] or '-'}</div>
            <div><strong>Prix Achat:</strong> {p[5]:,} FCFA</div>
            <div><strong>Prix Vente:</strong> {p[6]:,} FCFA</div>
            <div><strong>Quantité:</strong> {p[7]}</div>
            <div><strong>Seuil:</strong> {p[8]}</div>
            <div><strong>Unité:</strong> {p[9]}</div>
            <div><strong>Emplacement:</strong> {p[10] or '-'}</div>
            <div><strong>Fournisseur:</strong> {p[14] or '-'}</div>
            <div><strong>Statut:</strong> <span class="badge {"badge-danger" if p[7] <= p[8] else "badge-success"}">{"CRITIQUE" if p[7] <= p[8] else "OK"}</span></div>
        </div>
        <a href="/stock/produits" class="btn btn-info"><i class="fas fa-arrow-left"></i> Retour</a>
        <a href="/stock/produits/{id}/edit" class="btn btn-primary"><i class="fas fa-edit"></i> Modifier</a>
    </div>
    """
    return render_template_string(HTML_BASE.replace('{% block content %}{% endblock %}', content))

@app.route("/produits/<int:id>/edit", methods=["GET", "POST"])
def edit_produit(id):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    
    if request.method == "POST":
        c.execute("""
            UPDATE produits 
            SET nom=?, description=?, categorie=?, prix_achat=?, prix_vente=?, 
                quantite=?, seuil_alerte=?, unite=?, emplacement=?, fournisseur_id=?, date_modification=datetime('now')
            WHERE id=?
        """, (
            request.form['nom'],
            request.form.get('description', ''),
            request.form.get('categorie', ''),
            float(request.form.get('prix_achat', 0)),
            float(request.form.get('prix_vente', 0)),
            int(request.form.get('quantite', 0)),
            int(request.form.get('seuil_alerte', 5)),
            request.form.get('unite', 'pièce'),
            request.form.get('emplacement', ''),
            int(request.form['fournisseur_id']) if request.form.get('fournisseur_id') else None,
            id
        ))
        conn.commit()
        conn.close()
        return redirect(f"/stock/produits/{id}")
    
    c.execute("SELECT * FROM produits WHERE id = ?", (id,))
    p = c.fetchone()
    c.execute("SELECT id, nom FROM fournisseurs WHERE statut='Actif' ORDER BY nom")
    fournisseurs = c.fetchall()
    conn.close()
    
    if not p:
        return redirect("/stock/produits")
    
    options = "".join(f'<option value="{f[0]}" {"selected" if f[0] == p[11] else ""}>{f[1]}</option>' for f in fournisseurs)
    
    content = f"""
    <div class="form-container">
        <h2><i class="fas fa-edit"></i> Modifier Produit</h2>
        <form method="POST">
            <div class="form-row">
                <div class="form-group"><label>Nom *</label><input type="text" name="nom" value="{p[2]}" required></div>
                <div class="form-group"><label>Catégorie</label>
                    <select name="categorie">
                        <option value="">Sélectionner</option>
                        <option value="Fourniture" {"selected" if p[4]=="Fourniture" else ""}>Fourniture</option>
                        <option value="Informatique" {"selected" if p[4]=="Informatique" else ""}>Informatique</option>
                        <option value="Électroménager" {"selected" if p[4]=="Électroménager" else ""}>Électroménager</option>
                        <option value="Alimentaire" {"selected" if p[4]=="Alimentaire" else ""}>Alimentaire</option>
                    </select>
                </div>
            </div>
            <div class="form-group"><label>Description</label><input type="text" name="description" value="{p[3] or ''}"></div>
            <div class="form-row">
                <div class="form-group"><label>Prix Achat (FCFA)</label><input type="number" name="prix_achat" step="0.01" min="0" value="{p[5]}"></div>
                <div class="form-group"><label>Prix Vente (FCFA)</label><input type="number" name="prix_vente" step="0.01" min="0" value="{p[6]}"></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Quantité</label><input type="number" name="quantite" min="0" value="{p[7]}"></div>
                <div class="form-group"><label>Seuil d'alerte</label><input type="number" name="seuil_alerte" min="0" value="{p[8]}"></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Unité</label>
                    <select name="unite">
                        <option value="pièce" {"selected" if p[9]=="pièce" else ""}>pièce</option>
                        <option value="ramette" {"selected" if p[9]=="ramette" else ""}>ramette</option>
                        <option value="kg" {"selected" if p[9]=="kg" else ""}>kg</option>
                        <option value="litre" {"selected" if p[9]=="litre" else ""}>litre</option>
                    </select>
                </div>
                <div class="form-group"><label>Emplacement</label><input type="text" name="emplacement" value="{p[10] or ''}"></div>
            </div>
            <div class="form-group"><label>Fournisseur</label>
                <select name="fournisseur_id">
                    <option value="">Aucun</option>
                    {options}
                </select>
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%;"><i class="fas fa-save"></i> Mettre à jour</button>
        </form>
        <br><a href="/stock/produits/{id}" class="btn btn-info"><i class="fas fa-arrow-left"></i> Retour</a>
    </div>
    """
    return render_template_string(HTML_BASE.replace('{% block content %}{% endblock %}', content))

