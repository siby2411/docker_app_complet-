@app.route("/factures")
def factures():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("""
        SELECT f.*, c.nom, c.prenom 
        FROM factures f 
        LEFT JOIN clients c ON f.client_id = c.id 
        ORDER BY f.id DESC
    """)
    factures = c.fetchall()
    conn.close()
    
    if not factures:
        rows = "<tr><td colspan='7' style='text-align:center;color:#718096;'>Aucune facture</td></tr>"
    else:
        rows = "".join(f"""
            <tr>
                <td><strong>{f[1]}</strong></td>
                <td>{f[10]} {f[11] or ''}</td>
                <td>{f[3][:10] if f[3] else '-'}</td>
                <td>{f[7]:,} FCFA</td>
                <td>{f[9]:,} FCFA</td>
                <td><span class="badge {"badge-warning" if f[5]=="En attente" else "badge-success" if f[5]=="Payée" else "badge-danger"}">{f[5]}</span></td>
                <td><a href="/stock/factures/{f[0]}" class="btn btn-info btn-sm"><i class="fas fa-eye"></i></a></td>
            </tr>
        """ for f in factures)
    
    content = f"""
    <div class="card">
        <div class="card-header">
            <h2><i class="fas fa-file-invoice"></i> Factures</h2>
            <a href="/stock/factures/ajouter" class="btn btn-success"><i class="fas fa-plus"></i> Nouvelle Facture</a>
        </div>
        <table>
            <thead><tr><th>Numéro</th><th>Client</th><th>Date</th><th>HT</th><th>TTC</th><th>Statut</th><th>Actions</th></tr></thead>
            <tbody>{rows}</tbody>
        </table>
    </div>
    """
    return render_template_string(HTML_BASE.replace('{% block content %}{% endblock %}', content))

@app.route("/factures/ajouter", methods=["GET", "POST"])
def ajouter_facture():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    
    if request.method == "POST":
        numero = generer_code("FAC", "factures", "numero")
        c.execute("""
            INSERT INTO factures (numero, client_id, date_facture, date_echeance, statut, observations, date_creation)
            VALUES (?, ?, datetime('now'), ?, 'En attente', ?, datetime('now'))
        """, (
            numero,
            int(request.form['client_id']),
            request.form.get('date_echeance', ''),
            request.form.get('observations', '')
        ))
        facture_id = c.lastrowid
        
        # Ajouter les détails
        produits = request.form.getlist('produit_id[]')
        quantites = request.form.getlist('quantite[]')
        prix = request.form.getlist('prix_unitaire[]')
        
        for i in range(len(produits)):
            if produits[i] and int(quantites[i]) > 0:
                c.execute("""
                    INSERT INTO facture_details (facture_id, produit_id, quantite, prix_unitaire, total)
                    VALUES (?, ?, ?, ?, ?)
                """, (
                    facture_id,
                    int(produits[i]),
                    int(quantites[i]),
                    float(prix[i] or 0),
                    int(quantites[i]) * float(prix[i] or 0)
                ))
        
        # Mettre à jour les montants
        c.execute("""
            UPDATE factures 
            SET montant_ht = (
                SELECT SUM(quantite * prix_unitaire) 
                FROM facture_details 
                WHERE facture_id = ?
            ),
            montant_ttc = (
                SELECT SUM(quantite * prix_unitaire) * (1 + tva/100)
                FROM facture_details 
                WHERE facture_id = ?
            )
            WHERE id = ?
        """, (facture_id, facture_id, facture_id))
        
        conn.commit()
        conn.close()
        return redirect("/stock/factures")
    
    # GET: Afficher le formulaire
    c.execute("SELECT id, nom, prenom FROM clients WHERE statut='Actif' ORDER BY nom")
    clients = c.fetchall()
    
    c.execute("SELECT id, code, nom, prix_vente FROM produits WHERE statut='Actif' ORDER BY nom")
    produits = c.fetchall()
    conn.close()
    
    client_options = "".join(f'<option value="{c[0]}">{c[1]} {c[2] or ""}</option>' for c in clients)
    produits_options = "".join(f'<option value="{p[0]}" data-prix="{p[3]}">{p[1]} - {p[2]}</option>' for p in produits)
    
    content = f"""
    <div class="form-container" style="max-width:1000px;">
        <h2><i class="fas fa-plus"></i> Nouvelle Facture</h2>
        <form method="POST">
            <div class="form-row">
                <div class="form-group"><label>Client *</label>
                    <select name="client_id" required>
                        <option value="">Sélectionner</option>
                        {client_options}
                    </select>
                </div>
                <div class="form-group"><label>Date Échéance</label>
                    <input type="date" name="date_echeance">
                </div>
            </div>
            <div class="form-group"><label>Observations</label>
                <input type="text" name="observations">
            </div>
            
            <h3 style="margin-top:20px;">Détails de la Facture</h3>
            <div id="produits-container">
                <div class="form-row-3 produit-ligne">
                    <div class="form-group"><label>Produit</label>
                        <select name="produit_id[]" class="produit-select" onchange="updatePrix(this)">
                            <option value="">Sélectionner</option>
                            {produits_options}
                        </select>
                    </div>
                    <div class="form-group"><label>Quantité</label>
                        <input type="number" name="quantite[]" min="1" value="1" class="quantite-input" onchange="calculerTotal(this)">
                    </div>
                    <div class="form-group"><label>Prix Unitaire</label>
                        <input type="number" name="prix_unitaire[]" step="0.01" min="0" value="0" class="prix-input" onchange="calculerTotal(this)">
                    </div>
                </div>
            </div>
            <button type="button" class="btn btn-info" onclick="ajouterLigne()" style="margin:10px 0;">
                <i class="fas fa-plus"></i> Ajouter un produit
            </button>
            
            <button type="submit" class="btn btn-success" style="width:100%;"><i class="fas fa-save"></i> Créer la Facture</button>
        </form>
        <br><a href="/stock/factures" class="btn btn-info"><i class="fas fa-arrow-left"></i> Retour</a>
    </div>
    
    <style>
    .form-row-3 {{ display:grid; grid-template-columns:1fr 1fr 1fr; gap:15px; margin-bottom:10px; }}
    @media (max-width:768px){{ .form-row-3 {{ grid-template-columns:1fr; }} }}
    </style>
    
    <script>
    function updatePrix(select) {{
        var prix = select.options[select.selectedIndex].getAttribute('data-prix');
        var ligne = select.closest('.produit-ligne');
        var prixInput = ligne.querySelector('.prix-input');
        if (prix) {{
            prixInput.value = prix;
            calculerTotal(prixInput);
        }}
    }}
    
    function calculerTotal(element) {{
        var ligne = element.closest('.produit-ligne');
        var quantite = parseFloat(ligne.querySelector('.quantite-input').value) || 0;
        var prix = parseFloat(ligne.querySelector('.prix-input').value) || 0;
        var total = quantite * prix;
        var totalSpan = ligne.querySelector('.total-display');
        if (!totalSpan) {{
            totalSpan = document.createElement('span');
            totalSpan.className = 'total-display';
            totalSpan.style.marginLeft = '10px';
            totalSpan.style.fontWeight = 'bold';
            ligne.appendChild(totalSpan);
        }}
        totalSpan.textContent = 'Total: ' + total.toFixed(0) + ' FCFA';
    }}
    
    function ajouterLigne() {{
        var container = document.getElementById('produits-container');
        var firstLigne = container.querySelector('.produit-ligne');
        var newLigne = firstLigne.cloneNode(true);
        newLigne.querySelector('.produit-select').selectedIndex = 0;
        newLigne.querySelector('.quantite-input').value = 1;
        newLigne.querySelector('.prix-input').value = 0;
        var totalSpan = newLigne.querySelector('.total-display');
        if (totalSpan) totalSpan.remove();
        container.appendChild(newLigne);
    }}
    </script>
    """
    return render_template_string(HTML_BASE.replace('{% block content %}{% endblock %}', content))

@app.route("/factures/<int:id>")
def detail_facture(id):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    
    c.execute("""
        SELECT f.*, c.nom, c.prenom, c.telephone, c.email
        FROM factures f 
        LEFT JOIN clients c ON f.client_id = c.id 
        WHERE f.id = ?
    """, (id,))
    facture = c.fetchone()
    
    if not facture:
        conn.close()
        return redirect("/stock/factures")
    
    c.execute("""
        SELECT fd.*, p.code, p.nom as produit_nom 
        FROM facture_details fd 
        JOIN produits p ON fd.produit_id = p.id 
        WHERE fd.facture_id = ?
    """, (id,))
    details = c.fetchall()
    conn.close()
    
    detail_rows = "".join(f"""
        <tr>
            <td>{d[7]}</td>
            <td>{d[8]}</td>
            <td>{d[3]}</td>
            <td>{d[4]:,} FCFA</td>
            <td><strong>{d[6]:,} FCFA</strong></td>
        </tr>
    """ for d in details)
    
    content = f"""
    <div class="card">
        <h2>Facture #{facture[1]}</h2>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:15px;background:#f7fafc;padding:15px;border-radius:8px;margin:15px 0;">
            <div><strong>Client:</strong> {facture[10]} {facture[11] or ''}</div>
            <div><strong>Téléphone:</strong> {facture[12] or '-'}</div>
            <div><strong>Email:</strong> {facture[13] or '-'}</div>
            <div><strong>Date Facture:</strong> {facture[3][:10] if facture[3] else '-'}</div>
            <div><strong>Date Échéance:</strong> {facture[4] or '-'}</div>
            <div><strong>Statut:</strong> <span class="badge {"badge-warning" if facture[5]=="En attente" else "badge-success"}">{facture[5]}</span></div>
            <div><strong>Montant HT:</strong> {facture[7]:,} FCFA</div>
            <div><strong>TVA:</strong> {facture[8]}%</div>
            <div><strong>Montant TTC:</strong> <span style="font-size:1.2rem;color:#d69e2e;">{facture[9]:,} FCFA</span></div>
        </div>
        
        <h3>Détails</h3>
        <table>
            <thead><tr><th>Code</th><th>Produit</th><th>Quantité</th><th>Prix Unitaire</th><th>Total</th></tr></thead>
            <tbody>{detail_rows}</tbody>
            <tfoot>
                <tr style="background:#f7fafc;font-weight:bold;">
                    <td colspan="4" style="text-align:right;">TOTAL TTC</td>
                    <td>{facture[9]:,} FCFA</td>
                </tr>
            </tfoot>
        </table>
        <br>
        <a href="/stock/factures" class="btn btn-info"><i class="fas fa-arrow-left"></i> Retour</a>
        <a href="#" class="btn btn-primary" onclick="window.print()"><i class="fas fa-print"></i> Imprimer</a>
    </div>
    """
    return render_template_string(HTML_BASE.replace('{% block content %}{% endblock %}', content))

@app.route("/api/produit/<int:id>")
def api_produit(id):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT id, code, nom, prix_vente, quantite FROM produits WHERE id = ?", (id,))
    produit = c.fetchone()
    conn.close()
    
    if produit:
        return jsonify({
            'id': produit[0],
            'code': produit[1],
            'nom': produit[2],
            'prix_vente': produit[3],
            'quantite': produit[4]
        })
    return jsonify({'error': 'Produit non trouvé'}), 404

@app.route("/api/recherche/produits")
def api_recherche_produits():
    q = request.args.get('q', '')
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("""
        SELECT id, code, nom, prix_vente, quantite 
        FROM produits 
        WHERE statut='Actif' AND (code LIKE ? OR nom LIKE ?)
        LIMIT 10
    """, (f'%{q}%', f'%{q}%'))
    produits = c.fetchall()
    conn.close()
    
    return jsonify([{
        'id': p[0],
        'code': p[1],
        'nom': p[2],
        'prix_vente': p[3],
        'quantite': p[4]
    } for p in produits])

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=8000, debug=False)
