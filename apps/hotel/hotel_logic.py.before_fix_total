    @app.route('/rapports')
    @directeur_required
    def rapports():
        conn = get_db()
        c = conn.cursor()

        # KPIs hôteliers
        c.execute("SELECT COUNT(*) FROM chambres WHERE actif=1")
        total_chambres = c.fetchone()[0]

        today = datetime.now().date().isoformat()
        c.execute("""SELECT COUNT(*) FROM sejours WHERE statut='En cours'""")
        chambres_occupees = c.fetchone()[0]

        taux_occupation = (chambres_occupees / total_chambres * 100) if total_chambres else 0

        # ADR (Average Daily Rate) - Tarif moyen
        c.execute("""SELECT COALESCE(AVG(tarif_nuit), 0) FROM reservations
                     WHERE statut IN ('Confirmée', 'En cours', 'Terminée')
                     AND strftime('%Y-%m', date_arrivee) = strftime('%Y-%m', 'now')""")
        adr = c.fetchone()[0]

        # RevPAR (Revenue Per Available Room)
        c.execute("""SELECT COALESCE(SUM(total), 0) FROM paiements
                     WHERE strftime('%Y-%m', date_paiement) = strftime('%Y-%m', 'now')""")
        ca_mois = c.fetchone()[0]
        revpar = ca_mois / (total_chambres * 30) if total_chambres else 0

        # CA par source
        c.execute("""SELECT source, COUNT(*) as nb, COALESCE(SUM(total), 0) as ca
                     FROM reservations WHERE statut IN ('Confirmée', 'En cours', 'Terminée')
                     GROUP BY source ORDER BY ca DESC""")
        par_source = c.fetchall()

        # Top 10 clients
        c.execute("""SELECT nom, prenom, societe, nb_sejours, total_depense, vip
                     FROM clients WHERE nb_sejours > 0
                     ORDER BY total_depense DESC LIMIT 10""")
        top_clients = c.fetchall()

        # Taux par type de chambre
        c.execute("""SELECT tc.nom, COUNT(ch.id) as total,
                     SUM(CASE WHEN ch.statut='Occupée' THEN 1 ELSE 0 END) as occ
                     FROM types_chambres tc
                     LEFT JOIN chambres ch ON ch.type_id = tc.id AND ch.actif=1
                     WHERE tc.actif=1 GROUP BY tc.id ORDER BY tc.ordre""")
        par_type = c.fetchall()

        # CA par mois
        c.execute("""SELECT strftime('%Y-%m', date_paiement) as mois,
                            COUNT(*) as nb,
                            COALESCE(SUM(montant), 0) as ca
                     FROM paiements
                     WHERE date_paiement >= date('now', '-6 months')
                     GROUP BY mois ORDER BY mois DESC""")
        par_mois = c.fetchall()

        conn.close()

