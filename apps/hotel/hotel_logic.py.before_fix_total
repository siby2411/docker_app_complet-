        </div>

        <div class="stats">
          <div class="stat-card">
            <i class="fas fa-plane-arrival stat-icon"></i>
            <div class="stat-value">{arrivees}</div>
            <div class="stat-label">Arrivées du jour</div>
          </div>
          <div class="stat-card blue">
            <i class="fas fa-plane-departure stat-icon"></i>
            <div class="stat-value">{departs}</div>
            <div class="stat-label">Départs du jour</div>
          </div>
          <div class="stat-card green">
            <i class="fas fa-user-check stat-icon"></i>
            <div class="stat-value">{en_cours}</div>
            <div class="stat-label">En cours</div>
          </div>
          <div class="stat-card amber">
