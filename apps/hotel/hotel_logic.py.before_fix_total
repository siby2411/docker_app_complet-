    @app.route('/reservations')
    @reception_required
    def reservations_liste():
        conn = get_db()
        c = conn.cursor()

        statut_filter = request.args.get('statut', '')
        date_debut = request.args.get('debut', '')
        date_fin = request.args.get('fin', '')
        search = request.args.get('q', '').strip()

        query = """SELECT r.*, cl.nom as cl_nom, cl.prenom as cl_prenom, cl.telephone as cl_tel,
                          cl.vip as cl_vip, cl.societe,
                          ch.numero as chambre_numero,
                          tc.nom as type_nom
                   FROM reservations r
                   JOIN clients cl ON r.client_id = cl.id
                   LEFT JOIN chambres ch ON r.chambre_id = ch.id
                   JOIN types_chambres tc ON r.type_chambre_id = tc.id
                   WHERE 1=1"""
        params = []

        if statut_filter:
            query += " AND r.statut = ?"
            params.append(statut_filter)

        if date_debut:
            query += " AND date(r.date_arrivee) >= ?"
            params.append(date_debut)
        if date_fin:
            query += " AND date(r.date_arrivee) <= ?"
            params.append(date_fin)

        if search:
            query += """ AND (r.numero LIKE ? OR cl.nom LIKE ? OR cl.prenom LIKE ?
                        OR cl.telephone LIKE ?)"""
            params.extend([f'%{search}%'] * 4)

        query += " ORDER BY r.date_arrivee DESC LIMIT 200"
        c.execute(query, params)
        rows = c.fetchall()

        # Stats
        today = datetime.now().date().isoformat()
        c.execute("SELECT COUNT(*) FROM reservations WHERE date(date_arrivee) = ?", (today,))
        arrivees = c.fetchone()[0]
        c.execute("SELECT COUNT(*) FROM reservations WHERE date(date_depart) = ?", (today,))
        departs = c.fetchone()[0]
        c.execute("SELECT COUNT(*) FROM reservations WHERE statut='En cours'")
        en_cours = c.fetchone()[0]
        c.execute("SELECT COUNT(*) FROM reservations WHERE statut='En attente'")
        attente = c.fetchone()[0]
        conn.close()

        statuts = ['En attente', 'Confirmée', 'En cours', 'Terminée', 'Annulée', 'No-show']
        statuts_opts = "".join(f'<option value="{s}" {"selected" if statut_filter == s else ""}>{s}</option>' for s in statuts)

        content = f"""
