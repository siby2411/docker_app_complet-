    @app.route('/reservations/nouvelle', methods=['GET', 'POST'])
    @reception_required
    def reservation_nouvelle():
        conn = get_db()
        c = conn.cursor()
        client_id_pre = request.args.get('client_id', '')
        chambre_id_pre = request.args.get('chambre_id', '')

        if request.method == 'POST':
            try:
                numero = gen_numero('RES', 'reservations')
                client_id = int(request.form['client_id'])
                type_chambre_id = int(request.form['type_chambre_id'])
                date_arrivee = request.form['date_arrivee']
                date_depart = request.form['date_depart']

                # Calcul nuits
                try:
                    da = datetime.fromisoformat(date_arrivee)
                    dd = datetime.fromisoformat(date_depart)
                    nb_nuits = (dd - da).days
                except Exception:
                    nb_nuits = 1

                if nb_nuits <= 0:
                    flash("La date de départ doit être après la date d'arrivée", "danger")
                    conn.close()
                    return redirect('/reservations/nouvelle')

                # Tarif
                tarif_nuit = float(request.form.get('tarif_nuit') or 0)
                sous_total = tarif_nuit * nb_nuits
                taxe_sejour = float(request.form.get('taxe_sejour') or 0)
                remise = float(request.form.get('remise') or 0)
                total = sous_total + taxe_sejour - remise
                acompte = float(request.form.get('acompte') or 0)
                solde = total - acompte

                chambre_id = int(request.form['chambre_id']) if request.form.get('chambre_id') else None

                c.execute("""INSERT INTO reservations
                    (numero, client_id, chambre_id, type_chambre_id,
                     date_arrivee, date_depart, nb_nuits, nb_adultes, nb_enfants,
                     statut, source, tarif_nuit, sous_total, taxe_sejour, remise, total,
                     acompte, solde, demandes_speciales, notes_internes, user_id)
                    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)""",
                    (numero, client_id, chambre_id, type_chambre_id,
                     date_arrivee, date_depart, nb_nuits,
                     int(request.form.get('nb_adultes') or 1),
                     int(request.form.get('nb_enfants') or 0),
                     request.form.get('statut', 'Confirmée'),
                     request.form.get('source', 'Direct'),
                     tarif_nuit, sous_total, taxe_sejour, remise, total,
                     acompte, solde,
                     request.form.get('demandes_speciales', ''),
                     request.form.get('notes_internes', ''),
                     current_user.id if current_user else None))
                conn.commit()
                res_id = c.lastrowid
                conn.close()

                if current_user:
                    log_action(current_user.id, 'CREATE_RESERVATION', numero)

                flash(f"✅ Réservation {numero} créée", "success")
                return redirect(f'/reservations/{res_id}')
            except Exception as e:
                conn.close()
                flash(f"❌ Erreur : {e}", "danger")

        # GET
        c.execute("SELECT id, nom, prenom, telephone, vip FROM clients WHERE actif=1 ORDER BY nom")
        clients = c.fetchall()
        c.execute("""SELECT ch.id, ch.numero, tc.nom as type_nom, ch.statut
                     FROM chambres ch
                     JOIN types_chambres tc ON ch.type_id = tc.id
                     WHERE ch.actif=1 AND ch.statut IN ('Disponible', 'Réservée')
