    @app.route('/sejours/checkout/<int:sid>', methods=['GET', 'POST'])
    @reception_required
    def sejour_checkout(sid):
        conn = get_db()
        c = conn.cursor()
        c.execute("""SELECT s.*, r.numero as res_numero, r.tarif_nuit, r.taxe_sejour,
                            cl.nom as cl_nom, cl.prenom as cl_prenom,
                            ch.numero as chambre_numero
                     FROM sejours s
                     JOIN reservations r ON s.reservation_id = r.id
                     JOIN clients cl ON s.client_id = cl.id
                     JOIN chambres ch ON s.chambre_id = ch.id
                     WHERE s.id=?""", (sid,))
        s = c.fetchone()
        if not s or s['statut'] != 'En cours':
            conn.close()
            flash("Séjour introuvable", "danger")
            return redirect('/sejours')

        if request.method == 'POST':
            try:
                # Calcul du séjour réel
                date_checkin = datetime.fromisoformat(s['date_checkin'])
                date_checkout = datetime.now()
                nb_nuits_reelles = max(1, (date_checkout.date() - date_checkin.date()).days)

                # Sous-total hébergement
                sous_total_heb = s['tarif_nuit'] * nb_nuits_reelles

                # Consommations restaurant (room service facturé)
                c.execute("""SELECT COALESCE(SUM(total), 0) FROM commandes_resto
                             WHERE sejour_id = ? AND statut != 'Annulée'""", (sid,))
                sous_total_resto = c.fetchone()[0]

                # Autres services
                c.execute("""SELECT COALESCE(SUM(total), 0) FROM consommation_services
                             WHERE sejour_id = ? AND statut = 'À facturer'""", (sid,))
                sous_total_services = c.fetchone()[0]

                # Totaux
                remise = float(request.form.get('remise') or 0)
                sous_total = sous_total_heb + sous_total_resto + sous_total_services
                tva = (sous_total - remise) * 18 / 118
                taxe_sejour = s['taxe_sejour'] or 0
                total = sous_total - remise + taxe_sejour

                # Créer facture
                numero = gen_numero('FAC', 'factures')
                c.execute("""INSERT INTO factures
                    (numero, sejour_id, client_id, date_facture,
                     sous_total_hebergement, sous_total_resto, sous_total_services,
                     remise, tva, taxe_sejour, total, statut, user_id)
                    VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'Impayé', ?)""",
                    (numero, sid, s['client_id'], datetime.now().isoformat(),
                     sous_total_heb, sous_total_resto, sous_total_services,
                     remise, tva, taxe_sejour, total,
                     current_user.id if current_user else None))
                facture_id = c.lastrowid

                # Ajouter lignes facture
                # Hébergement
                c.execute("""INSERT INTO facture_lignes
                    (facture_id, categorie, designation, quantite, prix_unitaire, total_ligne)
                    VALUES (?, 'Hébergement', ?, ?, ?, ?)""",
                    (facture_id, f"Chambre {s['chambre_numero']} - {nb_nuits_reelles} nuit(s)",
                     nb_nuits_reelles, s['tarif_nuit'], sous_total_heb))

                # Mise à jour séjour
                c.execute("""UPDATE sejours SET
                    date_checkout=?, nb_nuits_reelles=?, statut='Terminé',
                    user_checkout=? WHERE id=?""",
                    (datetime.now().isoformat(), nb_nuits_reelles,
                     current_user.id if current_user else None, sid))

                # Réservation → Terminée
                c.execute("UPDATE reservations SET statut='Terminée' WHERE id=?", (s['reservation_id'],))

                # Chambre → À nettoyer
                c.execute("UPDATE chambres SET statut='Disponible', etat_proprete='À nettoyer' WHERE id=?",
                          (s['chambre_id'],))

                # Créer tâche housekeeping
                num_hk = gen_numero('HK', 'taches_housekeeping')
                c.execute("""INSERT INTO taches_housekeeping
                    (numero, chambre_id, type_tache, priorite, statut, date_creation, signale_par)
                    VALUES (?, ?, 'Nettoyage complet', 'Haute', 'À faire', ?, ?)""",
                    (num_hk, s['chambre_id'], datetime.now().isoformat(),
                     current_user.id if current_user else None))

                conn.commit()
                conn.close()

                if current_user:
                    log_action(current_user.id, 'CHECK_OUT', f'Séjour {sid} → Facture {numero}')

                flash(f"✅ Check-out effectué. Facture {numero} créée", "success")
                return redirect(f'/facturation/{facture_id}')
            except Exception as e:
                conn.close()
                flash(f"❌ Erreur : {e}", "danger")

        # GET
        # Sous-totaux pour affichage
        c.execute("""SELECT COALESCE(SUM(total), 0) FROM commandes_resto
                     WHERE sejour_id = ? AND statut != 'Annulée'""", (sid,))
        sous_total_resto = c.fetchone()[0]
        c.execute("""SELECT COALESCE(SUM(total), 0) FROM consommation_services
                     WHERE sejour_id = ? AND statut = 'À facturer'""", (sid,))
        sous_total_services = c.fetchone()[0]
        conn.close()

        try:
            nb_nuits = max(1, (datetime.now().date() - datetime.fromisoformat(s['date_checkin']).date()).days)
        except Exception:
            nb_nuits = 1

        sous_total_heb = s['tarif_nuit'] * nb_nuits

        content = f"""
        <div class="page-header">
          <h2><i class="fas fa-sign-out-alt"></i> Check-out — {s['cl_nom']} {s['cl_prenom']}</h2>
          <a href="/sejours" class="btn btn-info"><i class="fas fa-arrow-left"></i> Retour</a>
        </div>

        <div class="card">
          <div class="form-grid">
            <div><strong>Client :</strong> {s['cl_nom']} {s['cl_prenom']}</div>
            <div><strong>Chambre :</strong> {s['chambre_numero']}</div>
            <div><strong>Check-in :</strong> {s['date_checkin'][:16]}</div>
            <div><strong>Check-out :</strong> {datetime.now().strftime('%d/%m/%Y %H:%M')}</div>
            <div><strong>Nuits réelles :</strong> {nb_nuits}</div>
            <div><strong>Réservation :</strong> {s['res_numero']}</div>
          </div>
        </div>

        <div class="card">
          <div class="card-header"><h3><i class="fas fa-receipt"></i> Détail de la facture</h3></div>
          <table style="width:100%;border-collapse:collapse">
            <tr style="border-bottom:1px solid #f3f4f6">
              <td style="padding:10px">Hébergement ({nb_nuits} nuit × {s['tarif_nuit']:,.0f})</td>
              <td style="text-align:right;padding:10px"><strong>{sous_total_heb:,.0f} FCFA</strong></td>
            </tr>
            <tr style="border-bottom:1px solid #f3f4f6">
              <td style="padding:10px">Restaurant / Room service</td>
              <td style="text-align:right;padding:10px"><strong>{sous_total_resto:,.0f} FCFA</strong></td>
            </tr>
            <tr style="border-bottom:1px solid #f3f4f6">
              <td style="padding:10px">Autres services</td>
              <td style="text-align:right;padding:10px"><strong>{sous_total_services:,.0f} FCFA</strong></td>
            </tr>
          </table>

          <form method="POST" style="margin-top:20px">
            <div class="form-grid">
              <div class="form-group"><label>Remise (FCFA)</label>
                <input type="number" name="remise" step="100" value="0">
