            VALUES (?,?,?,?,?,?,?,?,?,?,?)""",
            (ref, random.randint(1, 15),
             f"LOT-{now.strftime('%Y%m')}-{random.randint(1, 150):04d}",
             (now - timedelta(days=random.randint(1, 100))).date().isoformat(),
