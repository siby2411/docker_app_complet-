        ('LIG-CAJ-02', 'Ligne cajou salée', 1, 7, 300),
        ('LIG-AUT-01', 'Ligne bissap/bouye', 2, 10, 200),
        ('LIG-LEG-01', 'Ligne légumes déshydratés', 2, 14, 250),
