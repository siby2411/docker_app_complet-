             qte * prix, date_sig.date().isoformat(),
             (date_sig + timedelta(days=random.randint(10, 60))).date().isoformat(),
             random.choice(['Actif', 'Livré', 'Livré'])))

    print(f"[MIGRATE v2] ✅ 40 contrats d'achat créés")

