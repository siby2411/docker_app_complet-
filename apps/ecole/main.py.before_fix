def render_page(content, active='dashboard'):
    """Rendu avec template de base + remplacement du bloc actif"""
    flash_html = """
    {% with messages = get_flashed_messages(with_categories=true) %}
        {% if messages %}
            {% for category, message in messages %}
            <div class="flash flash-{{ category }}">{{ message }}</div>
            {% endfor %}
        {% endif %}
    {% endwith %}
    """
    page = HTML_BASE.replace("{CONTENT}", content).replace("{FLASH_MESSAGES}", flash_html)
    page = page.replace("{{ 'active' if active=='" + active + "' else '' }}", "active")
    return render_template_string(page, active=active)


# ==================== DASHBOARD ====================
@app.route("/")
def index():
    try:
        conn = get_db()
        c = conn.cursor()
        c.execute("SELECT COUNT(*) FROM etudiants")
        total = c.fetchone()[0]
        c.execute("SELECT COUNT(*) FROM etudiants WHERE statut='Actif'")
        actifs = c.fetchone()[0]
        c.execute("SELECT COUNT(*) FROM classes")
        classes_count = c.fetchone()[0]
        c.execute("SELECT COUNT(*) FROM professeurs WHERE statut='Actif'")
        profs = c.fetchone()[0]
        c.execute("SELECT COUNT(*) FROM matieres")
        matieres_count = c.fetchone()[0]
        c.execute("SELECT SUM(montant) FROM scolarite WHERE statut='Payé'")
        scolarite_total = c.fetchone()[0] or 0

        c.execute("""SELECT e.*, c.nom as classe_nom,
            (SELECT AVG(b.note_finale * m.coefficient) / AVG(m.coefficient)
            FROM bulletins b JOIN matieres m ON b.matiere_id = m.id
            WHERE b.etudiant_id = e.id) as moyenne
            FROM etudiants e JOIN classes c ON e.classe_id = c.id
            ORDER BY e.id DESC LIMIT 15""")
        etudiants = c.fetchall()
        conn.close()

        content = f"""
        <div class="stats">
            <div class="stat-card"><div class="icon"><i class="fas fa-users"></i></div><div class="num">{total}</div><div class="label">Etudiants</div></div>
            <div class="stat-card" style="border-left-color:#2ecc71;"><div class="icon"><i class="fas fa-user-check"></i></div><div class="num">{actifs}</div><div class="label">Actifs</div></div>
            <div class="stat-card" style="border-left-color:#3498db;"><div class="icon"><i class="fas fa-chalkboard"></i></div><div class="num">{classes_count}</div><div class="label">Classes</div></div>
            <div class="stat-card" style="border-left-color:#9b59b6;"><div class="icon"><i class="fas fa-chalkboard-teacher"></i></div><div class="num">{profs}</div><div class="label">Professeurs</div></div>
            <div class="stat-card" style="border-left-color:#e67e22;"><div class="icon"><i class="fas fa-book"></i></div><div class="num">{matieres_count}</div><div class="label">Matieres</div></div>
            <div class="stat-card" style="border-left-color:#f39c12;"><div class="icon"><i class="fas fa-money-bill-wave"></i></div><div class="num">{scolarite_total:,.0f}</div><div class="label">Scolarite FCFA</div></div>
        </div>
        <div class="card">
            <div class="card-header">
                <h2><i class="fas fa-users"></i> Derniers Etudiants</h2>
                <a href="/ecole/inscription" class="btn btn-primary"><i class="fas fa-plus"></i> Inscrire</a>
            </div>
            <table>
                <thead><tr><th>Matricule</th><th>Nom & Prenom</th><th>Classe</th><th>Moyenne</th><th>Statut</th><th>Actions</th></tr></thead>
                <tbody>
        """
        for e in etudiants:
            content += f"""
            <tr>
                <td><strong>{e['matricule']}</strong></td>
                <td>{e['nom']} {e['prenom']}</td>
                <td>{e['classe_nom']}</td>
                <td>{round(e['moyenne'], 2) if e['moyenne'] else '-'}</td>
                <td><span class="badge badge-success">{e['statut']}</span></td>
                <td>
                    <a href="/ecole/etudiant/{e['id']}" class="btn btn-info btn-sm"><i class="fas fa-eye"></i></a>
                    <a href="/ecole/bulletin/{e['id']}" class="btn btn-primary btn-sm"><i class="fas fa-file-alt"></i></a>
                    <a href="/ecole/notes/{e['id']}" class="btn btn-success btn-sm"><i class="fas fa-star"></i></a>
                </td>
            </tr>
            """
        content += "</tbody></table></div>"
        return render_page(content, active='dashboard')
    except Exception as e:
        return f"<h1>Erreur</h1><p>{str(e)}</p>"


# ==================== CLASSES ====================
@app.route("/classes")
def classes():
    conn = get_db()
    c = conn.cursor()
    c.execute("""SELECT c.*, f.nom as filiere, n.nom as niveau
        FROM classes c JOIN filieres f ON c.filiere_id = f.id
        JOIN niveaux n ON c.niveau_id = n.id ORDER BY n.ordre, f.nom""")
    rows = c.fetchall()
    conn.close()

    content = """
    <div class="card">
        <div class="card-header">
            <h2><i class="fas fa-chalkboard"></i> Gestion des Classes</h2>
            <a href="/ecole/classes/ajouter" class="btn btn-primary"><i class="fas fa-plus"></i> Ajouter</a>
        </div>
        <table>
            <thead><tr><th>Code</th><th>Nom</th><th>Filiere</th><th>Niveau</th><th>Effectif</th><th>Capacite</th><th>Actions</th></tr></thead>
            <tbody>
    """
    for cl in rows:
        content += f"""
        <tr>
            <td><strong>{cl['code']}</strong></td>
            <td>{cl['nom']}</td>
            <td>{cl['filiere']}</td>
            <td>{cl['niveau']}</td>
            <td>{cl['effectif'] or 0}</td>
            <td>{cl['capacite']}</td>
            <td>
                <a href="/ecole/classes/{cl['id']}/edit" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i></a>
                <a href="/ecole/classes/{cl['id']}/delete" class="btn btn-danger btn-sm" onclick="return confirm('Supprimer ?')"><i class="fas fa-trash"></i></a>
            </td>
        </tr>
        """
    content += "</tbody></table></div>"
    return render_page(content, active='classes')


@app.route("/classes/ajouter", methods=["GET", "POST"])
def ajouter_classe():
    conn = get_db()
    c = conn.cursor()
    if request.method == "POST":
        code = generer_code("CL-", "classes", "code")
        c.execute("""INSERT INTO classes (code, nom, niveau_id, filiere_id, annee_academique, capacite)
            VALUES (?, ?, ?, ?, ?, ?)""",
            (code, request.form['nom'], int(request.form['niveau_id']),
             int(request.form['filiere_id']), request.form['annee_academique'],
             int(request.form['capacite'])))
        conn.commit()
        conn.close()
        flash("Classe ajoutée", "success")
        return redirect("/ecole/classes")

    c.execute("SELECT id, nom FROM niveaux ORDER BY ordre")
    niveaux = c.fetchall()
    c.execute("SELECT id, nom FROM filieres ORDER BY nom")
    filieres = c.fetchall()
    conn.close()

    niveaux_opts = "".join(f'<option value="{n["id"]}">{n["nom"]}</option>' for n in niveaux)
    filieres_opts = "".join(f'<option value="{f["id"]}">{f["nom"]}</option>' for f in filieres)

    content = f"""
    <div class="form-container">
        <h2><i class="fas fa-plus"></i> Ajouter une Classe</h2>
        <form method="POST">
            <div class="form-row">
                <div class="form-group"><label>Nom *</label><input type="text" name="nom" required></div>
                <div class="form-group"><label>Annee academique *</label><input type="text" name="annee_academique" value="2025-2026" required></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Niveau *</label><select name="niveau_id" required>{niveaux_opts}</select></div>
                <div class="form-group"><label>Filiere *</label><select name="filiere_id" required>{filieres_opts}</select></div>
            </div>
            <div class="form-group"><label>Capacite *</label><input type="number" name="capacite" value="30" required></div>
            <button type="submit" class="btn btn-success" style="width:100%;"><i class="fas fa-save"></i> Enregistrer</button>
        </form>
        <br><a href="/ecole/classes" class="btn btn-info"><i class="fas fa-arrow-left"></i> Retour</a>
    </div>
    """
    return render_page(content, active='classes')


@app.route("/classes/<int:id>/edit", methods=["GET", "POST"])
def edit_classe(id):
    conn = get_db()
    c = conn.cursor()
    if request.method == "POST":
        c.execute("""UPDATE classes SET nom=?, niveau_id=?, filiere_id=?, annee_academique=?, capacite=? WHERE id=?""",
            (request.form['nom'], int(request.form['niveau_id']), int(request.form['filiere_id']),
             request.form['annee_academique'], int(request.form['capacite']), id))
        conn.commit()
        conn.close()
        flash("Classe mise à jour", "success")
        return redirect("/ecole/classes")

    c.execute("SELECT * FROM classes WHERE id = ?", (id,))
    cl = c.fetchone()
    c.execute("SELECT id, nom FROM niveaux ORDER BY ordre")
    niveaux = c.fetchall()
    c.execute("SELECT id, nom FROM filieres ORDER BY nom")
    filieres = c.fetchall()
    conn.close()

    niveaux_opts = "".join(f'<option value="{n["id"]}" {"selected" if n["id"]==cl["niveau_id"] else ""}>{n["nom"]}</option>' for n in niveaux)
    filieres_opts = "".join(f'<option value="{f["id"]}" {"selected" if f["id"]==cl["filiere_id"] else ""}>{f["nom"]}</option>' for f in filieres)

    content = f"""
    <div class="form-container">
        <h2><i class="fas fa-edit"></i> Modifier Classe {cl['code']}</h2>
        <form method="POST">
            <div class="form-row">
                <div class="form-group"><label>Nom *</label><input type="text" name="nom" value="{cl['nom']}" required></div>
                <div class="form-group"><label>Annee academique *</label><input type="text" name="annee_academique" value="{cl['annee_academique']}" required></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Niveau *</label><select name="niveau_id" required>{niveaux_opts}</select></div>
                <div class="form-group"><label>Filiere *</label><select name="filiere_id" required>{filieres_opts}</select></div>
            </div>
            <div class="form-group"><label>Capacite *</label><input type="number" name="capacite" value="{cl['capacite']}" required></div>
            <button type="submit" class="btn btn-primary" style="width:100%;"><i class="fas fa-save"></i> Mettre a jour</button>
        </form>
        <br><a href="/ecole/classes" class="btn btn-info"><i class="fas fa-arrow-left"></i> Retour</a>
    </div>
    """
    return render_page(content, active='classes')


@app.route("/classes/<int:id>/delete")
def delete_classe(id):
    conn = get_db()
    c = conn.cursor()
    c.execute("DELETE FROM classes WHERE id = ?", (id,))
    conn.commit()
    conn.close()
    flash("Classe supprimée", "success")
    return redirect("/ecole/classes")


