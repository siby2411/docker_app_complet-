# ==================== PROFESSEURS ====================
@app.route("/professeurs")
def professeurs():
    conn = get_db()
    c = conn.cursor()
    c.execute("""SELECT p.*, (SELECT COUNT(*) FROM affectations WHERE professeur_id = p.id) as nb_matieres
        FROM professeurs p ORDER BY p.nom""")
    rows = c.fetchall()
    conn.close()

    content = """
    <div class="card">
        <div class="card-header">
            <h2><i class="fas fa-chalkboard-teacher"></i> Gestion des Professeurs</h2>
            <a href="/ecole/professeurs/ajouter" class="btn btn-primary"><i class="fas fa-plus"></i> Ajouter</a>
        </div>
        <table>
            <thead><tr><th>Code</th><th>Nom & Prenom</th><th>Specialite</th><th>Telephone</th><th>Email</th><th>Statut</th><th>Actions</th></tr></thead>
            <tbody>
    """
    for p in rows:
        content += f"""
        <tr>
            <td><strong>{p['code']}</strong></td>
            <td>{p['nom']} {p['prenom']}</td>
            <td>{p['specialite'] or '-'}</td>
            <td>{p['telephone']}</td>
            <td>{p['email']}</td>
            <td><span class="badge badge-success">{p['statut']}</span></td>
            <td>
                <a href="/ecole/professeurs/{p['id']}/edit" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i></a>
                <a href="/ecole/professeurs/{p['id']}/delete" class="btn btn-danger btn-sm" onclick="return confirm('Supprimer ?')"><i class="fas fa-trash"></i></a>
            </td>
        </tr>
        """
    content += "</tbody></table></div>"
    return render_page(content, active='professeurs')


