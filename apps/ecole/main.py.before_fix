# ==================== SCOLARITÉ ====================
@app.route("/scolarite")
def scolarite():
    conn = get_db()
    c = conn.cursor()
    c.execute("""SELECT s.*, e.nom, e.prenom, e.matricule FROM scolarite s
        JOIN etudiants e ON s.etudiant_id = e.id ORDER BY s.date_paiement DESC""")
    paiements = c.fetchall()
    c.execute("SELECT SUM(montant) FROM scolarite WHERE statut='Payé'")
    total_paye = c.fetchone()[0] or 0
    c.execute("SELECT SUM(montant) FROM scolarite WHERE statut='En attente'")
    total_attente = c.fetchone()[0] or 0
    conn.close()

    content = f"""
    <div class="stats">
        <div class="stat-card" style="border-left-color:#2ecc71;"><div class="num">{total_paye:,.0f} FCFA</div><div class="label">Total Payé</div></div>
        <div class="stat-card" style="border-left-color:#f39c12;"><div class="num">{total_attente:,.0f} FCFA</div><div class="label">En Attente</div></div>
    </div>
    <div class="card">
        <div class="card-header">
            <h2><i class="fas fa-money-bill-wave"></i> Gestion de la Scolarité</h2>
            <a href="/ecole/scolarite/ajouter" class="btn btn-primary"><i class="fas fa-plus"></i> Nouveau Paiement</a>
        </div>
        <table>
            <thead><tr><th>Etudiant</th><th>Matricule</th><th>Montant</th><th>Mois</th><th>Mode</th><th>Date</th><th>Statut</th><th>Actions</th></tr></thead>
            <tbody>
    """
    for p in paiements:
        badge = "badge-success" if p['statut'] == "Payé" else "badge-warning"
        content += f"""
        <tr>
            <td>{p['nom']} {p['prenom']}</td>
            <td>{p['matricule']}</td>
            <td><strong>{p['montant']:,.0f} FCFA</strong></td>
            <td>{p['mois']}</td>
            <td>{p['mode_paiement'] or '-'}</td>
            <td>{p['date_paiement'][:10] if p['date_paiement'] else '-'}</td>
            <td><span class="badge {badge}">{p['statut']}</span></td>
            <td>
                <a href="/ecole/scolarite/{p['id']}/edit" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i></a>
                <a href="/ecole/scolarite/{p['id']}/delete" class="btn btn-danger btn-sm" onclick="return confirm('Supprimer ?')"><i class="fas fa-trash"></i></a>
            </td>
        </tr>
        """
    content += "</tbody></table></div>"
    return render_page(content, active='scolarite')


@app.route("/scolarite/ajouter", methods=["GET", "POST"])
def ajouter_scolarite():
    conn = get_db()
    c = conn.cursor()
    if request.method == "POST":
        c.execute("""INSERT INTO scolarite (etudiant_id, montant, mois, date_paiement, mode_paiement, reference, statut)
            VALUES (?, ?, ?, ?, ?, ?, ?)""",
            (int(request.form['etudiant_id']), float(request.form['montant']),
             request.form['mois'], datetime.now().isoformat(),
             request.form.get('mode_paiement', 'Espèces'),
             request.form.get('reference', ''), request.form.get('statut', 'En attente')))
        conn.commit()
        conn.close()
        flash("Paiement enregistré", "success")
        return redirect("/ecole/scolarite")

    c.execute("SELECT id, matricule, nom, prenom FROM etudiants ORDER BY nom")
    etudiants = c.fetchall()
    conn.close()
    etudiants_opts = "".join(f'<option value="{e["id"]}">{e["matricule"]} - {e["nom"]} {e["prenom"]}</option>' for e in etudiants)

    content = f"""
    <div class="form-container">
        <h2><i class="fas fa-plus"></i> Nouveau Paiement Scolarité</h2>
        <form method="POST">
            <div class="form-group">
                <label>Etudiant * (Recherche par code)</label>
                <input type="text" id="search_etudiant" placeholder="Tapez le matricule..." onkeyup="filterEtudiants()">
                <select name="etudiant_id" id="etudiant_select" required style="margin-top:5px;">
                    <option value="">-- Sélectionner --</option>
                    {etudiants_opts}
                </select>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Montant (FCFA) *</label><input type="number" name="montant" value="150000" required></div>
                <div class="form-group"><label>Mois *</label>
                    <select name="mois" required>
                        <option>Octobre</option><option>Novembre</option><option>Décembre</option>
                        <option>Janvier</option><option>Février</option><option>Mars</option>
                        <option>Avril</option><option>Mai</option><option>Juin</option>
                    </select>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Mode de paiement</label>
                    <select name="mode_paiement">
                        <option value="Wave">Wave</option>
                        <option value="Orange Money">Orange Money</option>
                        <option value="Espèces">Espèces</option>
                        <option value="Virement">Virement</option>
                    </select>
                </div>
                <div class="form-group"><label>Référence</label><input type="text" name="reference"></div>
            </div>
            <div class="form-group"><label>Statut</label>
                <select name="statut">
                    <option value="En attente">En attente</option>
                    <option value="Payé">Payé</option>
                </select>
            </div>
            <button type="submit" class="btn btn-success" style="width:100%;"><i class="fas fa-save"></i> Enregistrer</button>
        </form>
        <br><a href="/ecole/scolarite" class="btn btn-info"><i class="fas fa-arrow-left"></i> Retour</a>
    </div>
    <script>
        function filterEtudiants() {{
            var input = document.getElementById('search_etudiant');
            var filter = input.value.toUpperCase();
            var select = document.getElementById('etudiant_select');
            var options = select.options;
            for (var i = 0; i < options.length; i++) {{
                var txtValue = options[i].text.toUpperCase();
                if (txtValue.indexOf(filter) > -1) {{
                    options[i].style.display = "";
                }} else {{
                    options[i].style.display = "none";
                }}
            }}
        }}
    </script>
    """
    return render_page(content, active='scolarite')


