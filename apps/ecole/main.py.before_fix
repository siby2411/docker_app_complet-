from flask import Flask, render_template_string, request, redirect, url_for, flash
from werkzeug.middleware.proxy_fix import ProxyFix
import sqlite3
from datetime import datetime
import os

app = Flask(__name__)
app.secret_key = 'omega_ecole_lmd_2026'
app.wsgi_app = ProxyFix(app.wsgi_app, x_for=1, x_proto=1, x_host=1, x_prefix=1)

PREFIX = "/ecole"

@app.context_processor
def utility_processor():
    def url_for_with_prefix(endpoint, **kwargs):
        url = url_for(endpoint, **kwargs)
        if url.startswith('/'):
            return PREFIX + url
        return url
    return dict(url_for=url_for_with_prefix)

DB_PATH = "/app/data/ecole.db"


# ==================== CONNEXION ====================
def get_db():
    """Connexion avec WAL + busy_timeout pour la concurrence"""
    os.makedirs("/app/data", exist_ok=True)
    conn = sqlite3.connect(DB_PATH, timeout=30.0)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA busy_timeout=30000")
    conn.execute("PRAGMA journal_mode=WAL")
    conn.execute("PRAGMA synchronous=NORMAL")
    return conn


# ==================== FONCTIONS UTILITAIRES ====================
def generer_code(prefix, table, champ):
    conn = get_db()
    c = conn.cursor()
    c.execute(f"SELECT COUNT(*) FROM {table}")
    count = c.fetchone()[0] + 1
    conn.close()
    return f"{prefix}{count:04d}"


def calculer_moyenne_etudiant(etudiant_id):
    conn = get_db()
    c = conn.cursor()
    c.execute("""SELECT SUM(b.note_finale * m.coefficient) / SUM(m.coefficient),
            COUNT(*), SUM(CASE WHEN b.note_finale >= 10 THEN 1 ELSE 0 END),
            SUM(CASE WHEN b.note_finale < 10 AND b.note_finale > 0 THEN 1 ELSE 0 END)
        FROM bulletins b JOIN matieres m ON b.matiere_id = m.id
        WHERE b.etudiant_id = ? AND b.statut != 'Non inscrit'""", (etudiant_id,))
    r = c.fetchone()
    conn.close()
    return {'moyenne': round(r[0] or 0, 2), 'nb_matieres': r[1] or 0,
            'validees': r[2] or 0, 'echecs': r[3] or 0}


def get_classement(etudiant_id):
    conn = get_db()
    c = conn.cursor()
    c.execute("""SELECT e.id, (SELECT AVG(b.note_finale * m.coefficient) / AVG(m.coefficient)
            FROM bulletins b JOIN matieres m ON b.matiere_id = m.id
            WHERE b.etudiant_id = e.id AND b.statut != 'Non inscrit')
        FROM etudiants e
        WHERE e.classe_id = (SELECT classe_id FROM etudiants WHERE id = ?)
        ORDER BY 2 DESC""", (etudiant_id,))
    classement = c.fetchall()
    conn.close()
    for i, e in enumerate(classement):
        if e[0] == etudiant_id:
            return i + 1, len(classement)
    return 0, 0


