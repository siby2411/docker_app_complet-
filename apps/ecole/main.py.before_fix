            <button type="submit" class="btn btn-primary" style="width:100%;"><i class="fas fa-save"></i> Mettre a jour</button>
        </form>
        <br><a href="/ecole/scolarite" class="btn btn-info"><i class="fas fa-arrow-left"></i> Retour</a>
