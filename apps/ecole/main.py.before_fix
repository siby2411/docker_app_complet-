@app.route("/matieres")
def matieres():
    conn = get_db()
    c = conn.cursor()
    c.execute("""SELECT m.*, n.nom as niveau_nom FROM matieres m
        JOIN niveaux n ON m.niveau_id = n.id ORDER BY n.ordre, m.nom""")
    rows = c.fetchall()
    conn.close()

    content = """
    <div class="card">
        <div class="card-header">
            <h2><i class="fas fa-book"></i> Gestion des Matieres</h2>
            <a href="/ecole/matieres/ajouter" class="btn btn-primary"><i class="fas fa-plus"></i> Ajouter</a>
        </div>
        <table>
            <thead><tr><th>Code</th><th>Nom</th><th>Niveau</th><th>Coeff</th><th>Credits</th><th>Heures</th><th>Actions</th></tr></thead>
            <tbody>
    """
    for m in rows:
        content += f"""
        <tr>
            <td><strong>{m['code']}</strong></td>
            <td>{m['nom']}</td>
            <td>{m['niveau_nom']}</td>
            <td>{m['coefficient']}</td>
            <td>{m['credit']}</td>
            <td>{m['heures_cours']}h</td>
            <td>
                <a href="/ecole/matieres/{m['id']}/edit" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i></a>
                <a href="/ecole/matieres/{m['id']}/delete" class="btn btn-danger btn-sm" onclick="return confirm('Supprimer ?')"><i class="fas fa-trash"></i></a>
            </td>
        </tr>
        """
    content += "</tbody></table></div>"
    return render_page(content, active='matieres')


@app.route("/matieres/ajouter", methods=["GET", "POST"])
def ajouter_matiere():
    conn = get_db()
    c = conn.cursor()
    if request.method == "POST":
        code = generer_code("MAT-", "matieres", "code")
        c.execute("""INSERT INTO matieres (code, nom, niveau_id, coefficient, credit, heures_cours, heures_td, heures_tp)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)""",
            (code, request.form['nom'], int(request.form['niveau_id']),
             int(request.form['coefficient']), int(request.form['credit']),
             int(request.form.get('heures_cours', 0)), int(request.form.get('heures_td', 0)),
             int(request.form.get('heures_tp', 0))))
        conn.commit()
        conn.close()
        flash("Matière ajoutée", "success")
        return redirect("/ecole/matieres")

    c.execute("SELECT id, nom FROM niveaux ORDER BY ordre")
    niveaux = c.fetchall()
    conn.close()
    niveaux_opts = "".join(f'<option value="{n["id"]}">{n["nom"]}</option>' for n in niveaux)

    content = f"""
    <div class="form-container">
        <h2><i class="fas fa-plus"></i> Ajouter une Matiere</h2>
        <form method="POST">
            <div class="form-row">
                <div class="form-group"><label>Nom *</label><input type="text" name="nom" required></div>
                <div class="form-group"><label>Niveau *</label><select name="niveau_id" required>{niveaux_opts}</select></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Coefficient *</label><input type="number" name="coefficient" value="1" required></div>
                <div class="form-group"><label>Credits *</label><input type="number" name="credit" value="3" required></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Heures Cours</label><input type="number" name="heures_cours" value="0"></div>
                <div class="form-group"><label>Heures TD</label><input type="number" name="heures_td" value="0"></div>
            </div>
            <div class="form-group"><label>Heures TP</label><input type="number" name="heures_tp" value="0"></div>
            <button type="submit" class="btn btn-success" style="width:100%;"><i class="fas fa-save"></i> Enregistrer</button>
        </form>
        <br><a href="/ecole/matieres" class="btn btn-info"><i class="fas fa-arrow-left"></i> Retour</a>
    </div>
    """
    return render_page(content, active='matieres')


@app.route("/matieres/<int:id>/edit", methods=["GET", "POST"])
def edit_matiere(id):
    conn = get_db()
    c = conn.cursor()
    if request.method == "POST":
        c.execute("""UPDATE matieres SET nom=?, niveau_id=?, coefficient=?, credit=?, heures_cours=?, heures_td=?, heures_tp=? WHERE id=?""",
            (request.form['nom'], int(request.form['niveau_id']), int(request.form['coefficient']),
             int(request.form['credit']), int(request.form.get('heures_cours', 0)),
             int(request.form.get('heures_td', 0)), int(request.form.get('heures_tp', 0)), id))
        conn.commit()
        conn.close()
        flash("Matière mise à jour", "success")
        return redirect("/ecole/matieres")

    c.execute("SELECT * FROM matieres WHERE id = ?", (id,))
    m = c.fetchone()
    c.execute("SELECT id, nom FROM niveaux ORDER BY ordre")
    niveaux = c.fetchall()
    conn.close()
    niveaux_opts = "".join(f'<option value="{n["id"]}" {"selected" if n["id"]==m["niveau_id"] else ""}>{n["nom"]}</option>' for n in niveaux)

    content = f"""
    <div class="form-container">
        <h2><i class="fas fa-edit"></i> Modifier Matiere {m['code']}</h2>
        <form method="POST">
            <div class="form-row">
                <div class="form-group"><label>Nom *</label><input type="text" name="nom" value="{m['nom']}" required></div>
                <div class="form-group"><label>Niveau *</label><select name="niveau_id" required>{niveaux_opts}</select></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Coefficient *</label><input type="number" name="coefficient" value="{m['coefficient']}" required></div>
                <div class="form-group"><label>Credits *</label><input type="number" name="credit" value="{m['credit']}" required></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Heures Cours</label><input type="number" name="heures_cours" value="{m['heures_cours']}"></div>
                <div class="form-group"><label>Heures TD</label><input type="number" name="heures_td" value="{m['heures_td']}"></div>
            </div>
            <div class="form-group"><label>Heures TP</label><input type="number" name="heures_tp" value="{m['heures_tp']}"></div>
            <button type="submit" class="btn btn-primary" style="width:100%;"><i class="fas fa-save"></i> Mettre a jour</button>
        </form>
        <br><a href="/ecole/matieres" class="btn btn-info"><i class="fas fa-arrow-left"></i> Retour</a>
    </div>
    """
    return render_page(content, active='matieres')


