# ==================== ÉTUDIANTS ====================
@app.route("/etudiants")
def liste_etudiants():
    conn = get_db()
    c = conn.cursor()
    c.execute("""SELECT e.*, c.nom as classe_nom,
        (SELECT AVG(b.note_finale * m.coefficient) / AVG(m.coefficient)
        FROM bulletins b JOIN matieres m ON b.matiere_id = m.id
        WHERE b.etudiant_id = e.id) as moyenne
        FROM etudiants e JOIN classes c ON e.classe_id = c.id ORDER BY e.nom""")
    etudiants = c.fetchall()
    conn.close()

    content = """
    <div class="card">
        <div class="card-header">
            <h2><i class="fas fa-users"></i> Liste des Étudiants</h2>
            <a href="/ecole/inscription" class="btn btn-primary"><i class="fas fa-plus"></i> Inscrire</a>
        </div>
        <table>
            <thead><tr><th>Matricule</th><th>Nom</th><th>Classe</th><th>Telephone</th><th>Moyenne</th><th>Statut</th><th>Actions</th></tr></thead>
            <tbody>
    """
    for e in etudiants:
        content += f"""
        <tr>
            <td><strong>{e['matricule']}</strong></td>
            <td>{e['nom']} {e['prenom']}</td>
            <td>{e['classe_nom']}</td>
            <td>{e['telephone']}</td>
            <td>{round(e['moyenne'], 2) if e['moyenne'] else '-'}</td>
            <td><span class="badge badge-success">{e['statut']}</span></td>
            <td>
                <a href="/ecole/etudiant/{e['id']}" class="btn btn-info btn-sm"><i class="fas fa-eye"></i></a>
                <a href="/ecole/etudiant/{e['id']}/edit" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i></a>
                <a href="/ecole/etudiant/{e['id']}/delete" class="btn btn-danger btn-sm" onclick="return confirm('Supprimer ?')"><i class="fas fa-trash"></i></a>
            </td>
        </tr>
        """
    content += "</tbody></table></div>"
    return render_page(content, active='etudiants')


@app.route("/inscription", methods=["GET", "POST"])
def inscription():
    conn = get_db()
    c = conn.cursor()
    if request.method == "POST":
        matricule = generer_code("E", "etudiants", "matricule")
        c.execute("""INSERT INTO etudiants (matricule, nom, prenom, date_naissance, lieu_naissance,
            sexe, telephone, email, adresse, classe_id, date_inscription, statut)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 'Actif')""",
            (matricule, request.form['nom'], request.form['prenom'], request.form['date_naissance'],
             request.form.get('lieu_naissance', ''), request.form['sexe'], request.form['telephone'],
             request.form['email'], request.form.get('adresse', ''),
             int(request.form['classe_id']), datetime.now().isoformat()))
        etudiant_id = c.lastrowid

        c.execute("""INSERT INTO bulletins (etudiant_id, matiere_id, note_cc, note_tp, note_examen, note_finale, moyenne, statut)
            SELECT ?, m.id, 0, 0, 0, 0, 0, 'En cours' FROM matieres m
            JOIN classes c ON c.niveau_id = m.niveau_id WHERE c.id = ?""",
            (etudiant_id, int(request.form['classe_id'])))

        conn.commit()
        conn.close()
        flash(f"Étudiant inscrit avec succès : {matricule}", "success")
        return redirect("/ecole/etudiants")

    c.execute("""SELECT c.id, c.code, c.nom, n.nom as niveau, f.nom as filiere
        FROM classes c JOIN niveaux n ON c.niveau_id = n.id
        JOIN filieres f ON c.filiere_id = f.id ORDER BY n.ordre""")
    classes_rows = c.fetchall()
    conn.close()
    classes_opts = "".join(
        f'<option value="{cl["id"]}">{cl["code"]} - {cl["niveau"]} / {cl["filiere"]}</option>'
        for cl in classes_rows)

    content = f"""
    <div class="form-container">
        <h2><i class="fas fa-user-plus"></i> Inscription d'un Nouvel Étudiant</h2>
        <form method="POST">
            <div class="form-row">
                <div class="form-group"><label>Nom *</label><input type="text" name="nom" required></div>
                <div class="form-group"><label>Prenom *</label><input type="text" name="prenom" required></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Date de naissance *</label><input type="date" name="date_naissance" required></div>
                <div class="form-group"><label>Lieu de naissance</label><input type="text" name="lieu_naissance"></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Sexe *</label>
                    <select name="sexe" required>
                        <option value="M">Masculin</option>
                        <option value="F">Féminin</option>
                    </select>
                </div>
                <div class="form-group"><label>Telephone *</label><input type="text" name="telephone" required></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Email *</label><input type="email" name="email" required></div>
                <div class="form-group"><label>Adresse</label><input type="text" name="adresse"></div>
            </div>
            <div class="form-group"><label>Classe *</label>
                <select name="classe_id" required>
                    <option value="">-- Sélectionner une classe --</option>
                    {classes_opts}
                </select>
            </div>
            <button type="submit" class="btn btn-success" style="width:100%;"><i class="fas fa-save"></i> Inscrire</button>
        </form>
        <br><a href="/ecole/etudiants" class="btn btn-info"><i class="fas fa-arrow-left"></i> Retour</a>
    </div>
    """
    return render_page(content, active='inscription')


@app.route("/etudiant/<int:id>")
def detail_etudiant(id):
    conn = get_db()
    c = conn.cursor()
    c.execute("""SELECT e.*, c.nom as classe_nom, n.nom as niveau_nom, f.nom as filiere_nom
        FROM etudiants e JOIN classes c ON e.classe_id = c.id
        JOIN niveaux n ON c.niveau_id = n.id
        JOIN filieres f ON c.filiere_id = f.id WHERE e.id = ?""", (id,))
    e = c.fetchone()
    if not e:
        conn.close()
        return redirect("/ecole/etudiants")

    c.execute("""SELECT b.*, m.nom as matiere_nom, m.coefficient, m.credit
        FROM bulletins b JOIN matieres m ON b.matiere_id = m.id
        WHERE b.etudiant_id = ? ORDER BY m.nom""", (id,))
    notes = c.fetchall()
    conn.close()

    stats = calculer_moyenne_etudiant(id)
    rang, total = get_classement(id)

    content = f"""
    <div class="card">
        <div class="card-header">
            <h2><i class="fas fa-user"></i> {e['nom']} {e['prenom']} ({e['matricule']})</h2>
            <a href="/ecole/bulletin/{id}" class="btn btn-primary"><i class="fas fa-file-alt"></i> Bulletin</a>
        </div>
        <div class="stats">
            <div class="stat-card"><div class="num">{e['classe_nom']}</div><div class="label">Classe</div></div>
            <div class="stat-card" style="border-left-color:#3498db;"><div class="num">{e['niveau_nom']}</div><div class="label">Niveau</div></div>
            <div class="stat-card" style="border-left-color:#9b59b6;"><div class="num">{stats['moyenne']}</div><div class="label">Moyenne</div></div>
            <div class="stat-card" style="border-left-color:#2ecc71;"><div class="num">{rang}/{total}</div><div class="label">Rang</div></div>
        </div>
        <table>
            <thead><tr><th>Matiere</th><th>Coeff</th><th>CC</th><th>TP</th><th>Examen</th><th>Note finale</th><th>Statut</th></tr></thead>
            <tbody>
    """
    for n in notes:
        badge = "badge-success" if n['note_finale'] >= 10 else "badge-warning"
        content += f"""
        <tr>
            <td>{n['matiere_nom']}</td>
            <td>{n['coefficient']}</td>
            <td>{n['note_cc']}</td>
            <td>{n['note_tp']}</td>
            <td>{n['note_examen']}</td>
            <td><strong>{n['note_finale']}</strong></td>
            <td><span class="badge {badge}">{n['statut']}</span></td>
        </tr>
        """
    content += "</tbody></table></div>"
    return render_page(content, active='etudiants')


@app.route("/etudiant/<int:id>/edit", methods=["GET", "POST"])
def edit_etudiant(id):
    conn = get_db()
    c = conn.cursor()
    if request.method == "POST":
        c.execute("""UPDATE etudiants SET nom=?, prenom=?, date_naissance=?, lieu_naissance=?,
            sexe=?, telephone=?, email=?, adresse=?, classe_id=?, statut=? WHERE id=?""",
            (request.form['nom'], request.form['prenom'], request.form['date_naissance'],
             request.form.get('lieu_naissance', ''), request.form['sexe'], request.form['telephone'],
             request.form['email'], request.form.get('adresse', ''),
             int(request.form['classe_id']), request.form['statut'], id))
        conn.commit()
        conn.close()
        flash("Étudiant mis à jour", "success")
        return redirect(f"/ecole/etudiant/{id}")

    c.execute("SELECT * FROM etudiants WHERE id = ?", (id,))
    e = c.fetchone()
    c.execute("SELECT id, code, nom FROM classes ORDER BY nom")
    classes_rows = c.fetchall()
    conn.close()
    classes_opts = "".join(
        f'<option value="{cl["id"]}" {"selected" if cl["id"]==e["classe_id"] else ""}>{cl["code"]} - {cl["nom"]}</option>'
        for cl in classes_rows)

    content = f"""
    <div class="form-container">
        <h2><i class="fas fa-edit"></i> Modifier Étudiant {e['matricule']}</h2>
        <form method="POST">
            <div class="form-row">
                <div class="form-group"><label>Nom *</label><input type="text" name="nom" value="{e['nom']}" required></div>
                <div class="form-group"><label>Prenom *</label><input type="text" name="prenom" value="{e['prenom']}" required></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Date de naissance *</label><input type="date" name="date_naissance" value="{e['date_naissance']}" required></div>
                <div class="form-group"><label>Lieu de naissance</label><input type="text" name="lieu_naissance" value="{e['lieu_naissance'] or ''}"></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Sexe *</label>
                    <select name="sexe" required>
                        <option value="M" {"selected" if e['sexe']=="M" else ""}>Masculin</option>
                        <option value="F" {"selected" if e['sexe']=="F" else ""}>Féminin</option>
                    </select>
                </div>
                <div class="form-group"><label>Telephone *</label><input type="text" name="telephone" value="{e['telephone']}" required></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Email *</label><input type="email" name="email" value="{e['email']}" required></div>
                <div class="form-group"><label>Adresse</label><input type="text" name="adresse" value="{e['adresse'] or ''}"></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Classe *</label><select name="classe_id" required>{classes_opts}</select></div>
                <div class="form-group"><label>Statut *</label>
                    <select name="statut" required>
                        <option value="Actif" {"selected" if e['statut']=="Actif" else ""}>Actif</option>
                        <option value="Inactif" {"selected" if e['statut']=="Inactif" else ""}>Inactif</option>
                        <option value="Diplômé" {"selected" if e['statut']=="Diplômé" else ""}>Diplômé</option>
                    </select>
                </div>
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%;"><i class="fas fa-save"></i> Mettre a jour</button>
        </form>
        <br><a href="/ecole/etudiants" class="btn btn-info"><i class="fas fa-arrow-left"></i> Retour</a>
    </div>
    """
    return render_page(content, active='etudiants')


@app.route("/etudiant/<int:id>/delete")
def delete_etudiant(id):
    conn = get_db()
    c = conn.cursor()
    c.execute("DELETE FROM bulletins WHERE etudiant_id = ?", (id,))
    c.execute("DELETE FROM scolarite WHERE etudiant_id = ?", (id,))
    c.execute("DELETE FROM etudiants WHERE id = ?", (id,))
    conn.commit()
    conn.close()
    flash("Étudiant supprimé", "success")
    return redirect("/ecole/etudiants")


# ==================== NOTES ====================
@app.route("/notes/<int:etudiant_id>", methods=["GET", "POST"])
def notes(etudiant_id):
    conn = get_db()
    c = conn.cursor()
    if request.method == "POST":
        for key, val in request.form.items():
            if key.startswith("note_cc_"):
                bulletin_id = int(key.replace("note_cc_", ""))
                cc = float(val or 0)
                tp = float(request.form.get(f"note_tp_{bulletin_id}", 0) or 0)
                ex = float(request.form.get(f"note_examen_{bulletin_id}", 0) or 0)
                finale = round(cc * 0.3 + tp * 0.2 + ex * 0.5, 2)
                statut = "Validé" if finale >= 10 else "En cours"
                c.execute("""UPDATE bulletins SET note_cc=?, note_tp=?, note_examen=?,
                    note_finale=?, moyenne=?, statut=? WHERE id=?""",
                    (cc, tp, ex, finale, finale, statut, bulletin_id))
        conn.commit()
        conn.close()
        flash("Notes enregistrées", "success")
        return redirect(f"/ecole/notes/{etudiant_id}")

    c.execute("SELECT nom, prenom, matricule FROM etudiants WHERE id = ?", (etudiant_id,))
    e = c.fetchone()
    c.execute("""SELECT b.*, m.nom as matiere_nom, m.coefficient FROM bulletins b
        JOIN matieres m ON b.matiere_id = m.id WHERE b.etudiant_id = ? ORDER BY m.nom""",
        (etudiant_id,))
    bulletins_rows = c.fetchall()
    conn.close()

    content = f"""
    <div class="card">
        <div class="card-header">
            <h2><i class="fas fa-star"></i> Saisie des Notes - {e['nom']} {e['prenom']} ({e['matricule']})</h2>
        </div>
        <p style="color:#718096; margin-bottom:15px; font-size:0.85rem;">
            Formule : <strong>30% CC + 20% TP + 50% Examen</strong>
        </p>
        <form method="POST">
        <table>
            <thead><tr><th>Matiere</th><th>Coeff</th><th>Note CC (/20)</th><th>Note TP (/20)</th><th>Note Examen (/20)</th></tr></thead>
            <tbody>
    """
    for b in bulletins_rows:
        content += f"""
        <tr>
            <td><strong>{b['matiere_nom']}</strong></td>
            <td>{b['coefficient']}</td>
            <td><input type="number" step="0.25" min="0" max="20" name="note_cc_{b['id']}" value="{b['note_cc']}" style="width:80px; padding:5px;"></td>
            <td><input type="number" step="0.25" min="0" max="20" name="note_tp_{b['id']}" value="{b['note_tp']}" style="width:80px; padding:5px;"></td>
            <td><input type="number" step="0.25" min="0" max="20" name="note_examen_{b['id']}" value="{b['note_examen']}" style="width:80px; padding:5px;"></td>
        </tr>
        """
    content += f"""
            </tbody>
        </table>
        <br>
        <button type="submit" class="btn btn-success"><i class="fas fa-save"></i> Enregistrer les notes</button>
        <a href="/ecole/etudiants" class="btn btn-info"><i class="fas fa-arrow-left"></i> Retour</a>
        </form>
    </div>
    """
    return render_page(content, active='etudiants')


# ==================== BULLETIN ====================
@app.route("/bulletin/<int:etudiant_id>")
def bulletin(etudiant_id):
    conn = get_db()
    c = conn.cursor()
    c.execute("""SELECT e.*, c.nom as classe_nom, n.nom as niveau_nom, f.nom as filiere_nom
        FROM etudiants e JOIN classes c ON e.classe_id = c.id
        JOIN niveaux n ON c.niveau_id = n.id
        JOIN filieres f ON c.filiere_id = f.id WHERE e.id = ?""", (etudiant_id,))
    e = c.fetchone()
    if not e:
        conn.close()
        return redirect("/ecole/etudiants")

    c.execute("""SELECT b.*, m.nom as matiere_nom, m.coefficient, m.credit
        FROM bulletins b JOIN matieres m ON b.matiere_id = m.id
        WHERE b.etudiant_id = ? ORDER BY m.nom""", (etudiant_id,))
    notes = c.fetchall()
    conn.close()

    stats = calculer_moyenne_etudiant(etudiant_id)
    rang, total = get_classement(etudiant_id)

    mention = "Passable"
    if stats['moyenne'] >= 16: mention = "Très Bien"
    elif stats['moyenne'] >= 14: mention = "Bien"
    elif stats['moyenne'] >= 12: mention = "Assez Bien"
    elif stats['moyenne'] < 10: mention = "Insuffisant"

    content = f"""
    <div class="card">
        <div style="text-align:center; margin-bottom:20px; padding-bottom:15px; border-bottom:3px solid #e94560;">
            <h1 style="color:#1a1a2e;">🎓 OMEGA CONSULTING</h1>
            <h2 style="color:#e94560;">BULLETIN DE NOTES - SYSTEME LMD</h2>
            <p>Année académique 2025-2026</p>
        </div>
        <div class="stats">
            <div class="stat-card"><div class="num">{e['matricule']}</div><div class="label">Matricule</div></div>
            <div class="stat-card" style="border-left-color:#3498db;"><div class="num">{e['classe_nom']}</div><div class="label">Classe</div></div>
            <div class="stat-card" style="border-left-color:#9b59b6;"><div class="num">{stats['moyenne']}/20</div><div class="label">Moyenne</div></div>
            <div class="stat-card" style="border-left-color:#2ecc71;"><div class="num">{rang}/{total}</div><div class="label">Rang</div></div>
            <div class="stat-card" style="border-left-color:#e67e22;"><div class="num">{mention}</div><div class="label">Mention</div></div>
        </div>
        <p><strong>Étudiant :</strong> {e['nom']} {e['prenom']} | <strong>Né(e) le :</strong> {e['date_naissance']} à {e['lieu_naissance'] or '-'}</p>
        <p><strong>Filière :</strong> {e['filiere_nom']} | <strong>Niveau :</strong> {e['niveau_nom']}</p>
        <table>
            <thead><tr><th>Matiere</th><th>Coeff</th><th>Credits</th><th>CC</th><th>TP</th><th>Examen</th><th>Moyenne</th><th>Statut</th></tr></thead>
            <tbody>
    """
    total_points = 0
    total_coefs = 0
    for n in notes:
        badge = "badge-success" if n['note_finale'] >= 10 else "badge-danger"
        content += f"""
        <tr>
            <td>{n['matiere_nom']}</td>
            <td>{n['coefficient']}</td>
            <td>{n['credit']}</td>
            <td>{n['note_cc']}</td>
            <td>{n['note_tp']}</td>
            <td>{n['note_examen']}</td>
            <td><strong>{n['note_finale']}/20</strong></td>
            <td><span class="badge {badge}">{n['statut']}</span></td>
        </tr>
        """
        total_points += n['note_finale'] * n['coefficient']
        total_coefs += n['coefficient']

    moyenne_generale = round(total_points / total_coefs, 2) if total_coefs else 0

    content += f"""
            </tbody>
            <tfoot>
                <tr style="background:#f7fafc;">
                    <td colspan="6"><strong>MOYENNE GENERALE</strong></td>
                    <td><strong>{moyenne_generale}/20</strong></td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
        <div style="display:flex; justify-content:space-between; margin-top:30px;">
            <div class="stat-card" style="border-left-color:#2ecc71; flex:1;">
                <div class="num">{stats['validees']}</div><div class="label">Matières validées</div>
            </div>
            <div class="stat-card" style="border-left-color:#e74c3c; flex:1; margin-left:10px;">
                <div class="num">{stats['echecs']}</div><div class="label">Matières échouées</div>
            </div>
        </div>
        <div style="margin-top:30px; text-align:center; padding-top:20px; border-top:2px dashed #cbd5e0;">
            <button onclick="window.print()" class="btn btn-primary"><i class="fas fa-print"></i> Imprimer</button>
            <a href="/ecole/etudiants" class="btn btn-info"><i class="fas fa-arrow-left"></i> Retour</a>
        </div>
    </div>
    """
    return render_page(content, active='etudiants')


@app.route("/bulletins")
def bulletins_list():
    conn = get_db()
    c = conn.cursor()
    c.execute("""SELECT e.id, e.matricule, e.nom, e.prenom, c.nom as classe_nom,
        (SELECT AVG(b.note_finale * m.coefficient) / AVG(m.coefficient)
        FROM bulletins b JOIN matieres m ON b.matiere_id = m.id
        WHERE b.etudiant_id = e.id) as moyenne
        FROM etudiants e JOIN classes c ON e.classe_id = c.id ORDER BY e.nom""")
    etudiants = c.fetchall()
    conn.close()

    content = """
    <div class="card">
        <div class="card-header"><h2><i class="fas fa-file-alt"></i> Bulletins de Notes</h2></div>
        <table>
            <thead><tr><th>Matricule</th><th>Nom</th><th>Classe</th><th>Moyenne</th><th>Action</th></tr></thead>
            <tbody>
    """
    for e in etudiants:
        badge = "badge-success" if (e['moyenne'] or 0) >= 10 else "badge-danger"
        content += f"""
        <tr>
            <td><strong>{e['matricule']}</strong></td>
            <td>{e['nom']} {e['prenom']}</td>
            <td>{e['classe_nom']}</td>
            <td><span class="badge {badge}">{round(e['moyenne'], 2) if e['moyenne'] else '-'}</span></td>
            <td><a href="/ecole/bulletin/{e['id']}" class="btn btn-primary btn-sm"><i class="fas fa-eye"></i> Voir</a></td>
        </tr>
        """
    content += "</tbody></table></div>"
    return render_page(content, active='bulletins')


# ==================== HEALTHCHECK ====================
@app.route("/health")
def health():
    try:
        conn = get_db()
        conn.execute("SELECT 1")
        conn.close()
        return {"status": "ok", "db": "connected"}, 200
    except Exception as ex:
        return {"status": "error", "message": str(ex)}, 500


