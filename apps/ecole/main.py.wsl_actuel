@app.route("/")
@login_required
def index():
    conn = get_db()
    c = conn.cursor()
    total = c.execute("SELECT COUNT(*) FROM etudiants").fetchone()[0]
    actifs = c.execute("SELECT COUNT(*) FROM etudiants WHERE statut='Actif'").fetchone()[0]
    classes_count = c.execute("SELECT COUNT(*) FROM classes").fetchone()[0]
    profs = c.execute("SELECT COUNT(*) FROM professeurs WHERE statut='Actif'").fetchone()[0]
    matieres_count = c.execute("SELECT COUNT(*) FROM matieres").fetchone()[0]
    scolarite_total = c.execute("SELECT SUM(montant) FROM scolarite WHERE statut='Payé'").fetchone()[0] or 0

    c.execute("""SELECT e.*, c.nom as classe_nom,
        (SELECT AVG(b.note_finale * m.coefficient) / AVG(m.coefficient)
        FROM bulletins b JOIN matieres m ON b.matiere_id = m.id
        WHERE b.etudiant_id = e.id) as moyenne
        FROM etudiants e JOIN classes c ON e.classe_id = c.id
        ORDER BY e.id DESC LIMIT 15""")
    etudiants = c.fetchall()
    conn.close()

    content = f"""
    <div class="stats">
        <div class="stat-card"><div class="icon"><i class="fas fa-users"></i></div><div class="num">{total}</div><div class="label">Étudiants</div></div>
        <div class="stat-card" style="border-left-color:#2ecc71;"><div class="icon"><i class="fas fa-user-check"></i></div><div class="num">{actifs}</div><div class="label">Actifs</div></div>
        <div class="stat-card" style="border-left-color:#3498db;"><div class="icon"><i class="fas fa-chalkboard"></i></div><div class="num">{classes_count}</div><div class="label">Classes</div></div>
        <div class="stat-card" style="border-left-color:#9b59b6;"><div class="icon"><i class="fas fa-chalkboard-teacher"></i></div><div class="num">{profs}</div><div class="label">Professeurs</div></div>
        <div class="stat-card" style="border-left-color:#e67e22;"><div class="icon"><i class="fas fa-book"></i></div><div class="num">{matieres_count}</div><div class="label">Matières</div></div>
        <div class="stat-card" style="border-left-color:#f39c12;"><div class="icon"><i class="fas fa-money-bill-wave"></i></div><div class="num">{scolarite_total:,.0f}</div><div class="label">Scolarité FCFA</div></div>
    </div>
    <div class="card">
        <div class="card-header">
            <h2><i class="fas fa-users"></i> Derniers Étudiants</h2>
            <a href="/inscription" class="btn btn-primary"><i class="fas fa-plus"></i> Inscrire</a>
        </div>
        <table>
            <thead><tr><th>Matricule</th><th>Nom & Prénom</th><th>Classe</th><th>Moyenne</th><th>Statut</th><th>Actions</th></tr></thead>
            <tbody>
    """
    for e in etudiants:
        content += f"""<tr>
            <td><strong>{e['matricule']}</strong></td>
            <td>{e['nom']} {e['prenom']}</td>
            <td>{e['classe_nom']}</td>
            <td>{round(e['moyenne'], 2) if e['moyenne'] else '-'}</td>
            <td><span class="badge badge-success">{e['statut']}</span></td>
            <td>
                <a href="/etudiant/{e['id']}" class="btn btn-info btn-sm"><i class="fas fa-eye"></i></a>
                <a href="/bulletin/{e['id']}" class="btn btn-primary btn-sm"><i class="fas fa-file-alt"></i></a>
                <a href="/notes/saisie?etudiant_id={e['id']}" class="btn btn-success btn-sm"><i class="fas fa-star"></i></a>
            </td>
        </tr>"""
    content += "</tbody></table></div>"
    return render_page(content, active='dashboard')


# ==================== CLASSES ====================
@app.route("/classes")
@login_required
def classes():
    conn = get_db()
    c = conn.cursor()
    c.execute("""SELECT c.*, f.nom as filiere, n.nom as niveau FROM classes c
        JOIN filieres f ON c.filiere_id = f.id
        JOIN niveaux n ON c.niveau_id = n.id ORDER BY n.ordre, f.nom""")
    rows = c.fetchall()
    conn.close()

    content = """<div class="card"><div class="card-header">
        <h2><i class="fas fa-chalkboard"></i> Classes</h2>
        <a href="/classes/ajouter" class="btn btn-primary"><i class="fas fa-plus"></i> Ajouter</a>
    </div><table><thead><tr><th>Code</th><th>Nom</th><th>Filière</th><th>Niveau</th><th>Effectif</th><th>Capacité</th><th>Actions</th></tr></thead><tbody>"""
    for cl in rows:
        content += f"""<tr>
            <td><strong>{cl['code']}</strong></td>
            <td>{cl['nom']}</td>
            <td>{cl['filiere']}</td>
            <td>{cl['niveau']}</td>
            <td>{cl['effectif'] or 0}</td>
            <td>{cl['capacite']}</td>
            <td>
                <a href="/classes/{cl['id']}/edit" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i></a>
                <a href="/classes/{cl['id']}/delete" class="btn btn-danger btn-sm" onclick="return confirm('Supprimer ?')"><i class="fas fa-trash"></i></a>
            </td>
        </tr>"""
    content += "</tbody></table></div>"
    return render_page(content, active='classes')


@app.route("/classes/ajouter", methods=["GET", "POST"])
@prof_or_admin_required
def ajouter_classe():
    conn = get_db()
    c = conn.cursor()
    if request.method == "POST":
        code = generer_code("CL-", "classes", "code")
        c.execute("""INSERT INTO classes (code, nom, niveau_id, filiere_id, annee_academique, capacite)
            VALUES (?, ?, ?, ?, ?, ?)""",
            (code, request.form['nom'], int(request.form['niveau_id']),
             int(request.form['filiere_id']), request.form['annee_academique'],
             int(request.form['capacite'])))
        conn.commit()
        log_action(current_user.id, 'CREATE', 'classes', c.lastrowid, f"{code}", request.remote_addr)
        conn.close()
        flash("Classe ajoutée", "success")
        return redirect("/classes")

    niveaux = c.execute("SELECT id, nom FROM niveaux ORDER BY ordre").fetchall()
    filieres = c.execute("SELECT id, nom FROM filieres ORDER BY nom").fetchall()
    conn.close()
    no = "".join(f'<option value="{n["id"]}">{n["nom"]}</option>' for n in niveaux)
    fo = "".join(f'<option value="{f["id"]}">{f["nom"]}</option>' for f in filieres)

    content = f"""<div class="form-container">
        <h2><i class="fas fa-plus"></i> Ajouter une Classe</h2>
        <form method="POST">
            <div class="form-row">
                <div class="form-group"><label>Nom *</label><input type="text" name="nom" required></div>
                <div class="form-group"><label>Année académique *</label><input type="text" name="annee_academique" value="2025-2026" required></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Niveau *</label><select name="niveau_id" required>{no}</select></div>
                <div class="form-group"><label>Filière *</label><select name="filiere_id" required>{fo}</select></div>
            </div>
            <div class="form-group"><label>Capacité *</label><input type="number" name="capacite" value="30" required></div>
            <button type="submit" class="btn btn-success" style="width:100%;"><i class="fas fa-save"></i> Enregistrer</button>
        </form>
