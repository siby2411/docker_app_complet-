# ==================== MIDDLEWARE PRÉFIXE ====================
class PrefixMiddleware:
    def __init__(self, app, prefix='/ecole'):
        self.app = app
        self.prefix = prefix

    def __call__(self, environ, start_response):
        path = environ.get('PATH_INFO', '')
        if path.startswith(self.prefix + '/'):
            environ['PATH_INFO'] = path[len(self.prefix):]
        elif path == self.prefix:
            environ['PATH_INFO'] = '/'
        return self.app(environ, start_response)


app.wsgi_app = ProxyFix(app.wsgi_app, x_for=1, x_proto=1, x_host=1, x_prefix=1)
app.wsgi_app = PrefixMiddleware(app.wsgi_app, prefix='/ecole')

init_auth(app)

DB_PATH = "/app/data/ecole.db"


# ==================== DB ====================
def get_db():
    os.makedirs("/app/data", exist_ok=True)
    conn = sqlite3.connect(DB_PATH, timeout=30.0)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA busy_timeout=30000")
    conn.execute("PRAGMA journal_mode=WAL")
    conn.execute("PRAGMA synchronous=NORMAL")
    return conn


# ==================== HELPERS ====================
def generer_code(prefix, table, champ):
    conn = get_db()
    c = conn.cursor()
    c.execute(f"SELECT COUNT(*) FROM {table}")
    n = c.fetchone()[0] + 1
    conn.close()
    return f"{prefix}{n:04d}"


def _float_or_none(v):
    if v is None or v == '':
        return None
    try:
        return float(v)
    except (ValueError, TypeError):
        return None


def calculer_moyenne_etudiant(etudiant_id, semestre_id=None):
    conn = get_db()
    c = conn.cursor()
    try:
        if semestre_id:
            c.execute("""SELECT SUM(n.note_finale * m.coefficient) / SUM(m.coefficient),
                    COUNT(*),
                    SUM(CASE WHEN n.note_finale >= 10 THEN 1 ELSE 0 END),
                    SUM(CASE WHEN n.note_finale IS NOT NULL AND n.note_finale < 10 THEN 1 ELSE 0 END)
                FROM notes n JOIN matieres m ON n.matiere_id = m.id
                WHERE n.etudiant_id = ? AND n.semestre_id = ?
                AND n.note_finale IS NOT NULL""", (etudiant_id, semestre_id))
        else:
            c.execute("""SELECT SUM(n.note_finale * m.coefficient) / SUM(m.coefficient),
                    COUNT(*),
                    SUM(CASE WHEN n.note_finale >= 10 THEN 1 ELSE 0 END),
                    SUM(CASE WHEN n.note_finale IS NOT NULL AND n.note_finale < 10 THEN 1 ELSE 0 END)
                FROM notes n JOIN matieres m ON n.matiere_id = m.id
                WHERE n.etudiant_id = ? AND n.note_finale IS NOT NULL""", (etudiant_id,))
        r = c.fetchone()
        if r and r[0] is not None:
            conn.close()
            return {'moyenne': round(r[0] or 0, 2), 'nb_matieres': r[1] or 0,
                    'validees': r[2] or 0, 'echecs': r[3] or 0}
    except sqlite3.OperationalError:
        pass

    c.execute("""SELECT SUM(b.note_finale * m.coefficient) / SUM(m.coefficient),
            COUNT(*),
            SUM(CASE WHEN b.note_finale >= 10 THEN 1 ELSE 0 END),
            SUM(CASE WHEN b.note_finale < 10 AND b.note_finale > 0 THEN 1 ELSE 0 END)
        FROM bulletins b JOIN matieres m ON b.matiere_id = m.id
        WHERE b.etudiant_id = ?""", (etudiant_id,))
    r = c.fetchone()
    conn.close()
    return {'moyenne': round(r[0] or 0, 2), 'nb_matieres': r[1] or 0,
            'validees': r[2] or 0, 'echecs': r[3] or 0}


def get_classement(etudiant_id, semestre_id=None):
    conn = get_db()
    c = conn.cursor()
    try:
        if semestre_id:
            c.execute("""SELECT e.id,
                (SELECT SUM(n.note_finale * m.coefficient) / SUM(m.coefficient)
                 FROM notes n JOIN matieres m ON n.matiere_id = m.id
                 WHERE n.etudiant_id = e.id AND n.semestre_id = ?
                 AND n.note_finale IS NOT NULL)
                FROM etudiants e
                WHERE e.classe_id = (SELECT classe_id FROM etudiants WHERE id = ?)
                ORDER BY 2 DESC""", (semestre_id, etudiant_id))
        else:
            raise sqlite3.OperationalError("no")
    except sqlite3.OperationalError:
        c.execute("""SELECT e.id, (SELECT AVG(b.note_finale * m.coefficient) / AVG(m.coefficient)
                FROM bulletins b JOIN matieres m ON b.matiere_id = m.id
                WHERE b.etudiant_id = e.id)
            FROM etudiants e
            WHERE e.classe_id = (SELECT classe_id FROM etudiants WHERE id = ?)
            ORDER BY 2 DESC""", (etudiant_id,))
    classement = c.fetchall()
    conn.close()
    for i, e in enumerate(classement):
        if e[0] == etudiant_id:
            return i + 1, len(classement)
    return 0, 0


def _recalculer_rangs(cursor, classe_id, semestre_id):
    try:
        cursor.execute("""SELECT n.etudiant_id,
                SUM(n.note_finale * m.coefficient) / SUM(m.coefficient) as moy
            FROM notes n JOIN matieres m ON n.matiere_id = m.id
            WHERE n.classe_id = ? AND n.semestre_id = ? AND n.note_finale IS NOT NULL
            GROUP BY n.etudiant_id ORDER BY moy DESC""", (classe_id, semestre_id))
        for i, (etu_id, _) in enumerate(cursor.fetchall(), 1):
            cursor.execute("""UPDATE notes SET rang = ?
                WHERE etudiant_id = ? AND semestre_id = ? AND classe_id = ?""",
                (i, etu_id, semestre_id, classe_id))
    except sqlite3.OperationalError:
        pass


