@app.route("/classes/<int:id>/edit", methods=["GET", "POST"])
@prof_or_admin_required
def edit_classe(id):
    conn = get_db()
    c = conn.cursor()
    if request.method == "POST":
        c.execute("""UPDATE classes SET nom=?, niveau_id=?, filiere_id=?, annee_academique=?, capacite=? WHERE id=?""",
            (request.form['nom'], int(request.form['niveau_id']), int(request.form['filiere_id']),
             request.form['annee_academique'], int(request.form['capacite']), id))
        conn.commit()
        log_action(current_user.id, 'UPDATE', 'classes', id, 'OK', request.remote_addr)
        conn.close()
        flash("Classe mise à jour", "success")
        return redirect("/classes")

    cl = c.execute("SELECT * FROM classes WHERE id=?", (id,)).fetchone()
    niveaux = c.execute("SELECT id, nom FROM niveaux ORDER BY ordre").fetchall()
    filieres = c.execute("SELECT id, nom FROM filieres ORDER BY nom").fetchall()
    conn.close()
    no = "".join(f'<option value="{n["id"]}" {"selected" if n["id"]==cl["niveau_id"] else ""}>{n["nom"]}</option>' for n in niveaux)
    fo = "".join(f'<option value="{f["id"]}" {"selected" if f["id"]==cl["filiere_id"] else ""}>{f["nom"]}</option>' for f in filieres)

    content = f"""<div class="form-container">
        <h2><i class="fas fa-edit"></i> Modifier {cl['code']}</h2>
        <form method="POST">
            <div class="form-row">
                <div class="form-group"><label>Nom *</label><input type="text" name="nom" value="{cl['nom']}" required></div>
                <div class="form-group"><label>Année *</label><input type="text" name="annee_academique" value="{cl['annee_academique']}" required></div>
            </div>
            <div class="form-row">
                <div class="form-group"><label>Niveau *</label><select name="niveau_id" required>{no}</select></div>
                <div class="form-group"><label>Filière *</label><select name="filiere_id" required>{fo}</select></div>
            </div>
            <div class="form-group"><label>Capacité *</label><input type="number" name="capacite" value="{cl['capacite']}" required></div>
            <button type="submit" class="btn btn-primary" style="width:100%;"><i class="fas fa-save"></i> Mettre à jour</button>
        </form>
        <br><a href="/classes" class="btn btn-info"><i class="fas fa-arrow-left"></i> Retour</a>
    </div>"""
    return render_page(content, active='classes')


