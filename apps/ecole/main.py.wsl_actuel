# ==================== MATIÈRES ====================
@app.route("/matieres")
@login_required
def matieres():
    conn = get_db()
    c = conn.cursor()
    c.execute("""SELECT m.*, n.nom as niveau_nom FROM matieres m
        JOIN niveaux n ON m.niveau_id = n.id ORDER BY n.ordre, m.nom""")
    rows = c.fetchall()
    conn.close()

    content = """<div class="card"><div class="card-header">
        <h2><i class="fas fa-book"></i> Matières</h2>
        <a href="/matieres/ajouter" class="btn btn-primary"><i class="fas fa-plus"></i> Ajouter</a>
    </div><table><thead><tr><th>Code</th><th>Nom</th><th>Niveau</th><th>Coeff</th><th>Crédits</th><th>Heures</th><th>Actions</th></tr></thead><tbody>"""
    for m in rows:
        content += f"""<tr>
            <td><strong>{m['code']}</strong></td><td>{m['nom']}</td><td>{m['niveau_nom']}</td>
            <td>{m['coefficient']}</td><td>{m['credit']}</td><td>{m['heures_cours']}h</td>
            <td>
                <a href="/matieres/{m['id']}/edit" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i></a>
                <a href="/matieres/{m['id']}/delete" class="btn btn-danger btn-sm" onclick="return confirm('Supprimer ?')"><i class="fas fa-trash"></i></a>
            </td>
        </tr>"""
    content += "</tbody></table></div>"
    return render_page(content, active='matieres')


