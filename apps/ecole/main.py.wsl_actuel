def render_page(content, active='dashboard'):
    flash_html = """
    {% with messages = get_flashed_messages(with_categories=true) %}
        {% if messages %}{% for cat, msg in messages %}
            <div class="flash flash-{{ cat }}">{{ msg }}</div>
        {% endfor %}{% endif %}
    {% endwith %}
    """
    page = HTML_BASE.replace("{CONTENT}", content).replace("{FLASH_MESSAGES}", flash_html)
    if current_user.is_authenticated:
        page = page.replace("{CURRENT_USER}", current_user.username)
        page = page.replace("{CURRENT_ROLE}", current_user.role)
    else:
        page = page.replace("{CURRENT_USER}", "Anonyme")
        page = page.replace("{CURRENT_ROLE}", "")
    page = page.replace("{{ 'active' if active=='" + active + "' else '' }}", "active")
    return render_template_string(page, active=active)


