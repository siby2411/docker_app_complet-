            margin-top:20px; font-size:0.75rem; color:#4a5568; }
        .demo-accounts strong { color:#1a1a2e; display:block; margin-bottom:5px; }
        .demo-accounts code { background:#e2e8f0; padding:2px 6px; border-radius:3px;
