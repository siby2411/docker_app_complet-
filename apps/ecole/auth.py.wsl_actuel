"""Authentification Flask-Login + rôles + audit"""
from flask import render_template_string, request, redirect, flash
from flask_login import LoginManager, UserMixin, login_user, logout_user, current_user
from werkzeug.security import generate_password_hash, check_password_hash
from functools import wraps
import sqlite3
import os
from datetime import datetime

DB_PATH = "/app/data/ecole.db"

login_manager = LoginManager()
login_manager.login_view = '/login'
login_manager.login_message = "Veuillez vous connecter."
login_manager.login_message_category = "warning"
login_manager.session_protection = "strong"


def get_db():
    os.makedirs("/app/data", exist_ok=True)
    conn = sqlite3.connect(DB_PATH, timeout=30.0)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA busy_timeout=30000")
    conn.execute("PRAGMA journal_mode=WAL")
    return conn


class User(UserMixin):
    def __init__(self, id, username, role, etudiant_id=None, professeur_id=None, email=None):
        self.id = str(id)
        self.username = username
        self.role = role
        self.etudiant_id = etudiant_id
        self.professeur_id = professeur_id
        self.email = email

    @property
    def is_admin(self):
        return self.role == 'admin'

    @property
    def is_professeur(self):
        return self.role == 'professeur'

    @property
    def is_etudiant(self):
        return self.role == 'etudiant'

    def can_edit(self):
        return self.role in ('admin', 'professeur')

    def can_delete(self):
        return self.role == 'admin'


@login_manager.user_loader
def load_user(user_id):
    conn = get_db()
    c = conn.cursor()
    c.execute("""SELECT id, username, role, etudiant_id, professeur_id, email
        FROM utilisateurs WHERE id=? AND actif=1""", (user_id,))
    row = c.fetchone()
    conn.close()
    if row:
        return User(row['id'], row['username'], row['role'],
                    row['etudiant_id'], row['professeur_id'], row['email'])
    return None


def log_action(user_id, action, table_cible=None, enregistrement_id=None, details=None, ip=None):
    try:
        conn = get_db()
        c = conn.cursor()
        c.execute("""INSERT INTO audit_log 
            (user_id, action, table_cible, enregistrement_id, details, ip)
            VALUES (?, ?, ?, ?, ?, ?)""",
            (user_id, action, table_cible, enregistrement_id, details, ip))
        conn.commit()
        conn.close()
    except Exception as e:
        print(f"[AUDIT] {e}")


def init_auth(app):
    login_manager.init_app(app)

    @app.route("/login", methods=["GET", "POST"])
    def login():
        if current_user.is_authenticated:
            return redirect("/")

        if request.method == "POST":
            username = request.form.get('username', '').strip()
            password = request.form.get('password', '')

            if not username or not password:
                flash("Identifiants requis", "danger")
                return render_template_string(LOGIN_HTML)

            conn = get_db()
            c = conn.cursor()
            c.execute("""SELECT id, username, password_hash, role, etudiant_id,
                professeur_id, email, actif FROM utilisateurs WHERE username=?""",
                (username,))
            row = c.fetchone()

            if row and row['actif']:
                pwd_ok = False
                sh = row['password_hash']

                try:
                    if sh.startswith(('pbkdf2:', 'scrypt:')):
                        pwd_ok = check_password_hash(sh, password)
                except Exception:
                    pass

                if not pwd_ok:
                    from hashlib import sha256
                    if sh == sha256(password.encode()).hexdigest():
                        pwd_ok = True
                        new_hash = generate_password_hash(password)
                        c.execute("UPDATE utilisateurs SET password_hash=? WHERE id=?",
                                  (new_hash, row['id']))
                        conn.commit()

                if pwd_ok:
                    user = User(row['id'], row['username'], row['role'],
                                row['etudiant_id'], row['professeur_id'], row['email'])
                    login_user(user, remember=True)
                    c.execute("UPDATE utilisateurs SET derniere_connexion=? WHERE id=?",
                              (datetime.now().isoformat(), row['id']))
                    conn.commit()
                    conn.close()
                    log_action(row['id'], 'LOGIN', 'utilisateurs', row['id'], 'OK', request.remote_addr)
                    flash(f"Bienvenue {user.username} !", "success")
                    nxt = request.args.get('next')
                    return redirect(nxt if nxt and nxt.startswith('/') else "/")
                else:
                    conn.close()
                    log_action(None, 'LOGIN_FAILED', 'utilisateurs', None,
                               f"Échec {username}", request.remote_addr)
                    flash("Mot de passe incorrect", "danger")
            else:
                conn.close()
                flash("Utilisateur inconnu ou inactif", "danger")

        return render_template_string(LOGIN_HTML)

    @app.route("/logout")
    def logout():
        if current_user.is_authenticated:
            log_action(current_user.id, 'LOGOUT', 'utilisateurs', current_user.id, 'OK', request.remote_addr)
            logout_user()
        flash("Déconnecté", "success")
        return redirect("/login")

    @app.route("/auth/me")
    def auth_me():
        if not current_user.is_authenticated:
            return {"authenticated": False}
        return {"authenticated": True, "username": current_user.username,
                "role": current_user.role, "can_edit": current_user.can_edit(),
                "can_delete": current_user.can_delete()}

    return app


def admin_required(f):
    @wraps(f)
    def deco(*args, **kwargs):
        if not current_user.is_authenticated:
            flash("Veuillez vous connecter", "warning")
            return redirect('/login?next=' + request.path)
        if not current_user.is_admin:
            flash("Accès réservé aux administrateurs", "danger")
            return redirect("/")
        return f(*args, **kwargs)
    return deco


def prof_or_admin_required(f):
    @wraps(f)
    def deco(*args, **kwargs):
        if not current_user.is_authenticated:
            flash("Veuillez vous connecter", "warning")
            return redirect('/login?next=' + request.path)
        if not current_user.can_edit():
            flash("Accès réservé aux professeurs et administrateurs", "danger")
            return redirect("/")
        return f(*args, **kwargs)
    return deco


