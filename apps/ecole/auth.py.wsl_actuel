        .btn-login { width:100%; padding:14px; background:#e94560; color:white;
            border:none; border-radius:8px; font-size:1rem; font-weight:600; cursor:pointer; margin-top:10px; }
        .btn-login:hover { background:#c73652; }
        .flash { padding:10px 15px; border-radius:6px; margin-bottom:15px; font-size:0.9rem; }
