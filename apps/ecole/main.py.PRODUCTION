from flask import Flask, render_template_string, request, redirect, url_for, jsonify
import sqlite3
from datetime import datetime

app = Flask(__name__)
DB_PATH = "ecole.db"

def init_db():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    
    # Tables LMD
    c.execute("CREATE TABLE IF NOT EXISTS cycles (id INTEGER PRIMARY KEY AUTOINCREMENT, code TEXT UNIQUE, nom TEXT)")
    c.execute("CREATE TABLE IF NOT EXISTS filieres (id INTEGER PRIMARY KEY AUTOINCREMENT, code TEXT UNIQUE, nom TEXT, cycle_id INTEGER)")
    c.execute("CREATE TABLE IF NOT EXISTS niveaux (id INTEGER PRIMARY KEY AUTOINCREMENT, code TEXT UNIQUE, nom TEXT, cycle_id INTEGER, ordre INTEGER)")
    c.execute("CREATE TABLE IF NOT EXISTS classes (id INTEGER PRIMARY KEY AUTOINCREMENT, code TEXT UNIQUE, nom TEXT, niveau_id INTEGER, filiere_id INTEGER, capacite INTEGER)")
    c.execute("CREATE TABLE IF NOT EXISTS matieres (id INTEGER PRIMARY KEY AUTOINCREMENT, code TEXT UNIQUE, nom TEXT, niveau_id INTEGER, coefficient INTEGER, credit INTEGER)")
    c.execute("CREATE TABLE IF NOT EXISTS etudiants (id INTEGER PRIMARY KEY AUTOINCREMENT, matricule TEXT UNIQUE, nom TEXT, prenom TEXT, date_naissance TEXT, sexe TEXT, telephone TEXT, email TEXT, classe_id INTEGER, date_inscription TEXT, statut TEXT DEFAULT 'Actif')")
    c.execute("CREATE TABLE IF NOT EXISTS bulletins (id INTEGER PRIMARY KEY AUTOINCREMENT, etudiant_id INTEGER, matiere_id INTEGER, note_cc REAL, note_tp REAL, note_examen REAL, note_finale REAL, statut TEXT DEFAULT 'En cours')")
    c.execute("CREATE TABLE IF NOT EXISTS professeurs (id INTEGER PRIMARY KEY AUTOINCREMENT, code TEXT UNIQUE, nom TEXT, prenom TEXT, telephone TEXT, email TEXT, specialite TEXT)")
    c.execute("CREATE TABLE IF NOT EXISTS affectations (id INTEGER PRIMARY KEY AUTOINCREMENT, professeur_id INTEGER, matiere_id INTEGER, classe_id INTEGER, annee_academique TEXT)")
    c.execute("CREATE TABLE IF NOT EXISTS scolarite (id INTEGER PRIMARY KEY AUTOINCREMENT, etudiant_id INTEGER, montant REAL, mois TEXT, date_paiement TEXT, statut TEXT DEFAULT 'En attente')")
    
    c.execute("SELECT COUNT(*) FROM cycles")
    if c.fetchone()[0] == 0:
        c.executemany("INSERT INTO cycles (code, nom) VALUES (?, ?)",
            [("LIC", "Licence"), ("MAS", "Master"), ("DOC", "Doctorat")])
        
        c.executemany("INSERT INTO niveaux (code, nom, cycle_id, ordre) VALUES (?, ?, ?, ?)",
            [("L1", "Licence 1", 1, 1), ("L2", "Licence 2", 1, 2), ("L3", "Licence 3", 1, 3),
             ("M1", "Master 1", 2, 1), ("M2", "Master 2", 2, 2),
             ("D1", "Doctorat 1", 3, 1), ("D2", "Doctorat 2", 3, 2), ("D3", "Doctorat 3", 3, 3)])
        
        c.executemany("INSERT INTO filieres (code, nom, cycle_id) VALUES (?, ?, ?)",
            [("IA", "Informatique Appliquee", 1), ("SE", "Systemes Embarques", 1),
             ("RS", "Reseaux et Securite", 1), ("DS", "Data Science", 1),
             ("GL", "Genie Logiciel", 1), ("MIAGE", "MIAGE", 1)])
        
        c.executemany("INSERT INTO classes (code, nom, niveau_id, filiere_id, capacite) VALUES (?, ?, ?, ?, ?)",
            [("IA-L1", "IA - Licence 1", 1, 1, 40), ("IA-L2", "IA - Licence 2", 2, 1, 35),
             ("IA-L3", "IA - Licence 3", 3, 1, 30), ("DS-M1", "DS - Master 1", 4, 4, 25),
             ("GL-M1", "GL - Master 1", 4, 5, 25)])
        
        c.executemany("INSERT INTO matieres (code, nom, niveau_id, coefficient, credit) VALUES (?, ?, ?, ?, ?)",
            [("ALGO", "Algorithmique", 1, 3, 4), ("PROG", "Programmation", 1, 4, 5),
             ("BD", "Bases de Donnees", 1, 3, 4), ("RES", "Reseaux", 1, 2, 3),
             ("POO", "Programmation Objet", 2, 4, 5), ("WEB", "Developpement Web", 2, 3, 4)])
        
        c.executemany("INSERT INTO professeurs (code, nom, prenom, telephone, email, specialite) VALUES (?, ?, ?, ?, ?, ?)",
            [("P001", "Diop", "Mamadou", "771234567", "mamadou@omega.sn", "Algorithmique"),
             ("P002", "Fall", "Aminata", "772345678", "aminata@omega.sn", "Bases de Donnees")])
        
        c.executemany("INSERT INTO affectations (professeur_id, matiere_id, classe_id, annee_academique) VALUES (?, ?, ?, ?)",
            [(1, 1, 1, "2025-2026"), (1, 2, 1, "2025-2026"), (2, 3, 1, "2025-2026")])
        
        c.executemany("INSERT INTO etudiants (matricule, nom, prenom, date_naissance, sexe, telephone, email, classe_id, date_inscription, statut) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, 'Actif')",
            [("E001", "Sarr", "Aliou", "2000-05-15", "M", "771234568", "aliou@edu.sn", 1, datetime.now().isoformat()),
             ("E002", "Ba", "Aissatou", "2001-03-22", "F", "772345679", "aissatou@edu.sn", 1, datetime.now().isoformat())])
        
        c.execute("""
            INSERT INTO bulletins (etudiant_id, matiere_id, note_cc, note_tp, note_examen, note_finale, statut)
            SELECT e.id, m.id, 0, 0, 0, 0, 'En cours'
            FROM etudiants e
            JOIN classes c ON e.classe_id = c.id
            JOIN matieres m ON m.niveau_id = c.niveau_id
        """)
        
        c.executemany("INSERT INTO scolarite (etudiant_id, montant, mois, date_paiement, statut) VALUES (?, ?, ?, ?, 'Paye')",
            [(1, 150000, "Septembre", datetime.now().isoformat()),
             (2, 150000, "Septembre", datetime.now().isoformat())])
        
        conn.commit()
    conn.close()

init_db()

