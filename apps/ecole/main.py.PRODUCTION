        <table><thead><tr><th>Code</th><th>Nom</th><th>Niveau</th><th>Coeff</th><th>Credits</th></tr></thead><tbody>{rows}</tbody></table>
    </div>
    """
    return render_template_string(HTML.replace('{% for e in etudiants %}', '').replace('{% endfor %}', ''), stats={'total':0,'actifs':0,'classes':0,'scolarite':0}, etudiants=[])

@app.route("/professeurs")
def professeurs():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("""
        SELECT p.*, (SELECT COUNT(*) FROM affectations WHERE professeur_id = p.id) as nb_matieres
        FROM professeurs p
        ORDER BY p.nom
    """)
    profs = c.fetchall()
    conn.close()
    rows = "".join(f'<tr><td>{p[1]}</td><td>{p[2]} {p[3]}</td><td>{p[6] or "-"}</td><td>{p[4]}</td><td>{p[8]}</td></tr>' for p in profs)
    prof_html = f"""
    <div class="card">
        <div class="card-header"><h2><i class="fas fa-chalkboard-teacher"></i> Professeurs</h2></div>
        <table><thead><tr><th>Code</th><th>Nom & Prenom</th><th>Specialite</th><th>Telephone</th><th>Matieres</th></tr></thead><tbody>{rows}</tbody></table>
    </div>
    """
    return render_template_string(HTML.replace('{% for e in etudiants %}', '').replace('{% endfor %}', ''), stats={'total':0,'actifs':0,'classes':0,'scolarite':0}, etudiants=[])

@app.route("/scolarite")
def scolarite():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("""
        SELECT s.*, e.nom, e.prenom, e.matricule
        FROM scolarite s
        JOIN etudiants e ON s.etudiant_id = e.id
        ORDER BY s.date_paiement DESC
    """)
    rows = c.fetchall()
    conn.close()
    rows_html = "".join(f'<tr><td>{r[8]} {r[9]}</td><td>{r[10]}</td><td>{r[2]} FCFA</td><td>{r[3]}</td><td>{r[4]}</td><td><span class="badge {"badge-success" if r[7]=="Paye" else "badge-warning"}">{r[7]}</span></td></tr>' for r in rows)
    scolarite_html = f"""
    <div class="card">
        <div class="card-header"><h2><i class="fas fa-money-bill-wave"></i> Scolarite</h2></div>
        <table><thead><tr><th>Etudiant</th><th>Matricule</th><th>Montant</th><th>Mois</th><th>Date</th><th>Statut</th></tr></thead><tbody>{rows_html}</tbody></table>
    </div>
    """
    return render_template_string(HTML.replace('{% for e in etudiants %}', '').replace('{% endfor %}', ''), stats={'total':0,'actifs':0,'classes':0,'scolarite':0}, etudiants=[])

@app.route("/bulletins")
def liste_bulletins():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("""
        SELECT b.*, e.nom, e.prenom, m.nom as matiere_nom
        FROM bulletins b
        JOIN etudiants e ON b.etudiant_id = e.id
        JOIN matieres m ON b.matiere_id = m.id
        ORDER BY b.id DESC LIMIT 50
    """)
    bulletins = c.fetchall()
    conn.close()
    rows = "".join(f'<tr><td>{b[10]} {b[11]}</td><td>{b[12]}</td><td>{b[3]}</td><td>{b[4]}</td><td>{b[5]}</td><td><strong>{b[6]}</strong></td></tr>' for b in bulletins)
    bulletins_html = f"""
    <div class="card">
        <div class="card-header"><h2><i class="fas fa-file-alt"></i> Bulletins</h2></div>
        <table><thead><tr><th>Etudiant</th><th>Matiere</th><th>CC</th><th>TP</th><th>Examen</th><th>Finale</th></tr></thead><tbody>{rows}</tbody></table>
    </div>
    """
    return render_template_string(HTML.replace('{% for e in etudiants %}', '').replace('{% endfor %}', ''), stats={'total':0,'actifs':0,'classes':0,'scolarite':0}, etudiants=[])

@app.route("/api/etudiants")
def api_etudiants():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("""
        SELECT e.id, e.matricule, e.nom, e.prenom, c.nom as classe,
               (SELECT AVG(b.note_finale * m.coefficient) / AVG(m.coefficient) 
                FROM bulletins b 
                JOIN matieres m ON b.matiere_id = m.id 
                WHERE b.etudiant_id = e.id) as moyenne
        FROM etudiants e
        JOIN classes c ON e.classe_id = c.id
    """)
    rows = c.fetchall()
    conn.close()
    return jsonify([{"id": r[0], "matricule": r[1], "nom": r[2], "prenom": r[3], "classe": r[4], "moyenne": round(r[5] or 0, 2)} for r in rows])

if __name__ == "__main__":
    app.run(host="0.0.0.0", port=8000, debug=False)
