# ===== ROUTES =====

@app.route("/")
def index():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT COUNT(*) FROM etudiants")
    total = c.fetchone()[0]
    c.execute("SELECT COUNT(*) FROM etudiants WHERE statut='Actif'")
    actifs = c.fetchone()[0]
    c.execute("SELECT COUNT(*) FROM classes")
    classes = c.fetchone()[0]
    c.execute("SELECT SUM(montant) FROM scolarite WHERE statut='Paye'")
    scolarite = c.fetchone()[0] or 0
    c.execute("""
        SELECT e.*, c.nom as classe_nom,
               (SELECT AVG(b.note_finale * m.coefficient) / AVG(m.coefficient) 
                FROM bulletins b 
                JOIN matieres m ON b.matiere_id = m.id 
                WHERE b.etudiant_id = e.id) as moyenne
        FROM etudiants e
        JOIN classes c ON e.classe_id = c.id
        ORDER BY e.id DESC LIMIT 15
    """)
    etudiants = c.fetchall()
    conn.close()
    stats = {'total': total, 'actifs': actifs, 'classes': classes, 'scolarite': scolarite}
    return render_template_string(HTML, stats=stats, etudiants=etudiants)

@app.route("/etudiants")
def liste_etudiants():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("""
        SELECT e.*, c.nom as classe_nom,
               (SELECT AVG(b.note_finale * m.coefficient) / AVG(m.coefficient) 
                FROM bulletins b 
                JOIN matieres m ON b.matiere_id = m.id 
                WHERE b.etudiant_id = e.id) as moyenne
        FROM etudiants e
        JOIN classes c ON e.classe_id = c.id
        ORDER BY e.nom
    """)
    etudiants = c.fetchall()
    conn.close()
    return render_template_string(HTML, stats={'total':0,'actifs':0,'classes':0,'scolarite':0}, etudiants=etudiants)

@app.route("/inscription", methods=["GET", "POST"])
def inscription():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    if request.method == "POST":
        c.execute("SELECT COUNT(*) FROM etudiants")
        count = c.fetchone()[0] + 1
        matricule = f"E{count:04d}"
        c.execute("""
            INSERT INTO etudiants (matricule, nom, prenom, date_naissance, sexe, telephone, email, classe_id, date_inscription, statut)
            VALUES (?, ?, ?, ?, ?, ?, ?, ?, date('now'), 'Actif')
        """, (
            matricule, request.form['nom'], request.form['prenom'], request.form['date_naissance'],
            request.form['sexe'], request.form['telephone'], request.form['email'], int(request.form['classe_id'])
        ))
        etudiant_id = c.lastrowid
        c.execute("""
            INSERT INTO bulletins (etudiant_id, matiere_id, note_cc, note_tp, note_examen, note_finale, statut)
            SELECT ?, m.id, 0, 0, 0, 0, 'En cours'
            FROM matieres m
            WHERE m.niveau_id = (SELECT niveau_id FROM classes WHERE id = ?)
        """, (etudiant_id, int(request.form['classe_id'])))
        conn.commit()
        conn.close()
        return redirect(url_for('detail_etudiant', id=etudiant_id))
    
    c.execute("SELECT id, code, nom FROM classes ORDER BY nom")
    classes = c.fetchall()
    conn.close()
    options = "".join(f'<option value="{c[0]}">{c[2]}</option>' for c in classes)
    
    form_html = f"""
    <div class="form-container">
        <h2><i class="fas fa-user-plus"></i> Inscription</h2>
        <p style="color:#718096;margin-bottom:15px;">Le bulletin sera initialise automatiquement.</p>
        <form method="POST">
            <div class="form-row"><div class="form-group"><label>Nom *</label><input type="text" name="nom" required></div>
            <div class="form-group"><label>Prenom *</label><input type="text" name="prenom" required></div></div>
            <div class="form-row"><div class="form-group"><label>Date naissance *</label><input type="date" name="date_naissance" required></div>
            <div class="form-group"><label>Sexe *</label><select name="sexe" required><option value="M">Masculin</option><option value="F">Feminin</option></select></div></div>
            <div class="form-row"><div class="form-group"><label>Telephone *</label><input type="text" name="telephone" required></div>
            <div class="form-group"><label>Email *</label><input type="email" name="email" required></div></div>
            <div class="form-group"><label>Classe *</label><select name="classe_id" required>{options}</select></div>
            <button type="submit" class="btn btn-primary" style="width:100%;"><i class="fas fa-save"></i> Inscrire</button>
        </form>
        <br><a href="/" class="btn btn-info"><i class="fas fa-arrow-left"></i> Retour</a>
    </div>
    """
    return render_template_string(HTML.replace('{% for e in etudiants %}', '').replace('{% endfor %}', ''), stats={'total':0,'actifs':0,'classes':0,'scolarite':0}, etudiants=[])

@app.route("/etudiant/<int:id>")
def detail_etudiant(id):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("""
        SELECT e.*, c.nom as classe_nom
        FROM etudiants e
        JOIN classes c ON e.classe_id = c.id
        WHERE e.id = ?
    """, (id,))
    e = c.fetchone()
    if not e:
        conn.close()
        return redirect(url_for('index'))
    c.execute("""
        SELECT b.*, m.nom as matiere_nom, m.coefficient
        FROM bulletins b
        JOIN matieres m ON b.matiere_id = m.id
        WHERE b.etudiant_id = ?
        ORDER BY m.nom
    """, (id,))
    bulletins = c.fetchall()
    conn.close()
    rows = "".join(f'<tr><td>{b[9]}</td><td>{b[10]}</td><td>{b[3]}</td><td>{b[4]}</td><td>{b[5]}</td><td><strong>{b[6]}</strong></td></tr>' for b in bulletins)
    
    detail_html = f"""
    <div class="card">
        <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;">
            <div><h2>{e[2]} {e[3]}</h2>
            <p>Matricule: <strong>{e[1]}</strong> | Classe: {e[10]} | Statut: <span class="badge badge-success">{e[9]}</span></p>
            <p>📞 {e[7]} | ✉️ {e[8]}</p></div>
            <div><a href="/notes/{id}" class="btn btn-success"><i class="fas fa-star"></i> Notes</a>
            <a href="/bulletin/{id}" class="btn btn-primary"><i class="fas fa-file-alt"></i> Bulletin</a></div>
        </div>
        <hr><h3>Bulletin</h3>
        <table><thead><tr><th>Matiere</th><th>Coeff</th><th>CC</th><th>TP</th><th>Examen</th><th>Finale</th></tr></thead><tbody>{rows}</tbody></table>
        <br><a href="/etudiants" class="btn btn-info"><i class="fas fa-arrow-left"></i> Retour</a>
    </div>
    """
    return render_template_string(HTML.replace('{% for e in etudiants %}', '').replace('{% endfor %}', ''), stats={'total':0,'actifs':0,'classes':0,'scolarite':0}, etudiants=[])

@app.route("/notes/<int:etudiant_id>", methods=["GET", "POST"])
def notes(etudiant_id):
    if request.method == "POST":
        conn = sqlite3.connect(DB_PATH)
        c = conn.cursor()
        for key, value in request.form.items():
            if key.startswith('note_'):
                parts = key.split('_')
                bid = int(parts[1])
                if parts[2] == 'cc':
                    c.execute("UPDATE bulletins SET note_cc=? WHERE id=?", (float(value), bid))
                elif parts[2] == 'tp':
                    c.execute("UPDATE bulletins SET note_tp=? WHERE id=?", (float(value), bid))
                elif parts[2] == 'examen':
                    c.execute("UPDATE bulletins SET note_examen=? WHERE id=?", (float(value), bid))
        c.execute("UPDATE bulletins SET note_finale = (note_cc + note_tp + note_examen) / 3 WHERE etudiant_id = ?", (etudiant_id,))
        conn.commit()
        conn.close()
        return redirect(url_for('bulletin_etudiant', etudiant_id=etudiant_id))
    
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT e.* FROM etudiants e WHERE e.id = ?", (etudiant_id,))
    e = c.fetchone()
    c.execute("SELECT b.*, m.nom FROM bulletins b JOIN matieres m ON b.matiere_id = m.id WHERE b.etudiant_id = ?", (etudiant_id,))
    bulletins = c.fetchall()
    conn.close()
    rows = "".join(f'<tr><td>{b[9]}</td><td>{b[10]}</td><td><input type="number" name="note_{b[0]}_cc" value="{b[3]}" step="0.5" min="0" max="20" style="width:70px;"></td><td><input type="number" name="note_{b[0]}_tp" value="{b[4]}" step="0.5" min="0" max="20" style="width:70px;"></td><td><input type="number" name="note_{b[0]}_examen" value="{b[5]}" step="0.5" min="0" max="20" style="width:70px;"></td></tr>' for b in bulletins)
    notes_html = f"""
    <div class="form-container" style="max-width:1000px;">
        <h2>Saisie des Notes - {e[2]} {e[3]}</h2>
        <form method="POST">
            <table><thead><tr><th>Matiere</th><th>Coeff</th><th>CC</th><th>TP</th><th>Examen</th></tr></thead><tbody>{rows}</tbody></table>
            <br><button type="submit" class="btn btn-success" style="width:100%;"><i class="fas fa-save"></i> Enregistrer</button>
        </form>
        <br><a href="/etudiant/{etudiant_id}" class="btn btn-info"><i class="fas fa-arrow-left"></i> Retour</a>
    </div>
    """
    return render_template_string(HTML.replace('{% for e in etudiants %}', '').replace('{% endfor %}', ''), stats={'total':0,'actifs':0,'classes':0,'scolarite':0}, etudiants=[])

@app.route("/bulletin/<int:etudiant_id>")
def bulletin_etudiant(etudiant_id):
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("""
        SELECT e.*, c.nom as classe_nom
        FROM etudiants e
        JOIN classes c ON e.classe_id = c.id
        WHERE e.id = ?
    """, (etudiant_id,))
    e = c.fetchone()
    if not e:
        conn.close()
        return redirect(url_for('index'))
    c.execute("""
        SELECT b.*, m.nom as matiere_nom, m.coefficient, m.credit
        FROM bulletins b
        JOIN matieres m ON b.matiere_id = m.id
        WHERE b.etudiant_id = ?
        ORDER BY m.nom
    """, (etudiant_id,))
    bulletins = c.fetchall()
    total_coeff = sum(b[10] for b in bulletins) if bulletins else 0
    total_notes = sum(b[6] * b[10] for b in bulletins) if bulletins else 0
    moyenne = round(total_notes / total_coeff, 2) if total_coeff > 0 else 0
    conn.close()
    rows = "".join(f'<tr><td>{b[9]}</td><td>{b[10]}</td><td>{b[11]}</td><td>{b[3]}</td><td>{b[4]}</td><td>{b[5]}</td><td><strong>{b[6]}</strong></td><td><span class="badge {"badge-success" if b[6]>=10 else "badge-danger"}">{"V" if b[6]>=10 else "NV"}</span></td></tr>' for b in bulletins)
    bulletin_html = f"""
    <div class="card">
        <div style="text-align:center;margin-bottom:15px;">
            <h2>OMEGA <span style="color:#e94560;">CONSULTING</span></h2>
            <h3>Bulletin de Notes</h3>
            <p>{e[2]} {e[3]} - {e[10]}</p>
            <p><strong>Moyenne: {moyenne}/20</strong></p>
        </div>
        <table><thead><tr><th>Matiere</th><th>Coeff</th><th>Credits</th><th>CC</th><th>TP</th><th>Examen</th><th>Finale</th><th>Statut</th></tr></thead><tbody>{rows}</tbody></table>
        <br><a href="/etudiant/{etudiant_id}" class="btn btn-info"><i class="fas fa-arrow-left"></i> Retour</a>
        <a href="#" onclick="window.print()" class="btn btn-primary"><i class="fas fa-print"></i> Imprimer</a>
    </div>
    """
    return render_template_string(HTML.replace('{% for e in etudiants %}', '').replace('{% endfor %}', ''), stats={'total':0,'actifs':0,'classes':0,'scolarite':0}, etudiants=[])

@app.route("/classes")
def classes():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("""
        SELECT c.*, f.nom, n.nom, (SELECT COUNT(*) FROM etudiants WHERE classe_id = c.id) as effectif
        FROM classes c
        JOIN filieres f ON c.filiere_id = f.id
        JOIN niveaux n ON c.niveau_id = n.id
        ORDER BY n.ordre
    """)
    classes = c.fetchall()
    conn.close()
    rows = "".join(f'<tr><td>{c[1]}</td><td>{c[2]}</td><td>{c[8]}</td><td>{c[9]}</td><td>{c[10] or 0}</td><td>{c[6]}</td></tr>' for c in classes)
    classes_html = f"""
    <div class="card">
        <div class="card-header"><h2><i class="fas fa-chalkboard"></i> Classes</h2></div>
        <table><thead><tr><th>Code</th><th>Nom</th><th>Filiere</th><th>Niveau</th><th>Effectif</th><th>Capacite</th></tr></thead><tbody>{rows}</tbody></table>
    </div>
    """
    return render_template_string(HTML.replace('{% for e in etudiants %}', '').replace('{% endfor %}', ''), stats={'total':0,'actifs':0,'classes':0,'scolarite':0}, etudiants=[])

@app.route("/matieres")
def matieres():
    conn = sqlite3.connect(DB_PATH)
    c = conn.cursor()
    c.execute("SELECT m.*, n.nom as niveau_nom FROM matieres m JOIN niveaux n ON m.niveau_id = n.id ORDER BY n.ordre")
    matieres = c.fetchall()
    conn.close()
    rows = "".join(f'<tr><td>{m[1]}</td><td>{m[2]}</td><td>{m[8]}</td><td>{m[4]}</td><td>{m[5]}</td></tr>' for m in matieres)
    matieres_html = f"""
