# ==================== STAGE 1 : BUILDER ====================
FROM python:3.11-slim-bookworm AS builder

ARG MIRROR=debian.mirrors.ovh.net

# Configuration APT : miroir OVH + timeouts + IPv4 forcé
RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i "s@deb.debian.org@${MIRROR}@g" /etc/apt/sources.list.d/debian.sources; \
        sed -i "s@security.debian.org@${MIRROR}@g" /etc/apt/sources.list.d/debian.sources; \
    fi; \
    if [ -f /etc/apt/sources.list ]; then \
        sed -i "s@deb.debian.org@${MIRROR}@g" /etc/apt/sources.list; \
        sed -i "s@security.debian.org@${MIRROR}@g" /etc/apt/sources.list; \
    fi; \
    printf 'Acquire::Retries "10";\nAcquire::http::Timeout "120";\nAcquire::https::Timeout "120";\nAcquire::ForceIPv4 "true";\n' > /etc/apt/apt.conf.d/99timeout.conf

# Dépendances système pour WeasyPrint / PDF
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential gcc g++ libffi-dev \
        libpango-1.0-0 libpangoft2-1.0-0 libpangocairo-1.0-0 \
        libcairo2 libgdk-pixbuf-2.0-0 libharfbuzz0b libfribidi0 \
        shared-mime-info fonts-dejavu fonts-liberation \
        sqlite3 libsqlite3-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN python -m venv /opt/venv && \
    /opt/venv/bin/pip install --no-cache-dir --upgrade pip setuptools wheel && \
    /opt/venv/bin/pip install --no-cache-dir -r requirements.txt

# ==================== STAGE 2 : RUNTIME ====================
FROM python:3.11-slim-bookworm AS runtime

ARG MIRROR=debian.mirrors.ovh.net

RUN set -eux; \
    if [ -f /etc/apt/sources.list.d/debian.sources ]; then \
        sed -i "s@deb.debian.org@${MIRROR}@g" /etc/apt/sources.list.d/debian.sources; \
        sed -i "s@security.debian.org@${MIRROR}@g" /etc/apt/sources.list.d/debian.sources; \
    fi; \
    if [ -f /etc/apt/sources.list ]; then \
        sed -i "s@deb.debian.org@${MIRROR}@g" /etc/apt/sources.list; \
        sed -i "s@security.debian.org@${MIRROR}@g" /etc/apt/sources.list; \
    fi; \
    printf 'Acquire::Retries "10";\nAcquire::http::Timeout "120";\nAcquire::https::Timeout "120";\nAcquire::ForceIPv4 "true";\n' > /etc/apt/apt.conf.d/99timeout.conf

RUN apt-get update && apt-get install -y --no-install-recommends \
        libpango-1.0-0 libpangoft2-1.0-0 libpangocairo-1.0-0 \
        libcairo2 libgdk-pixbuf-2.0-0 libharfbuzz0b libfribidi0 \
        shared-mime-info fonts-dejavu fonts-liberation \
        sqlite3 curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    LC_ALL=C.UTF-8

WORKDIR /app
COPY . /app/
RUN mkdir -p /app/data && chmod 755 /app/data
RUN if [ -f /app/entrypoint.sh ]; then chmod +x /app/entrypoint.sh; fi

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

ENTRYPOINT ["/bin/bash", "/app/entrypoint.sh"]
