FROM python:3.10-slim

WORKDIR /app

# Dépendances système : SQLite + WeasyPrint (PDF) + polices
RUN apt-get update && apt-get install -y --no-install-recommends \
    sqlite3 \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libcairo2 \
    libgdk-pixbuf-2.0-0 \
    libffi-dev \
    shared-mime-info \
    fonts-dejavu \
    && rm -rf /var/lib/apt/lists/*

# Dépendances Python
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt --timeout 100 --retries 5

# Code applicatif
COPY main.py .
COPY init_db.py .
COPY init_db_v2.py .
COPY auth.py .
COPY pdf_generator.py .
COPY entrypoint.sh .

RUN chmod +x /app/entrypoint.sh && mkdir -p /app/data

EXPOSE 8000

CMD ["/app/entrypoint.sh"]
