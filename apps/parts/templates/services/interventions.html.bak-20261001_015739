{% extends "base.html" %}
{% block title %}Interventions{% endblock %}
{% block page_title %}Interventions{% endblock %}
{% block content %}

<div class="row g-3 mb-4">
  <div class="col-md-3"><div class="kpi-card"><div class="icon bg-primary-grad"><i class="bi bi-tools"></i></div><div><div class="kpi-val">{{ kpi.total }}</div><div class="kpi-lbl">Total</div></div></div></div>
  <div class="col-md-3"><div class="kpi-card"><div class="icon bg-gold-grad"><i class="bi bi-hourglass"></i></div><div><div class="kpi-val">{{ kpi.en_attente }}</div><div class="kpi-lbl">En attente</div></div></div></div>
  <div class="col-md-3"><div class="kpi-card"><div class="icon bg-accent-grad"><i class="bi bi-play-circle"></i></div><div><div class="kpi-val">{{ kpi.en_cours }}</div><div class="kpi-lbl">En cours</div></div></div></div>
  <div class="col-md-3"><div class="kpi-card"><div class="icon bg-success-grad"><i class="bi bi-check-circle"></i></div><div><div class="kpi-val">{{ kpi.terminees }}</div><div class="kpi-lbl">Terminées</div></div></div></div>
</div>

<div class="card-premium">
  <h5>Interventions</h5>
  <div class="table-responsive">
    <table class="table table-omega">
      <thead><tr><th>N°</th><th>Véhicule</th><th>Client</th><th>Service</th><th class="text-end">Montant</th><th>Statut</th></tr></thead>
      <tbody>
        {% for i in interventions %}
        <tr>
          <td><code style="font-size:11px">{{ i.numero }}</code></td>
          <td>{{ i.immatriculation or '-' }}</td>
          <td>{{ i.client_prenom or '' }} {{ i.client_nom or '-' }}</td>
          <td>{{ i.service_icone or '' }} {{ i.service_nom or '-' }}</td>
          <td class="text-end fw-bold">{{ i.prix_total|money }}</td>
          <td><span class="badge-statut badge-{{ i.statut }}">{{ i.statut }}</span></td>
        </tr>
        {% else %}
        <tr><td colspan="6" class="text-center text-muted py-4">Aucune intervention</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

{% endblock %}
