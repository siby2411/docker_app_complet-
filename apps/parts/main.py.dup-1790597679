def devis_convertir(did):
    """Convertit un devis en vente"""
    d = query("SELECT * FROM devis WHERE id=?", (did,), one=True)
    if not d:
        abort(404)

    if d['statut'] == 'accepte':
        flash("Devis déjà converti.", "error")
        return redirect(url_for('devis_detail', did=did))

    lignes = query("SELECT * FROM devis_lignes WHERE devis_id=?", (did,))
    if not lignes:
        flash("❌ Devis vide.", "error")
        return redirect(url_for('devis_detail', did=did))

    # Créer la vente
    numero = gen_numero_vente()
    montant_ttc = d['montant_total']

    vente_id = execute("""
        INSERT INTO ventes (numero, client_id, point_vente_id, user_id,
            type_vente, date_vente, sous_total, remise_pct, remise_montant,
            tva, montant_ttc, mode_paiement, montant_paye, monnaie,
            statut, notes, created_at)
        VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)
    """, (numero, d['client_id'], d['point_vente_id'], current_user.id,
          'detail', datetime.now().strftime('%Y-%m-%d'),
          montant_ttc, 0, 0, 0, montant_ttc, 'especes', 0, 0,
          'complete', f'Converti depuis devis {d["numero"]}',
          datetime.now().isoformat()))

    # Copier les lignes
    for l in lignes:
        execute("""
            INSERT INTO ventes_lignes (vente_id, piece_id, quantite, prix_unitaire, montant)
            VALUES (?,?,?,?,?)
        """, (vente_id, l['piece_id'], l['quantite'], l['prix_unitaire'], l['montant']))

        # Décrémenter stock
        stock = query("SELECT * FROM stock WHERE piece_id=? AND point_vente_id=?",
                      (l['piece_id'], d['point_vente_id']), one=True)
        if stock:
            execute("UPDATE stock SET quantite = MAX(0, quantite - ?) WHERE id=?",
                    (l['quantite'], stock['id']))

    # Marquer devis comme accepté
    execute("UPDATE devis SET statut='accepte' WHERE id=?", (did,))

    audit('convert', 'devis', did, f'vente_id={vente_id}')
    flash(f"✅ Devis converti en vente {numero}.", "success")
    return redirect(url_for('vente_detail', vid=vente_id))

