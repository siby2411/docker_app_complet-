@app.route('/')
@login_required
def dashboard():
    kpi = {}

    # ─── Stock ───
    kpi['pieces_total'] = query("SELECT COUNT(*) c FROM pieces", one=True)['c']
    kpi['pieces_dispo'] = query("SELECT COUNT(*) c FROM pieces WHERE statut='disponible'", one=True)['c']

    kpi['stock_total_units'] = query("SELECT COALESCE(SUM(quantite), 0) c FROM stock", one=True)['c']

    kpi['stock_valeur_achat'] = query("""
        SELECT COALESCE(SUM(s.quantite * p.prix_achat), 0) c
        FROM stock s JOIN pieces p ON p.id = s.piece_id
    """, one=True)['c']

    kpi['stock_valeur_vente'] = query("""
        SELECT COALESCE(SUM(s.quantite * p.prix_vente_detail), 0) c
        FROM stock s JOIN pieces p ON p.id = s.piece_id
    """, one=True)['c']

    kpi['marge_potentielle'] = kpi['stock_valeur_vente'] - kpi['stock_valeur_achat']

    # ─── Alertes stock ───
    kpi['stock_alertes'] = query("""
        SELECT COUNT(*) c FROM (
            SELECT p.id, COALESCE(SUM(s.quantite), 0) AS qte, p.stock_alerte
            FROM pieces p
            LEFT JOIN stock s ON s.piece_id = p.id
            GROUP BY p.id
            HAVING qte <= p.stock_alerte
        )
    """, one=True)['c']

    kpi['stock_rupture'] = query("""
        SELECT COUNT(*) c FROM (
            SELECT p.id, COALESCE(SUM(s.quantite), 0) AS qte
            FROM pieces p
            LEFT JOIN stock s ON s.piece_id = p.id
            GROUP BY p.id
            HAVING qte = 0
        )
    """, one=True)['c']

    # ─── Ventes ───
    kpi['ventes_jour'] = query("""
        SELECT COUNT(*) c FROM ventes
        WHERE statut='complete' AND date(date_vente) = date('now')
    """, one=True)['c']

    kpi['ca_jour'] = query("""
        SELECT COALESCE(SUM(montant_ttc), 0) c FROM ventes
        WHERE statut='complete' AND date(date_vente) = date('now')
    """, one=True)['c']

    kpi['ventes_mois'] = query("""
        SELECT COUNT(*) c FROM ventes
        WHERE statut='complete' AND strftime('%Y-%m', date_vente) = strftime('%Y-%m','now')
    """, one=True)['c']

    kpi['ca_mois'] = query("""
        SELECT COALESCE(SUM(montant_ttc), 0) c FROM ventes
        WHERE statut='complete' AND strftime('%Y-%m', date_vente) = strftime('%Y-%m','now')
    """, one=True)['c']

    kpi['panier_moyen'] = round(kpi['ca_mois'] / kpi['ventes_mois'], 0) if kpi['ventes_mois'] else 0

    # ─── Clients ───
    kpi['clients_total'] = query("SELECT COUNT(*) c FROM clients", one=True)['c']
    kpi['clients_actifs'] = query("SELECT COUNT(*) c FROM clients WHERE statut='actif'", one=True)['c']

    # ─── Fournisseurs / Commandes ───
    kpi['commandes_en_cours'] = query("""
        SELECT COUNT(*) c FROM commandes_fournisseurs
        WHERE statut IN ('en_attente','confirmee','partielle')
    """, one=True)['c']

    # ─── Top catégories (par CA du mois) ───
    top_categories = query("""
        SELECT c.nom AS categorie, c.icone,
               COUNT(DISTINCT p.id) AS nb_pieces,
               COALESCE(SUM(vl.quantite), 0) AS qte_vendue,
               COALESCE(SUM(vl.montant), 0) AS ca
        FROM categories c
        JOIN pieces p ON p.categorie_id = c.id
        LEFT JOIN ventes_lignes vl ON vl.piece_id = p.id
        LEFT JOIN ventes v ON v.id = vl.vente_id
            AND v.statut='complete'
            AND strftime('%Y-%m', v.date_vente) = strftime('%Y-%m','now')
        GROUP BY c.id
        HAVING ca > 0
        ORDER BY ca DESC LIMIT 6
    """)

    # ─── Top pièces vendues ───
    top_pieces = query("""
        SELECT p.id, p.sku, p.nom, p.code_oem,
               COALESCE(SUM(vl.quantite), 0) AS qte_vendue,
               COALESCE(SUM(vl.montant), 0) AS ca
        FROM pieces p
        JOIN ventes_lignes vl ON vl.piece_id = p.id
        JOIN ventes v ON v.id = vl.vente_id
        WHERE v.statut='complete'
          AND date(v.date_vente) >= date('now','-30 days')
        GROUP BY p.id
        ORDER BY qte_vendue DESC LIMIT 10
    """)

    # ─── Alertes stock (liste) ───
    alertes_stock = query("""
        SELECT p.id, p.sku, p.nom, p.code_oem, p.stock_alerte, p.stock_min,
               COALESCE(SUM(s.quantite), 0) AS stock_total,
               c.nom AS categorie_nom, c.icone AS categorie_icone,
               p.prix_achat
        FROM pieces p
        LEFT JOIN stock s ON s.piece_id = p.id
        LEFT JOIN categories c ON c.id = p.categorie_id
        GROUP BY p.id
        HAVING stock_total <= p.stock_alerte
        ORDER BY (stock_total * 1.0 / NULLIF(p.stock_alerte, 0)) ASC, stock_total ASC
        LIMIT 15
    """)

    # ─── Ventes 7 derniers jours (graphique) ───
    ventes_7j = query("""
        SELECT date(date_vente) AS jour,
               COUNT(*) AS nb,
               COALESCE(SUM(montant_ttc), 0) AS ca
        FROM ventes
        WHERE statut='complete'
          AND date(date_vente) >= date('now', '-6 days')
        GROUP BY jour
        ORDER BY jour
    """)

    # ─── Dernières ventes ───
    dernieres_ventes = query("""
        SELECT v.*, c.nom AS client_nom, c.prenom AS client_prenom,
               u.nom_complet AS vendeur_nom,
               pv.nom AS point_vente_nom
        FROM ventes v
        LEFT JOIN clients c ON c.id = v.client_id
        LEFT JOIN users u ON u.id = v.user_id
        LEFT JOIN points_vente pv ON pv.id = v.point_vente_id
        ORDER BY v.id DESC LIMIT 8
    """)

    # ─── Ventes par point de vente (ce mois) ───
    ventes_par_pv = query("""
        SELECT pv.nom, pv.ville,
               COUNT(v.id) AS nb,
               COALESCE(SUM(v.montant_ttc), 0) AS ca
        FROM points_vente pv
        LEFT JOIN ventes v ON v.point_vente_id = pv.id
            AND v.statut='complete'
            AND strftime('%Y-%m', v.date_vente) = strftime('%Y-%m','now')
        GROUP BY pv.id
        ORDER BY ca DESC
    """)

    # ─── Ventes par mode de paiement ───
    ventes_par_mode = query("""
        SELECT mode_paiement,
               COUNT(*) AS nb,
               COALESCE(SUM(montant_ttc), 0) AS ca
        FROM ventes
        WHERE statut='complete'
          AND strftime('%Y-%m', date_vente) = strftime('%Y-%m','now')
        GROUP BY mode_paiement
        ORDER BY ca DESC
    """)

    # ─── Évolution mensuelle (6 mois) ───
    evolution_mois = query("""
        SELECT strftime('%Y-%m', date_vente) AS mois,
               COUNT(*) AS nb,
               COALESCE(SUM(montant_ttc), 0) AS ca
        FROM ventes
        WHERE statut='complete'
          AND date(date_vente) >= date('now', '-6 months')
        GROUP BY mois
        ORDER BY mois
    """)

    return render_template('dashboard.html',
                           kpi=kpi,
                           top_categories=top_categories,
                           top_pieces=top_pieces,
                           alertes_stock=alertes_stock,
                           ventes_7j=ventes_7j,
                           dernieres_ventes=dernieres_ventes,
                           ventes_par_pv=ventes_par_pv,
                           ventes_par_mode=ventes_par_mode,
                           evolution_mois=evolution_mois)

