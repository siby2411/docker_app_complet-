               (SELECT COALESCE(SUM(quantite), 0) FROM stock s WHERE s.piece_id=p.id) AS stock_total
        FROM pieces p
        LEFT JOIN categories c ON c.id = p.categorie_id
        WHERE p.statut='disponible'
        GROUP BY p.id
        HAVING stock_total = 0
        ORDER BY p.stock_alerte DESC, p.nom
    """)

    alerte = query("""
        SELECT p.*, c.nom AS categorie_nom, c.icone AS categorie_icone,
               (SELECT COALESCE(SUM(quantite), 0) FROM stock s WHERE s.piece_id=p.id) AS stock_total
        FROM pieces p
        LEFT JOIN categories c ON c.id = p.categorie_id
        WHERE p.statut='disponible'
        GROUP BY p.id
        HAVING stock_total > 0 AND stock_total <= p.stock_alerte
        ORDER BY (stock_total * 1.0 / NULLIF(p.stock_alerte, 0)) ASC
    """)

    return render_template('stock/alertes.html', rupture=rupture, alerte=alerte)

