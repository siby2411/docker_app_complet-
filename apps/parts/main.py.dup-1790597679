    nouveau_statut = request.form.get('statut', '').strip()
    statuts_valides = ('en_attente', 'confirmee', 'partielle', 'recue', 'annulee')

    if nouveau_statut not in statuts_valides:
        flash("❌ Statut invalide.", "error")
        return redirect(url_for('commande_detail', cid=cid))

    execute("UPDATE commandes_fournisseurs SET statut=? WHERE id=?", (nouveau_statut, cid))

    # Si réception, augmenter le stock
    if nouveau_statut == 'recue':
        c = query("SELECT * FROM commandes_fournisseurs WHERE id=?", (cid,), one=True)
        lignes = query("SELECT * FROM commandes_fournisseurs_lignes WHERE commande_id=?", (cid,))

        for l in lignes:
            # Augmenter stock
            stock = query("SELECT * FROM stock WHERE piece_id=? AND point_vente_id=?",
                          (l['piece_id'], c['point_vente_id']), one=True)

            if stock:
                qte_avant = stock['quantite'] or 0
                qte_apres = qte_avant + l['quantite']
                execute("UPDATE stock SET quantite=?, updated_at=? WHERE id=?",
                        (qte_apres, datetime.now().isoformat(), stock['id']))

                execute("""
                    INSERT INTO stock_mouvements (piece_id, point_vente_id, type, quantite,
                        quantite_avant, quantite_apres, motif, reference, user_id, created_at)
                    VALUES (?,?,?,?,?,?,?,?,?,?)
                """, (l['piece_id'], c['point_vente_id'], 'entree', l['quantite'],
                      qte_avant, qte_apres, f'Réception commande', c['numero'],
                      current_user.id, datetime.now().isoformat()))
            else:
                execute("""
                    INSERT INTO stock (piece_id, point_vente_id, quantite, updated_at)
                    VALUES (?,?,?,?)
                """, (l['piece_id'], c['point_vente_id'], l['quantite'], datetime.now().isoformat()))

            # MAJ quantite_recue
            execute("UPDATE commandes_fournisseurs_lignes SET quantite_recue=quantite WHERE id=?",
                    (l['id'],))

        # Date de réception
        execute("UPDATE commandes_fournisseurs SET date_reception=? WHERE id=?",
                (datetime.now().strftime('%Y-%m-%d'), cid))

        flash(f"✅ Commande reçue — stock mis à jour.", "success")
    else:
        flash(f"✅ Statut mis à jour : {nouveau_statut}.", "success")

    audit('statut_commande', 'commande', cid, nouveau_statut)
    return redirect(url_for('commande_detail', cid=cid))

