        'valeur_vente': query("SELECT COALESCE(SUM(s.quantite * p.prix_vente_detail), 0) c FROM stock s JOIN pieces p ON p.id=s.piece_id", one=True)['c'],
        'total_unites': query("SELECT COALESCE(SUM(quantite), 0) c FROM stock", one=True)['c'],
        'total_refs': query("SELECT COUNT(*) c FROM pieces WHERE statut='disponible'", one=True)['c'],
        'ruptures': query("SELECT COUNT(*) c FROM (SELECT p.id FROM pieces p LEFT JOIN stock s ON s.piece_id=p.id GROUP BY p.id HAVING COALESCE(SUM(s.quantite), 0) = 0)", one=True)['c'],
        'alertes': query("SELECT COUNT(*) c FROM (SELECT p.id FROM pieces p LEFT JOIN stock s ON s.piece_id=p.id GROUP BY p.id HAVING COALESCE(SUM(s.quantite), 0) > 0 AND COALESCE(SUM(s.quantite), 0) <= p.stock_alerte)", one=True)['c'],
    }
