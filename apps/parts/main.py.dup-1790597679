def gen_sku_piece():
    """Génère un SKU unique"""
    today = datetime.now().strftime('%Y%m')
    row = query("SELECT sku FROM pieces WHERE sku LIKE ? ORDER BY id DESC LIMIT 1",
                (f'PCS-{today}-%',), one=True)
    if row and row['sku']:
        try:
            n = int(row['sku'].split('-')[-1]) + 1
        except Exception:
            n = 1
    else:
        n = 1
    return f"PCS-{today}-{n:05d}"

def get_stock_total(piece_id):
    """Retourne le stock total d'une pièce tous PDV confondus"""
    r = query("SELECT COALESCE(SUM(quantite), 0) c FROM stock WHERE piece_id=?",
              (piece_id,), one=True)
    return r['c'] if r else 0

def get_categorie_arborescence():
    """Retourne les catégories hiérarchisées"""
    roots = query("SELECT * FROM categories WHERE parent_id IS NULL ORDER BY ordre, nom")
    result = []
    for r in roots:
        r_dict = dict(r)
        r_dict['enfants'] = query("SELECT * FROM categories WHERE parent_id=? ORDER BY ordre, nom",
                                   (r['id'],))
        result.append(r_dict)
    return result

