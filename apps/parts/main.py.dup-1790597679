@app.route('/stock')
@login_required
def stock_list():
    q = request.args.get('q', '').strip()
    categorie_id = request.args.get('categorie_id', type=int)
    point_vente_id = request.args.get('point_vente_id', type=int)
    situation = request.args.get('situation', '').strip()  # rupture, alerte, ok
    page = max(1, request.args.get('page', 1, type=int))
    per_page = 40

    where = " WHERE 1=1"
    params = []
    if q:
        where += " AND (p.nom LIKE ? OR p.sku LIKE ? OR p.code_oem LIKE ?)"
        params += [f'%{q}%'] * 3
    if categorie_id:
        where += " AND p.categorie_id=?"; params.append(categorie_id)

    # Sous-requête stock total + par PDV
    if point_vente_id:
        stock_expr = f"(SELECT COALESCE(quantite, 0) FROM stock s WHERE s.piece_id=p.id AND s.point_vente_id={point_vente_id})"
    else:
        stock_expr = "(SELECT COALESCE(SUM(quantite), 0) FROM stock s WHERE s.piece_id=p.id)"

    sql = f"""
        SELECT p.*,
               c.nom AS categorie_nom, c.icone AS categorie_icone,
               {stock_expr} AS stock_total
        FROM pieces p
        LEFT JOIN categories c ON c.id = p.categorie_id
        {where}
    """

    # Filtre situation
    if situation == 'rupture':
        sql += f" AND {stock_expr} = 0"
    elif situation == 'alerte':
        sql += f" AND {stock_expr} > 0 AND {stock_expr} <= p.stock_alerte"
    elif situation == 'ok':
        sql += f" AND {stock_expr} > p.stock_alerte"

    # Total
    total_q = query(f"SELECT COUNT(*) c FROM ({sql})", params, one=True)['c']

    # Pagination
    offset = (page - 1) * per_page
    sql += f" ORDER BY stock_total ASC, p.nom LIMIT {per_page} OFFSET {offset}"
    pieces = query(sql, params)

    categories = query("SELECT * FROM categories WHERE parent_id IS NOT NULL ORDER BY nom")
    points_vente = query("SELECT * FROM points_vente WHERE actif=1 ORDER BY nom")

    # KPI
    kpi = {
        'total_pieces': query("SELECT COUNT(*) c FROM pieces WHERE statut='disponible'", one=True)['c'],
        'valeur_achat': query("""
            SELECT COALESCE(SUM(s.quantite * p.prix_achat), 0) c
            FROM stock s JOIN pieces p ON p.id=s.piece_id
        """, one=True)['c'],
        'valeur_vente': query("""
            SELECT COALESCE(SUM(s.quantite * p.prix_vente_detail), 0) c
            FROM stock s JOIN pieces p ON p.id=s.piece_id
        """, one=True)['c'],
        'ruptures': query("""
            SELECT COUNT(*) c FROM (
                SELECT p.id FROM pieces p
                LEFT JOIN stock s ON s.piece_id=p.id
                GROUP BY p.id HAVING COALESCE(SUM(s.quantite), 0) = 0
            )
        """, one=True)['c'],
        'alertes': query("""
            SELECT COUNT(*) c FROM (
                SELECT p.id, COALESCE(SUM(s.quantite), 0) AS qte, p.stock_alerte
                FROM pieces p LEFT JOIN stock s ON s.piece_id=p.id
                GROUP BY p.id HAVING qte > 0 AND qte <= p.stock_alerte
            )
        """, one=True)['c'],
    }

    pages = (total_q + per_page - 1) // per_page

    return render_template('stock/list.html', pieces=pieces, categories=categories,
                           points_vente=points_vente, kpi=kpi,
                           q=q, categorie_id=categorie_id, point_vente_id=point_vente_id,
                           situation=situation, page=page, pages=pages, total=total_q)

@app.route('/stock/alertes')
@login_required
