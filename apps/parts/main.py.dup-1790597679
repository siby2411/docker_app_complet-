@app.route('/pos/api/checkout', methods=['POST'])
@login_required
@vendeur_required
def pos_checkout():
    """Enregistre une vente depuis le POS"""
    data = request.get_json() or {}

    pdv_id = int(data.get('pdv_id') or 0)
    client_id = int(data.get('client_id') or 0) or None
    type_vente = data.get('type_vente', 'detail')
    lignes = data.get('lignes', [])
    remise_pct = float(data.get('remise_pct') or 0)
    montant_paye = float(data.get('montant_paye') or 0)
    mode_paiement = data.get('mode_paiement', 'especes')
    notes = data.get('notes', '')

    if not pdv_id:
        return jsonify(success=False, error="Point de vente obligatoire"), 400
    if not lignes:
        return jsonify(success=False, error="Panier vide"), 400

    # Calculer les totaux
    sous_total = 0
    for l in lignes:
        sous_total += float(l.get('montant', 0))

    remise_montant = sous_total * (remise_pct / 100)
    sous_total_apres_remise = sous_total - remise_montant

    # TVA moyenne (calculée au prorata)
    tva = 0
    for l in lignes:
        piece = query("SELECT tva_pct FROM pieces WHERE id=?", (l['piece_id'],), one=True)
        if piece:
            tva_pct = piece['tva_pct'] or 18
            montant_ligne = float(l.get('montant', 0))
            montant_apres = montant_ligne * (1 - remise_pct/100)
            tva += montant_apres * (tva_pct / 118)  # TVA déjà incluse

    montant_ttc = sous_total_apres_remise
    monnaie = max(0, montant_paye - montant_ttc)

    # Créer la vente
    numero = gen_numero_vente()
    vente_id = execute("""
        INSERT INTO ventes (numero, client_id, point_vente_id, user_id,
            type_vente, date_vente, sous_total, remise_pct, remise_montant,
            tva, montant_ttc, mode_paiement, montant_paye, monnaie,
            statut, notes, created_at)
        VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)
    """, (numero, client_id, pdv_id, current_user.id,
          type_vente, datetime.now().strftime('%Y-%m-%d'),
          sous_total, remise_pct, remise_montant,
          round(tva, 0), montant_ttc, mode_paiement, montant_paye, monnaie,
          'complete', notes, datetime.now().isoformat()))

    # Lignes + maj stock
    for l in lignes:
        piece_id = int(l['piece_id'])
        quantite = int(l['quantite'])
        prix_unitaire = float(l['prix_unitaire'])
        montant_ligne = float(l['montant'])

        execute("""
            INSERT INTO ventes_lignes (vente_id, piece_id, quantite, prix_unitaire,
                remise_pct, montant)
            VALUES (?,?,?,?,?,?)
        """, (vente_id, piece_id, quantite, prix_unitaire, remise_pct, montant_ligne))

        # Décrémenter stock
        stock = query("SELECT * FROM stock WHERE piece_id=? AND point_vente_id=?",
                      (piece_id, pdv_id), one=True)
        if stock:
            qte_avant = stock['quantite'] or 0
            qte_apres = max(0, qte_avant - quantite)
            execute("UPDATE stock SET quantite=?, updated_at=? WHERE id=?",
                    (qte_apres, datetime.now().isoformat(), stock['id']))

            # Log mouvement
            execute("""
                INSERT INTO stock_mouvements (piece_id, point_vente_id, type, quantite,
                    quantite_avant, quantite_apres, motif, reference, user_id, created_at)
                VALUES (?,?,?,?,?,?,?,?,?,?)
            """, (piece_id, pdv_id, 'sortie', -quantite,
                  qte_avant, qte_apres, f'Vente {numero}', numero,
                  current_user.id, datetime.now().isoformat()))

    # Enregistrer paiement
    if montant_paye > 0:
        execute("""
            INSERT INTO paiements (vente_id, client_id, montant, mode, statut,
                date_paiement, created_at)
            VALUES (?,?,?,?,?,?,?)
        """, (vente_id, client_id, montant_paye, mode_paiement, 'valide',
              datetime.now().strftime('%Y-%m-%d'), datetime.now().isoformat()))

    # Mise à jour stats client
    if client_id:
        execute("""
            UPDATE clients SET
                nb_achats = nb_achats + 1,
                total_achats = total_achats + ?,
                derniere_visite = ?
            WHERE id=?
        """, (montant_ttc, datetime.now().isoformat(), client_id))

    audit('create', 'vente', vente_id, f'{numero} · {montant_ttc}')
    return jsonify(success=True, vente_id=vente_id, numero=numero)

