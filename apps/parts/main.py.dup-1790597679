class User(UserMixin):
    def __init__(self, row):
        self.id = row['id']
        self.username = row['username']
        self.role = row['role']
        self.nom_complet = row['nom_complet'] or row['username']
        self.email = row['email']
        self.telephone = row['telephone']
        self.point_vente = row['point_vente']

    def is_admin(self):
        return self.role == 'admin'

    def is_gerant(self):
        return self.role in ('admin', 'gerant')

    def is_vendeur(self):
        return self.role in ('admin', 'gerant', 'vendeur', 'caissier')

    def can_sell(self):
        return self.role in ('admin', 'gerant', 'vendeur', 'caissier')

    def can_manage_stock(self):
        return self.role in ('admin', 'gerant')

@login_manager.user_loader
