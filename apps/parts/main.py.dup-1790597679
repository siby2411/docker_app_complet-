@app.route('/ventes')
@login_required
def ventes_list():
    q = request.args.get('q', '').strip()
    statut = request.args.get('statut', '').strip()
    mode = request.args.get('mode', '').strip()
    date_from = request.args.get('date_from', '').strip()
    date_to = request.args.get('date_to', '').strip()
    vendeur_id = request.args.get('vendeur_id', type=int)
    page = max(1, request.args.get('page', 1, type=int))
    per_page = 30

    where = " WHERE 1=1"
    params = []
    if q:
        where += " AND (v.numero LIKE ? OR c.nom LIKE ? OR c.prenom LIKE ? OR c.telephone LIKE ?)"
        params += [f'%{q}%'] * 4
    if statut:
        where += " AND v.statut=?"; params.append(statut)
    if mode:
        where += " AND v.mode_paiement=?"; params.append(mode)
    if date_from:
        where += " AND date(v.date_vente) >= date(?)"; params.append(date_from)
    if date_to:
        where += " AND date(v.date_vente) <= date(?)"; params.append(date_to)
    if vendeur_id:
        where += " AND v.user_id=?"; params.append(vendeur_id)

    total = query(f"""
        SELECT COUNT(*) c FROM ventes v
        LEFT JOIN clients c ON c.id = v.client_id
        {where}
    """, params, one=True)['c']

    offset = (page - 1) * per_page
    ventes = query(f"""
        SELECT v.*, c.nom AS client_nom, c.prenom AS client_prenom,
               c.telephone AS client_tel,
               u.nom_complet AS vendeur_nom,
               pv.nom AS pdv_nom,
               (SELECT COUNT(*) FROM ventes_lignes WHERE vente_id=v.id) AS nb_lignes
        FROM ventes v
        LEFT JOIN clients c ON c.id = v.client_id
        LEFT JOIN users u ON u.id = v.user_id
        LEFT JOIN points_vente pv ON pv.id = v.point_vente_id
        {where}
        ORDER BY v.id DESC LIMIT ? OFFSET ?
    """, params + [per_page, offset])

    # KPI
    kpi = {
        'total': total,
        'aujourdhui': query("""
            SELECT COUNT(*) c FROM ventes WHERE statut='complete' AND date(date_vente)=date('now')
        """, one=True)['c'],
        'ca_aujourdhui': query("""
            SELECT COALESCE(SUM(montant_ttc), 0) c FROM ventes
            WHERE statut='complete' AND date(date_vente)=date('now')
        """, one=True)['c'],
        'ca_periode': query(f"""
            SELECT COALESCE(SUM(v.montant_ttc), 0) c FROM ventes v
            LEFT JOIN clients c ON c.id = v.client_id
            {where} AND v.statut='complete'
        """, params, one=True)['c'],
        'nb_periode': query(f"""
            SELECT COUNT(*) c FROM ventes v
            LEFT JOIN clients c ON c.id = v.client_id
            {where} AND v.statut='complete'
        """, params, one=True)['c'],
    }

    vendeurs = query("""
        SELECT DISTINCT u.id, u.nom_complet FROM users u
        WHERE u.actif=1 ORDER BY u.nom_complet
    """)

    pages = (total + per_page - 1) // per_page

    return render_template('ventes/list.html', ventes=ventes, kpi=kpi,
                           vendeurs=vendeurs,
                           q=q, statut=statut, mode=mode,
                           date_from=date_from, date_to=date_to,
                           vendeur_id=vendeur_id,
                           page=page, pages=pages)

