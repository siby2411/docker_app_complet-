@app.route('/pos/api/stats-live')
@login_required
def pos_api_stats_live():
    """API JSON pour le dashboard temps réel"""

    # KPI du jour
    today = datetime.now().strftime('%Y-%m-%d')

    kpi = query("""
        SELECT
            COUNT(*) AS nb_ventes,
            COALESCE(SUM(montant_ttc), 0) AS ca,
            COALESCE(SUM(sous_total), 0) AS sous_total
        FROM ventes
        WHERE statut='complete' AND date(date_vente) = date(?)
    """, (today,), one=True)

    nb_ventes = kpi['nb_ventes'] or 0
    ca_jour = kpi['ca'] or 0

    panier_moyen = round(ca_jour / nb_ventes, 0) if nb_ventes else 0

    # Pièces vendues
    pieces_vendues = query("""
        SELECT COALESCE(SUM(vl.quantite), 0) AS qte
        FROM ventes_lignes vl
        JOIN ventes v ON v.id = vl.vente_id
        WHERE v.statut='complete' AND date(v.date_vente) = date(?)
    """, (today,), one=True)['qte'] or 0

    # Évolution horaire (24h)
    hourly = query("""
        SELECT strftime('%H', created_at) AS heure,
               COUNT(*) AS nb,
               COALESCE(SUM(montant_ttc), 0) AS ca
        FROM ventes
        WHERE statut='complete' AND date(date_vente) = date(?)
        GROUP BY heure
        ORDER BY heure
    """, (today,))

    # Compléter les heures manquantes (0-23)
    hourly_map = {h['heure']: dict(h) for h in hourly}
    full_hourly = []
    for h in range(24):
        h_str = f"{h:02d}"
        if h_str in hourly_map:
            full_hourly.append({
                'heure': h_str,
                'nb': hourly_map[h_str]['nb'],
                'ca': hourly_map[h_str]['ca']
            })
        else:
            full_hourly.append({'heure': h_str, 'nb': 0, 'ca': 0})

    # Modes de paiement
    modes = query("""
        SELECT mode_paiement AS mode, COUNT(*) AS nb,
               COALESCE(SUM(montant_ttc), 0) AS ca
        FROM ventes
        WHERE statut='complete' AND date(date_vente) = date(?)
        GROUP BY mode_paiement
    """, (today,))

    # Top 10 pièces
    top_pieces = query("""
        SELECT p.nom, p.sku,
               SUM(vl.quantite) AS qte,
               SUM(vl.montant) AS ca
        FROM ventes_lignes vl
        JOIN ventes v ON v.id = vl.vente_id
        JOIN pieces p ON p.id = vl.piece_id
        WHERE v.statut='complete' AND date(v.date_vente) = date(?)
        GROUP BY p.id
        ORDER BY qte DESC
        LIMIT 10
    """, (today,))

    # Top vendeurs
    top_vendeurs = query("""
        SELECT COALESCE(u.nom_complet, 'Inconnu') AS nom,
               COUNT(v.id) AS nb,
               COALESCE(SUM(v.montant_ttc), 0) AS ca
        FROM ventes v
        LEFT JOIN users u ON u.id = v.user_id
        WHERE v.statut='complete' AND date(v.date_vente) = date(?)
        GROUP BY v.user_id
        ORDER BY ca DESC
        LIMIT 5
    """, (today,))

    return jsonify({
        'ca_jour': ca_jour,
        'nb_ventes_jour': nb_ventes,
        'panier_moyen': panier_moyen,
        'pieces_vendues': pieces_vendues,
        'hourly': full_hourly,
        'modes': [dict(m) for m in modes],
        'top_pieces': [dict(p) for p in top_pieces],
        'top_vendeurs': [dict(v) for v in top_vendeurs],
    })




