def get_conn():
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA foreign_keys = ON")
    return conn

def query(sql, params=(), one=False):
    conn = get_conn()
    cur = conn.cursor()
    cur.execute(sql, params)
    rows = cur.fetchall()
    conn.close()
    if one:
        return rows[0] if rows else None
    return rows

def execute(sql, params=()):
    conn = get_conn()
    cur = conn.cursor()
    cur.execute(sql, params)
    conn.commit()
    last_id = cur.lastrowid
    conn.close()
    return last_id

def execute_many(sql, params_list):
    conn = get_conn()
    cur = conn.cursor()
    cur.executemany(sql, params_list)
    conn.commit()
    conn.close()

def audit(action, entity=None, entity_id=None, details=None):
    try:
        execute("""
            INSERT INTO audit_log (user_id, action, entity, entity_id, details, ip, created_at)
            VALUES (?,?,?,?,?,?,?)
        """, (
            getattr(current_user, 'id', None) if current_user and current_user.is_authenticated else None,
            action, entity, entity_id, details,
            request.remote_addr if request else None,
            datetime.now().isoformat()
        ))
    except Exception:
        pass

def allowed_file(filename, allowed):
    return '.' in filename and filename.rsplit('.', 1)[1].lower() in allowed

def save_upload(file, subdir, allowed=ALLOWED_IMG):
    if not file or file.filename == '':
        return None
    if not allowed_file(file.filename, allowed):
        return None
    ext = file.filename.rsplit('.', 1)[1].lower()
    fname = f"{uuid.uuid4().hex}.{ext}"
    path = os.path.join(subdir, fname)
    file.save(path)
    return fname

def fmt_money(v):
    try:
        v = float(v or 0)
    except Exception:
        return "0 FCFA"
    return f"{int(v):,}".replace(',', ' ') + " FCFA"

def fmt_money_short(v):
    try:
        v = float(v or 0)
    except Exception:
        return "0"
    if v >= 1_000_000:
        return f"{v/1_000_000:.1f}M"
    elif v >= 1_000:
        return f"{v/1_000:.0f}K"
    return f"{int(v)}"

def fmt_date(d):
    if not d:
        return "—"
    try:
        return datetime.fromisoformat(str(d)[:19]).strftime('%d/%m/%Y')
    except Exception:
        return str(d)[:10]

def fmt_datetime(d):
    if not d:
        return "—"
    try:
        return datetime.fromisoformat(str(d)[:19]).strftime('%d/%m/%Y %H:%M')
    except Exception:
        return str(d)[:16]

def get_param(cle, default=''):
    try:
        r = query("SELECT valeur FROM parametres WHERE cle=?", (cle,), one=True)
        return r['valeur'] if r else default
    except Exception:
        return default

app.jinja_env.filters['money'] = fmt_money
