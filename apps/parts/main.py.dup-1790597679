def pos_api_search():
    """API pour recherche instantanée dans le POS"""
    q = request.args.get('q', '').strip()
    pdv_id = request.args.get('pdv_id', type=int)

    if len(q) < 1:
        return jsonify([])

    # Recherche par SKU, OEM, code-barres, nom
    pieces = query("""
        SELECT p.id, p.sku, p.code_oem, p.code_barre, p.nom,
               p.prix_vente_detail, p.prix_vente_gros, p.prix_vente_mecano,
