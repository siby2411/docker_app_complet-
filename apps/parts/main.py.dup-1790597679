               (SELECT COALESCE(quantite, 0) FROM stock s
                WHERE s.piece_id=p.id AND s.point_vente_id=?) AS stock_pdv,
               (SELECT COALESCE(SUM(quantite), 0) FROM stock s
                WHERE s.piece_id=p.id) AS stock_total
        FROM pieces p
        WHERE p.statut='disponible'
          AND (p.sku LIKE ? OR p.code_oem LIKE ? OR p.code_barre LIKE ? OR p.nom LIKE ?)
        ORDER BY
          CASE WHEN p.code_barre = ? THEN 1
               WHEN p.sku = ? THEN 2
               WHEN p.code_oem = ? THEN 3
               ELSE 4 END,
          p.nom
        LIMIT 30
    """, (pdv_id, f'%{q}%', f'%{q}%', f'%{q}%', f'%{q}%', q, q, q))

    return jsonify([dict(p) for p in pieces])

