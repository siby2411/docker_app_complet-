# CONTEXT PROCESSOR (avec cache pour performance)
# ═══════════════════════════════════════════════════════════
@app.context_processor
def inject_globals():
    import time as _time

    if not hasattr(inject_globals, '_cache'):
        inject_globals._cache = {'time': 0, 'stats': None, 'settings': None}

    now_ts = _time.time()

    # Cache des stats (5 secondes)
    if now_ts - inject_globals._cache['time'] < 5 and inject_globals._cache['stats']:
        stats = inject_globals._cache['stats']
    else:
        stats = {
            'pieces_total': 0,
            'pieces_actives': 0,
            'stock_valeur': 0,
            'stock_alertes': 0,
            'ventes_mois': 0,
            'ca_mois': 0,
            'clients_total': 0,
        }
        try:
            stats['pieces_total'] = query("SELECT COUNT(*) c FROM pieces", one=True)['c']
            stats['pieces_actives'] = query("SELECT COUNT(*) c FROM pieces WHERE statut='disponible'", one=True)['c']
            stats['stock_valeur'] = query("""
                SELECT COALESCE(SUM(s.quantite * p.prix_achat), 0) c
                FROM stock s
                JOIN pieces p ON p.id = s.piece_id
            """, one=True)['c']
            stats['stock_alertes'] = query("""
                SELECT COUNT(*) c FROM (
                    SELECT p.id, COALESCE(SUM(s.quantite), 0) AS qte, p.stock_alerte
                    FROM pieces p
                    LEFT JOIN stock s ON s.piece_id = p.id
                    GROUP BY p.id
                    HAVING qte <= p.stock_alerte
                )
            """, one=True)['c']
            stats['ventes_mois'] = query("""
                SELECT COUNT(*) c FROM ventes
                WHERE statut='complete'
                  AND strftime('%Y-%m', date_vente) = strftime('%Y-%m','now')
            """, one=True)['c']
            stats['ca_mois'] = query("""
                SELECT COALESCE(SUM(montant_ttc), 0) c FROM ventes
                WHERE statut='complete'
                  AND strftime('%Y-%m', date_vente) = strftime('%Y-%m','now')
            """, one=True)['c']
            stats['clients_total'] = query("SELECT COUNT(*) c FROM clients", one=True)['c']
        except Exception as e:
            print(f"[WARN] inject_globals stats: {e}")

        inject_globals._cache['stats'] = stats
        inject_globals._cache['time'] = now_ts

    # Paramètres entreprise (cache long)
    if not inject_globals._cache['settings']:
        try:
            rows = query("SELECT cle, valeur FROM parametres")
            inject_globals._cache['settings'] = {r['cle']: r['valeur'] for r in rows}
        except Exception:
            inject_globals._cache['settings'] = {}

    return {
        'stats_sidebar': stats,
        'settings': inject_globals._cache['settings'],
        'now': datetime.now(),
    }

