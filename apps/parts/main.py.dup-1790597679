@app.route('/pieces')
@login_required
def pieces_list():
    q = request.args.get('q', '').strip()
    categorie_id = request.args.get('categorie_id', type=int)
    marque = request.args.get('marque', '').strip()
    qualite = request.args.get('qualite', '').strip()
    statut = request.args.get('statut', '').strip()
    alerte = request.args.get('alerte', '').strip()
    page = max(1, request.args.get('page', 1, type=int))
    per_page = 24

    where = " WHERE 1=1"
    params = []
    if q:
        where += " AND (p.nom LIKE ? OR p.sku LIKE ? OR p.code_oem LIKE ? OR p.code_barre LIKE ? OR p.marque_piece LIKE ?)"
        params += [f'%{q}%'] * 5
    if categorie_id:
        where += " AND p.categorie_id=?"; params.append(categorie_id)
    if marque:
        where += " AND p.marque_piece=?"; params.append(marque)
    if qualite:
        where += " AND p.qualite=?"; params.append(qualite)
    if statut:
        where += " AND p.statut=?"; params.append(statut)

    # Filtre "alerte stock"
    if alerte == '1':
        where += """ AND p.id IN (
            SELECT p2.id FROM pieces p2
            LEFT JOIN stock s ON s.piece_id = p2.id
            GROUP BY p2.id
            HAVING COALESCE(SUM(s.quantite), 0) <= p2.stock_alerte
        )"""

    total = query(f"SELECT COUNT(*) c FROM pieces p {where}", params, one=True)['c']

    offset = (page - 1) * per_page
    pieces = query(f"""
        SELECT p.*,
               c.nom AS categorie_nom, c.icone AS categorie_icone,
               (SELECT COALESCE(SUM(quantite), 0) FROM stock s WHERE s.piece_id=p.id) AS stock_total
        FROM pieces p
        LEFT JOIN categories c ON c.id = p.categorie_id
        {where}
        ORDER BY p.id DESC LIMIT ? OFFSET ?
    """, params + [per_page, offset])

    categories = query("SELECT * FROM categories WHERE parent_id IS NOT NULL ORDER BY nom")
    marques_pieces = [r['marque_piece'] for r in query("""
        SELECT DISTINCT marque_piece FROM pieces WHERE marque_piece IS NOT NULL AND marque_piece != ''
        ORDER BY marque_piece
    """)]

    # KPI
    kpi = {
        'total': total,
        'disponibles': query("SELECT COUNT(*) c FROM pieces WHERE statut='disponible'", one=True)['c'],
        'alertes': query("""
            SELECT COUNT(*) c FROM (
                SELECT p.id FROM pieces p
                LEFT JOIN stock s ON s.piece_id=p.id
                GROUP BY p.id
                HAVING COALESCE(SUM(s.quantite), 0) <= p.stock_alerte
            )
        """, one=True)['c'],
        'valeur_stock': query("""
            SELECT COALESCE(SUM(s.quantite * p.prix_achat), 0) c
            FROM stock s JOIN pieces p ON p.id=s.piece_id
        """, one=True)['c'],
    }

    pages = (total + per_page - 1) // per_page
    return render_template('pieces/list.html',
                           pieces=pieces, categories=categories, marques_pieces=marques_pieces,
                           q=q, categorie_id=categorie_id, marque=marque, qualite=qualite,
                           statut=statut, alerte=alerte, kpi=kpi,
                           page=page, pages=pages)

