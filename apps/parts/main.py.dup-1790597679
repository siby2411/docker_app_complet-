        flash("✅ Paramètres enregistrés.", "success")
        return redirect(url_for('parametres'))
    params = query("SELECT * FROM parametres ORDER BY cle")
    return render_template('parametres.html', params=params)

@app.route('/audit')
@login_required
@admin_required
def audit_list():
    action = request.args.get('action', '').strip()
    entity = request.args.get('entity', '').strip()
    page = max(1, request.args.get('page', 1, type=int))
    per_page = 50

    where = " WHERE 1=1"
    params = []
    if action: where += " AND a.action=?"; params.append(action)
    if entity: where += " AND a.entity=?"; params.append(entity)

    total = query(f"SELECT COUNT(*) c FROM audit_log a {where}", params, one=True)['c']
    offset = (page - 1) * per_page
    logs = query(f"""SELECT a.*, u.nom_complet AS user_nom FROM audit_log a
        LEFT JOIN users u ON u.id = a.user_id {where}
        ORDER BY a.id DESC LIMIT ? OFFSET ?""", params + [per_page, offset])

    actions = [r['action'] for r in query("SELECT DISTINCT action FROM audit_log ORDER BY action")]
    entities = [r['entity'] for r in query("SELECT DISTINCT entity FROM audit_log WHERE entity IS NOT NULL ORDER BY entity")]
    pages = (total + per_page - 1) // per_page

    return render_template('audit/list.html', logs=logs, actions=actions, entities=entities,
                           action=action, entity=entity, page=page, pages=pages, total=total)

@app.route('/recherche')
@login_required
def recherche_globale():
    q = request.args.get('q', '').strip()
    resultats = {'pieces': [], 'clients': [], 'ventes': []}
    if q and len(q) >= 2:
        resultats['pieces'] = query("""
            SELECT id, sku, nom, code_oem, prix_vente_detail FROM pieces
            WHERE statut='disponible' AND (sku LIKE ? OR nom LIKE ? OR code_oem LIKE ? OR code_barre LIKE ?)
            LIMIT 10
        """, (f'%{q}%',) * 4)
        resultats['clients'] = query("""
            SELECT id, code, nom, prenom, telephone FROM clients
            WHERE nom LIKE ? OR prenom LIKE ? OR telephone LIKE ? OR code LIKE ? LIMIT 10
        """, (f'%{q}%',) * 4)
        resultats['ventes'] = query("SELECT id, numero, montant_ttc, date_vente FROM ventes WHERE numero LIKE ? LIMIT 10",
                                     (f'%{q}%',))
    return render_template('recherche.html', q=q, resultats=resultats)




