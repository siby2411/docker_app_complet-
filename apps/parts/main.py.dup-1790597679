def parse_periode():
    periode = request.args.get('periode', 'mois')
    today = datetime.now().date()
    if periode == 'jour':
        d1 = d2 = today; label = f"Aujourd'hui ({d1.strftime('%d/%m/%Y')})"
    elif periode == 'semaine':
        d1 = today - timedelta(days=today.weekday()); d2 = today; label = "Cette semaine"
    elif periode == 'mois':
        d1 = today.replace(day=1); d2 = today; label = f"{d1.strftime('%B %Y')}"
    elif periode == 'trimestre':
        q = (today.month - 1) // 3
        d1 = today.replace(month=q * 3 + 1, day=1); d2 = today; label = f"T{q + 1} {today.year}"
    elif periode == 'annee':
        d1 = today.replace(month=1, day=1); d2 = today; label = f"Année {today.year}"
    elif periode == 'custom':
        try:
            d1 = datetime.fromisoformat(request.args.get('date_from', '')).date()
            d2 = datetime.fromisoformat(request.args.get('date_to', '')).date()
            label = f"{d1.strftime('%d/%m/%Y')} → {d2.strftime('%d/%m/%Y')}"
        except Exception:
            d1 = today.replace(day=1); d2 = today; label = "Période personnalisée"
    else:
        d1 = today.replace(day=1); d2 = today; label = "Ce mois"
    return d1.isoformat(), d2.isoformat(), label, periode

def csv_response(rows, headers, filename):
    def gen():
        yield '\ufeff'
        yield ','.join(f'"{h}"' for h in headers) + '\n'
        for r in rows:
            line = []
            for h in headers:
                v = r.get(h, '') if isinstance(r, dict) else ''
                v = str(v).replace('"', '""')
                line.append(f'"{v}"')
            yield ','.join(line) + '\n'
    return Response(gen(), mimetype='text/csv; charset=utf-8',
                    headers={'Content-Disposition': f'attachment; filename={filename}'})

