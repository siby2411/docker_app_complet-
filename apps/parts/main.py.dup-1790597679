def gen_numero_commande():
    today = datetime.now().strftime('%Y%m%d')
    row = query("""
        SELECT numero FROM commandes_fournisseurs WHERE numero LIKE ? ORDER BY id DESC LIMIT 1
    """, (f'CMD-{today}-%',), one=True)
    if row and row['numero']:
        try:
            n = int(row['numero'].split('-')[-1]) + 1
        except Exception:
            n = 1
    else:
        n = 1
    return f"CMD-{today}-{n:04d}"

