@login_required
@gerant_required
def vente_annuler(vid):
    v = query("SELECT * FROM ventes WHERE id=?", (vid,), one=True)
    if not v:
        abort(404)

    if v['statut'] == 'annulee':
        flash("Vente déjà annulée.", "error")
        return redirect(url_for('vente_detail', vid=vid))

    # Restaurer le stock
    lignes = query("SELECT * FROM ventes_lignes WHERE vente_id=?", (vid,))
    for l in lignes:
        stock = query("SELECT * FROM stock WHERE piece_id=? AND point_vente_id=?",
                      (l['piece_id'], v['point_vente_id']), one=True)
        if stock:
            qte_avant = stock['quantite'] or 0
            qte_apres = qte_avant + l['quantite']
            execute("UPDATE stock SET quantite=?, updated_at=? WHERE id=?",
                    (qte_apres, datetime.now().isoformat(), stock['id']))

            execute("""
                INSERT INTO stock_mouvements (piece_id, point_vente_id, type, quantite,
                    quantite_avant, quantite_apres, motif, reference, user_id, created_at)
                VALUES (?,?,?,?,?,?,?,?,?,?)
            """, (l['piece_id'], v['point_vente_id'], 'entree', l['quantite'],
                  qte_avant, qte_apres, f'Annulation vente {v["numero"]}', v['numero'],
                  current_user.id, datetime.now().isoformat()))

    # Mettre à jour statut
    execute("UPDATE ventes SET statut='annulee' WHERE id=?", (vid,))

    # Soustraire stats client
    if v['client_id']:
        execute("""
            UPDATE clients SET
                nb_achats = MAX(0, nb_achats - 1),
                total_achats = MAX(0, total_achats - ?)
            WHERE id=?
        """, (v['montant_ttc'], v['client_id']))

    audit('cancel', 'vente', vid, v['numero'])
    flash(f"✅ Vente {v['numero']} annulée. Stock restauré.", "success")
    return redirect(url_for('vente_detail', vid=vid))

