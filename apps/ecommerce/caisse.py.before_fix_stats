    @app.route('/statistiques')
    @admin_required
    def statistiques():
        conn = get_db()
        c = conn.cursor()

        # Top 10 produits par quantité
        c.execute("""SELECT p.sku, p.nom, p.prix_vente,
                            COALESCE(SUM(lc.quantite), 0) as qte_vendue,
                            COALESCE(SUM(lc.total_ligne), 0) as ca
                     FROM produits p
                     LEFT JOIN lignes_commande lc ON lc.produit_id = p.id
                     GROUP BY p.id
                     HAVING qte_vendue > 0
                     ORDER BY qte_vendue DESC LIMIT 10""")
        top_qte = c.fetchall()

        # Top 10 par CA
        c.execute("""SELECT p.sku, p.nom, p.prix_vente,
                            COALESCE(SUM(lc.quantite), 0) as qte_vendue,
                            COALESCE(SUM(lc.total_ligne), 0) as ca
                     FROM produits p
                     LEFT JOIN lignes_commande lc ON lc.produit_id = p.id
                     GROUP BY p.id
                     HAVING ca > 0
                     ORDER BY ca DESC LIMIT 10""")
        top_ca = c.fetchall()

        # Ventes par catégorie
        c.execute("""SELECT cat.nom as cat_nom,
                            COUNT(DISTINCT p.id) as nb_produits,
                            COALESCE(SUM(lc.quantite), 0) as qte_vendue,
                            COALESCE(SUM(lc.total_ligne), 0) as ca
                     FROM categories cat
                     LEFT JOIN produits p ON p.categorie_id = cat.id
                     LEFT JOIN lignes_commande lc ON lc.produit_id = p.id
                     GROUP BY cat.id
                     ORDER BY ca DESC""")
        par_categorie = c.fetchall()

        # Clients VIP
        c.execute("""SELECT nom, prenom, code, telephone, total_achats, nb_commandes, points_fidelite
                     FROM clients
                     WHERE nb_commandes > 0
                     ORDER BY total_achats DESC LIMIT 10""")
        clients_vip = c.fetchall()

        # Panier moyen
        c.execute("""SELECT COALESCE(AVG(total), 0) FROM commandes WHERE statut != 'Annulée'""")
        panier_moyen = c.fetchone()[0]

        # Nb clients actifs
        c.execute("SELECT COUNT(*) FROM clients WHERE actif=1")
        nb_clients = c.fetchone()[0]

        conn.close()

        content = f"""
        <div class="page-header">
          <div>
            <h2><i class="fas fa-chart-bar"></i> Statistiques & Analytics</h2>
            <div class="page-subtitle">Analyse des performances</div>
          </div>
          <div style="display:flex;gap:10px">
            <a href="/statistiques/export/produits" class="btn btn-gold"><i class="fas fa-file-excel"></i> Export Excel</a>
          </div>
        </div>

        <div class="stats">
          <div class="stat-card">
            <i class="fas fa-shopping-cart stat-icon"></i>
            <div class="stat-value">{panier_moyen:,.0f}</div>
            <div class="stat-label">Panier moyen (FCFA)</div>
          </div>
          <div class="stat-card green">
            <i class="fas fa-users stat-icon"></i>
            <div class="stat-value">{nb_clients}</div>
            <div class="stat-label">Clients actifs</div>
          </div>
          <div class="stat-card gold">
            <i class="fas fa-star stat-icon"></i>
            <div class="stat-value">{clients_vip[0]['total_achats']:,.0f if clients_vip else 0}</div>
            <div class="stat-label">Meilleur client (FCFA)</div>
          </div>
        </div>

        <div class="card">
          <div class="card-header"><h3><i class="fas fa-fire"></i> Top 10 produits (quantité)</h3></div>
          <div class="table-wrap">
            <table>
              <thead><tr><th>#</th><th>SKU</th><th>Produit</th><th style="text-align:right">Qté vendue</th><th style="text-align:right">CA (FCFA)</th><th>Performance</th></tr></thead>
              <tbody>
        """
        max_qte = max([p['qte_vendue'] for p in top_qte], default=1)
        for i, p in enumerate(top_qte, 1):
            pct = int(p['qte_vendue'] / max_qte * 100)
            medal = '🥇' if i == 1 else ('🥈' if i == 2 else ('🥉' if i == 3 else ''))
            content += f"""
            <tr>
              <td><strong>{medal} {i}</strong></td>
              <td>{p['sku']}</td>
              <td>{p['nom'][:45]}</td>
              <td style="text-align:right"><strong style="color:#10b981">{p['qte_vendue']}</strong></td>
              <td style="text-align:right"><strong>{p['ca']:,.0f}</strong></td>
              <td>
                <div style="background:#f1f5f9;border-radius:6px;height:16px;width:100%;overflow:hidden">
                  <div style="background:linear-gradient(90deg,#ff6b35,#f7931e);height:100%;width:{pct}%"></div>
