        content += """
              </tbody>
            </table>
          </div>
        </div>

        <div class="card">
          <div class="card-header"><h3><i class="fas fa-trophy"></i> Top 10 produits (CA)</h3></div>
          <div class="table-wrap">
            <table>
              <thead><tr><th>#</th><th>SKU</th><th>Produit</th><th style="text-align:right">CA (FCFA)</th><th style="text-align:right">Qté</th></tr></thead>
