    @app.route('/api/caisse/recherche')
    @vendeur_required
    def api_caisse_recherche():
        q = request.args.get('q', '').strip()
        if not q:
            return jsonify({'produits': []})

        conn = get_db()
        c = conn.cursor()
        c.execute("""SELECT id, sku, nom, prix_vente, prix_promo, stock
                     FROM produits
                     WHERE actif=1 AND stock > 0
                     AND (nom LIKE ? OR sku LIKE ?)
                     ORDER BY nom LIMIT 20""",
                  (f'%{q}%', f'%{q}%'))
        rows = c.fetchall()
        conn.close()

        return jsonify({
            'produits': [{
                'id': r['id'],
                'sku': r['sku'],
                'nom': r['nom'],
                'prix_vente': r['prix_vente'],
                'prix_promo': r['prix_promo'],
                'stock': r['stock']
            } for r in rows]
        })

    # ==================== API VALIDER VENTE ====================
    @app.route('/api/caisse/valider', methods=['POST'])
    @vendeur_required
    def api_caisse_valider():
        try:
            data = request.get_json()
            items = data.get('items', [])
            mode_paiement = data.get('mode_paiement', 'Espèces')

            if not items:
                return jsonify({'success': False, 'error': 'Panier vide'})

            conn = get_db()
            c = conn.cursor()

            # Calculer totaux
            sous_total = sum(item['qte'] * item['prix'] for item in items)
            tva = sous_total * 18 / 118
            total_ht = sous_total - tva

            # Créer facture
            numero = gen_numero_facture('FAC')
            c.execute("""INSERT INTO factures
                (numero, date_facture, sous_total, tva, total, montant_paye,
                 mode_paiement, statut, type_facture)
                VALUES (?, ?, ?, ?, ?, ?, ?, 'Payé', 'FAC')""",
                (numero, datetime.now().isoformat(), total_ht, tva, sous_total,
                 sous_total, mode_paiement))
            facture_id = c.lastrowid

            # Lignes
            for item in items:
                c.execute("""SELECT sku, nom FROM produits WHERE id=?""", (item['id'],))
                p = c.fetchone()

                c.execute("""INSERT INTO lignes_facture
                    (facture_id, produit_id, designation, quantite, prix_unitaire,
                     tva_ligne, total_ligne)
                    VALUES (?, ?, ?, ?, ?, ?, ?)""",
                    (facture_id, item['id'], p['nom'], item['qte'], item['prix'],
                     item['prix'] * item['qte'] * 18/118,
                     item['qte'] * item['prix']))

                # Décrémenter stock
                c.execute("""UPDATE produits SET stock = stock - ?, nb_ventes = nb_ventes + ?
                             WHERE id=?""", (item['qte'], item['qte'], item['id']))

            # Mouvement caisse
            c.execute("""INSERT INTO mouvements_caisse
                (date_mouvement, type_mouvement, montant, mode_paiement, facture_id,
                 user_id, motif)
                VALUES (?, 'ENTREE', ?, ?, ?, ?, 'Vente POS')""",
                (datetime.now().isoformat(), sous_total, mode_paiement, facture_id,
                 current_user.id if current_user else None))

            # Journal comptable (double écriture simplifiée)
            c.execute("""INSERT INTO journal_comptable
                (date_ecriture, numero_piece, libelle, compte, debit, credit, user_id)
                VALUES (?, ?, ?, '571', ?, 0, ?)""",
                (datetime.now().isoformat(), numero, f'Vente caisse {numero}',
                 sous_total, current_user.id if current_user else None))
            c.execute("""INSERT INTO journal_comptable
                (date_ecriture, numero_piece, libelle, compte, debit, credit, user_id)
                VALUES (?, ?, ?, '701', 0, ?, ?)""",
                (datetime.now().isoformat(), numero, f'Vente caisse {numero}',
                 total_ht, current_user.id if current_user else None))
            c.execute("""INSERT INTO journal_comptable
                (date_ecriture, numero_piece, libelle, compte, debit, credit, user_id)
                VALUES (?, ?, ?, '443', 0, ?, ?)""",
                (datetime.now().isoformat(), numero, f'TVA {numero}',
                 tva, current_user.id if current_user else None))

            conn.commit()
            conn.close()

            if current_user:
                log_action(current_user.id, 'VENTE_CAISSE', numero)

            return jsonify({'success': True, 'facture_id': facture_id, 'numero': numero})
        except Exception as e:
            import traceback
            traceback.print_exc()
            return jsonify({'success': False, 'error': str(e)})

