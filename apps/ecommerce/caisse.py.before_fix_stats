    @app.route('/etats-financiers')
    @admin_required
    def etats_financiers():
        conn = get_db()
        c = conn.cursor()

        # CA du jour
        c.execute("""SELECT COALESCE(SUM(total), 0) FROM factures
                     WHERE date(date_facture) = date('now')""")
        ca_jour = c.fetchone()[0]

        # CA semaine
        c.execute("""SELECT COALESCE(SUM(total), 0) FROM factures
                     WHERE date_facture >= date('now', '-7 days')""")
        ca_semaine = c.fetchone()[0]

        # CA mois
        c.execute("""SELECT COALESCE(SUM(total), 0) FROM factures
                     WHERE strftime('%Y-%m', date_facture) = strftime('%Y-%m', 'now')""")
        ca_mois = c.fetchone()[0]

        # CA année
        c.execute("""SELECT COALESCE(SUM(total), 0) FROM factures
                     WHERE strftime('%Y', date_facture) = strftime('%Y', 'now')""")
        ca_annee = c.fetchone()[0]

        # TVA collectée mois
        c.execute("""SELECT COALESCE(SUM(tva), 0) FROM factures
                     WHERE strftime('%Y-%m', date_facture) = strftime('%Y-%m', 'now')""")
        tva_mois = c.fetchone()[0]

        # Calcul des bénéfices (marge sur ventes mois)
        c.execute("""SELECT COALESCE(SUM(lf.quantite * (lf.prix_unitaire - COALESCE(p.prix_achat, 0))), 0)
                     FROM lignes_facture lf
                     JOIN factures f ON lf.facture_id = f.id
                     LEFT JOIN produits p ON lf.produit_id = p.id
                     WHERE strftime('%Y-%m', f.date_facture) = strftime('%Y-%m', 'now')""")
        marge_mois = c.fetchone()[0]

        # CA par mois (6 derniers)
        c.execute("""SELECT strftime('%Y-%m', date_facture) as mois,
                            COUNT(*) as nb,
                            COALESCE(SUM(total), 0) as total,
                            COALESCE(SUM(tva), 0) as tva
                     FROM factures
                     WHERE date_facture >= date('now', '-6 months')
                     GROUP BY mois ORDER BY mois DESC""")
        ca_par_mois = c.fetchall()

        # CA par mode paiement
        c.execute("""SELECT mode_paiement, COUNT(*) as nb, COALESCE(SUM(total), 0) as total
                     FROM factures
                     WHERE mode_paiement IS NOT NULL
                     GROUP BY mode_paiement
                     ORDER BY total DESC""")
        par_mode = c.fetchall()

        conn.close()

        content = f"""
        <div class="page-header">
          <div>
            <h2><i class="fas fa-chart-line"></i> États financiers</h2>
            <div class="page-subtitle">Vue comptable temps réel</div>
          </div>
          <div style="display:flex;gap:10px">
            <a href="/etats-financiers/journal" class="btn btn-info"><i class="fas fa-book"></i> Journal</a>
            <a href="/etats-financiers/rapport-z" class="btn btn-primary"><i class="fas fa-receipt"></i> Rapport Z</a>
          </div>
        </div>

        <div class="stats">
          <div class="stat-card">
            <i class="fas fa-calendar-day stat-icon"></i>
            <div class="stat-value">{ca_jour:,.0f}</div>
            <div class="stat-label">CA du jour (FCFA)</div>
          </div>
          <div class="stat-card gold">
            <i class="fas fa-calendar-week stat-icon"></i>
            <div class="stat-value">{ca_semaine:,.0f}</div>
            <div class="stat-label">CA 7 jours (FCFA)</div>
          </div>
          <div class="stat-card green">
            <i class="fas fa-calendar-month stat-icon"></i>
            <div class="stat-value">{ca_mois:,.0f}</div>
            <div class="stat-label">CA du mois (FCFA)</div>
          </div>
          <div class="stat-card purple">
            <i class="fas fa-calendar stat-icon"></i>
            <div class="stat-value">{ca_annee:,.0f}</div>
            <div class="stat-label">CA annuel (FCFA)</div>
          </div>
        </div>

        <div class="stats">
          <div class="stat-card blue">
            <i class="fas fa-percent stat-icon"></i>
            <div class="stat-value">{tva_mois:,.0f}</div>
            <div class="stat-label">TVA collectée ce mois</div>
          </div>
          <div class="stat-card green">
            <i class="fas fa-chart-pie stat-icon"></i>
            <div class="stat-value">{marge_mois:,.0f}</div>
            <div class="stat-label">Marge brute ce mois</div>
          </div>
          <div class="stat-card gold">
            <i class="fas fa-percentage stat-icon"></i>
            <div class="stat-value">{(marge_mois / ca_mois * 100) if ca_mois > 0 else 0:.1f}%</div>
            <div class="stat-label">Taux de marge</div>
          </div>
        </div>

        <div class="card">
          <div class="card-header"><h3><i class="fas fa-chart-column"></i> CA par mois (6 derniers)</h3></div>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Mois</th><th>Nb factures</th><th>CA TTC</th><th>Dont TVA</th></tr></thead>
              <tbody>
        """
        for m in ca_par_mois:
            content += f"""
            <tr>
              <td><strong>{m['mois']}</strong></td>
              <td>{m['nb']}</td>
              <td><strong style="color:#ff6b35">{m['total']:,.0f}</strong> FCFA</td>
              <td>{m['tva']:,.0f} FCFA</td>
