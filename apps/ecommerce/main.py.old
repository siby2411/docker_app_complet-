/* ============ FORMS ============ */
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}
.form-group{margin-bottom:16px}
.form-group label{display:block;font-weight:800;color:#ff6b35;margin-bottom:8px;font-size:0.82rem;text-transform:uppercase;letter-spacing:0.5px}
.form-group input,.form-group select,.form-group textarea{width:100%;padding:12px 15px;border:2px solid #f1f5f9;border-radius:11px;font-size:0.92rem;background:#f8fafc;transition:0.3s;font-family:inherit}
.form-group input:focus,.form-group select:focus,.form-group textarea:focus{outline:none;border-color:#ff6b35;background:white;box-shadow:0 0 0 4px rgba(255,107,53,0.1)}
.form-full{grid-column:1/-1}

/* ============ FOOTER ============ */
.footer{background:linear-gradient(135deg,#1a1a2e,#2d2d44);color:white;padding:30px;margin-top:60px;text-align:center;font-size:0.85rem}
.footer strong{color:#ff6b35;font-weight:800}
.footer .footer-sub{opacity:0.7;font-size:0.75rem;margin-top:8px}

/* ============ EMPTY ============ */
.empty{text-align:center;padding:60px 20px;color:#94a3b8}
.empty i{font-size:4rem;color:#fed7aa;margin-bottom:18px}

/* ============ HERO ============ */
.hero{background:linear-gradient(135deg,#ff6b35 0%,#f7931e 50%,#ffb800 100%);border-radius:24px;padding:50px;color:white;margin-bottom:30px;position:relative;overflow:hidden;box-shadow:0 15px 40px rgba(255,107,53,0.25)}
.hero::before{content:'';position:absolute;top:-80px;right:-80px;width:280px;height:280px;background:rgba(255,255,255,0.1);border-radius:50%}
.hero::after{content:'';position:absolute;bottom:-100px;left:-50px;width:220px;height:220px;background:rgba(255,255,255,0.08);border-radius:50%}
.hero h1{font-size:2.4rem;font-weight:900;margin-bottom:12px;position:relative;z-index:1;letter-spacing:-1px}
.hero h1 span{color:#ffd700}
.hero p{font-size:1.05rem;opacity:0.95;position:relative;z-index:1;max-width:600px;line-height:1.5}
.hero .btn-hero{background:white;color:#ff6b35;padding:14px 28px;border-radius:12px;font-weight:800;font-size:1rem;text-decoration:none;display:inline-flex;align-items:center;gap:10px;margin-top:24px;position:relative;z-index:1;transition:0.3s;box-shadow:0 8px 20px rgba(0,0,0,0.15)}
.hero .btn-hero:hover{transform:translateY(-3px);box-shadow:0 12px 30px rgba(0,0,0,0.25)}

@media(max-width:768px){
  .form-grid{grid-template-columns:1fr}
  .header{flex-direction:column;align-items:flex-start}
  .stats{grid-template-columns:1fr 1fr}
  .container{padding:0 15px}
  .hero{padding:30px 20px}
  .hero h1{font-size:1.7rem}
  .top-banner{flex-direction:column;gap:5px;text-align:center}
}
</style>
</head>
<body>

<!-- TOP BANNER -->
<div class="top-banner">
  <div class="brand-info">
    <span><i class="fas fa-bolt"></i> <strong>OMEGA SHOP</strong> — Boutique en ligne premium</span>
  </div>
  <div class="brand-info">
    <span><i class="fas fa-phone"></i> +221 33 800 00 00</span>
    <span><i class="fas fa-truck-fast"></i> Livraison 24-48h</span>
    <span><i class="fas fa-shield-halved"></i> Paiement sécurisé</span>
  </div>
</div>

<!-- HEADER -->
<header class="header">
  <div class="logo-section">
    <div class="logo-icon"><i class="fas fa-shopping-bag"></i></div>
    <div>
      <h1>OMEGA <span>SHOP</span></h1>
      <div class="subtitle"><i class="fas fa-star"></i> Excellence & Innovation</div>
    </div>
  </div>
  <div class="user-section">
    {% if current_user and current_user.is_authenticated %}
    <div class="user-badge">
      <div class="avatar">{{ current_user.prenom[0] if current_user.prenom else 'U' }}{{ current_user.nom[0] if current_user.nom else '' }}</div>
      <div class="info">
        <span class="name">{{ current_user.prenom }} {{ current_user.nom }}</span>
        <span class="role">{{ current_user.role }}</span>
      </div>
    </div>
    <a href="/logout" class="btn-logout"><i class="fas fa-right-from-bracket"></i> Déconnexion</a>
    {% endif %}
  </div>
</header>

<!-- NAV -->
<nav class="nav">
  <a href="/" class="{{ 'active' if active=='dashboard' else '' }}"><i class="fas fa-chart-line"></i> Dashboard</a>
  {% if current_user and current_user.is_authenticated %}
    {% if current_user.role in ['admin','vendeur'] %}
    <a href="/produits" class="{{ 'active' if active=='produits' else '' }}"><i class="fas fa-box"></i> Produits</a>
    <a href="/categories" class="{{ 'active' if active=='categories' else '' }}"><i class="fas fa-tags"></i> Catégories</a>
    <a href="/marques" class="{{ 'active' if active=='marques' else '' }}"><i class="fas fa-award"></i> Marques</a>
    <a href="/fournisseurs" class="{{ 'active' if active=='fournisseurs' else '' }}"><i class="fas fa-truck-loading"></i> Fournisseurs</a>
    {% endif %}
    {% if current_user.role in ['admin','vendeur','livreur'] %}
    <a href="/commandes" class="{{ 'active' if active=='commandes' else '' }}"><i class="fas fa-shopping-cart"></i> Commandes</a>
    {% endif %}
    {% if current_user.role in ['admin','vendeur'] %}
    <a href="/clients" class="{{ 'active' if active=='clients' else '' }}"><i class="fas fa-users"></i> Clients</a>
    <a href="/promotions" class="{{ 'active' if active=='promotions' else '' }}"><i class="fas fa-percent"></i> Promotions</a>
    {% endif %}
    {% if current_user.role in ['admin'] %}
    <a href="/rapports" class="{{ 'active' if active=='rapports' else '' }}"><i class="fas fa-chart-pie"></i> Rapports</a>
    {% endif %}
    {% if current_user.role == 'client' %}
    <a href="/boutique" class="{{ 'active' if active=='boutique' else '' }}"><i class="fas fa-store"></i> Boutique</a>
    <a href="/mon-panier" class="{{ 'active' if active=='panier' else '' }}"><i class="fas fa-shopping-basket"></i> Panier</a>
    <a href="/mes-commandes" class="{{ 'active' if active=='mes_commandes' else '' }}"><i class="fas fa-receipt"></i> Mes commandes</a>
    <a href="/ma-wishlist" class="{{ 'active' if active=='wishlist' else '' }}"><i class="fas fa-heart"></i> Wishlist</a>
    {% endif %}
  {% endif %}
</nav>

<!-- CONTAINER -->
<div class="container">
  {% with messages = get_flashed_messages(with_categories=true) %}
    {% if messages %}{% for cat, msg in messages %}
      <div class="flash flash-{{ cat }}"><i class="fas fa-circle-info"></i> {{ msg }}</div>
    {% endfor %}{% endif %}
  {% endwith %}

  {% block content %}{% endblock %}
</div>

<!-- FOOTER -->
<footer class="footer">
  <div>&copy; 2026 <strong>OMEGA SHOP</strong> — Tous droits réservés</div>
  <div class="footer-sub">
    <i class="fas fa-code"></i> Développé par <strong>OMEGA INFORMATIQUE</strong> — Solutions digitales premium · Dakar, Sénégal
  </div>
</footer>

</body>
</html>
"""


def render_page(content, active='dashboard', page_title='Omega Shop'):
    page = HTML_BASE.replace("{% block content %}{% endblock %}", content)
    return render_template_string(page, active=active, page_title=page_title, current_user=current_user)


# ==================== HEALTHCHECK ====================
@app.route('/health')
def health():
    return jsonify(status='ok', service='ecommerce-omega', timestamp=datetime.now().isoformat())


# ==================== DASHBOARD ====================
@app.route('/')
def index():
    if not (current_user and current_user.is_authenticated):
        return redirect('/login')

    # Rediriger les clients vers la boutique
    if current_user.role == 'client':
        return redirect('/boutique')

    conn = get_db()
    c = conn.cursor()

    c.execute("SELECT COUNT(*) FROM produits WHERE actif=1")
    total_produits = c.fetchone()[0]

    c.execute("SELECT COUNT(*) FROM clients WHERE actif=1")
    total_clients = c.fetchone()[0]

    c.execute("SELECT COUNT(*) FROM commandes WHERE date(date_commande) = date('now')")
    commandes_jour = c.fetchone()[0]

    c.execute("SELECT COUNT(*) FROM commandes WHERE statut NOT IN ('Livrée', 'Annulée')")
    commandes_encours = c.fetchone()[0]

    c.execute("""SELECT COALESCE(SUM(total), 0) FROM commandes
                 WHERE strftime('%Y-%m', date_commande) = strftime('%Y-%m', 'now')
                 AND statut != 'Annulée'""")
    ca_mois = c.fetchone()[0]

    c.execute("""SELECT COUNT(*) FROM produits WHERE stock <= stock_alerte AND actif=1""")
    alertes_stock = c.fetchone()[0]

    # Dernières commandes
    c.execute("""SELECT c.*, cl.nom as cl_nom, cl.prenom as cl_prenom
                 FROM commandes c
                 JOIN clients cl ON c.client_id = cl.id
                 ORDER BY c.date_commande DESC LIMIT 8""")
    dernieres_commandes = c.fetchall()

    # Top produits
    c.execute("""SELECT p.*, SUM(lc.quantite) as total_vendu
                 FROM produits p
                 JOIN lignes_commande lc ON lc.produit_id = p.id
                 GROUP BY p.id
                 ORDER BY total_vendu DESC LIMIT 5""")
    top_produits = c.fetchall()

    conn.close()

    role = current_user.role

    content = f"""
    <div class="hero">
      <h1>Bienvenue <span>{current_user.prenom}</span> 👋</h1>
      <p>Tableau de bord administrateur — Vision temps réel de votre boutique Omega Shop</p>
    </div>

    <div class="stats">
      <div class="stat-card">
        <i class="fas fa-box stat-icon"></i>
        <div class="stat-value">{total_produits}</div>
        <div class="stat-label">Produits</div>
      </div>
      <div class="stat-card green">
        <i class="fas fa-users stat-icon"></i>
        <div class="stat-value">{total_clients}</div>
        <div class="stat-label">Clients</div>
      </div>
      <div class="stat-card blue">
        <i class="fas fa-shopping-cart stat-icon"></i>
        <div class="stat-value">{commandes_jour}</div>
        <div class="stat-label">Commandes du jour</div>
      </div>
      <div class="stat-card purple">
        <i class="fas fa-truck-fast stat-icon"></i>
        <div class="stat-value">{commandes_encours}</div>
        <div class="stat-label">En cours</div>
      </div>
      <div class="stat-card gold">
        <i class="fas fa-money-bill-wave stat-icon"></i>
        <div class="stat-value">{ca_mois:,.0f}</div>
        <div class="stat-label">CA ce mois (FCFA)</div>
      </div>
      <div class="stat-card rose">
        <i class="fas fa-exclamation-triangle stat-icon"></i>
        <div class="stat-value">{alertes_stock}</div>
        <div class="stat-label">Alertes stock</div>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h3><i class="fas fa-clock-rotate-left"></i> Dernières commandes</h3>
        <a href="/commandes" class="btn btn-primary btn-sm"><i class="fas fa-arrow-right"></i> Voir tout</a>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>N°</th><th>Client</th><th>Montant</th><th>Mode</th><th>Date</th><th>Statut</th></tr></thead>
          <tbody>
    """
    for cmd in dernieres_commandes:
        badge = 'badge-info'
        if cmd['statut'] == 'Livrée': badge = 'badge-success'
        elif cmd['statut'] == 'En cours': badge = 'badge-warning'
        elif cmd['statut'] == 'Annulée': badge = 'badge-danger'

        content += f"""<tr>
          <td><strong>{cmd['numero']}</strong></td>
          <td>{cmd['cl_nom']} {cmd['cl_prenom']}</td>
          <td><strong style="color:#ff6b35">{cmd['total']:,.0f}</strong> FCFA</td>
          <td>{cmd['mode_paiement'] or '-'}</td>
          <td>{cmd['date_commande'][:10]}</td>
          <td><span class="badge {badge}">{cmd['statut']}</span></td>
        </tr>"""
    if not dernieres_commandes:
        content += '<tr><td colspan="6" class="empty"><i class="fas fa-inbox"></i><br>Aucune commande</td></tr>'

    content += """
          </tbody>
        </table>
      </div>
    </div>

    <div class="card">
      <div class="card-header">
        <h3><i class="fas fa-fire"></i> Top 5 produits</h3>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>SKU</th><th>Produit</th><th>Prix</th><th>Stock</th><th>Vendus</th></tr></thead>
          <tbody>
    """
    for prod in top_produits:
        stock_badge = 'badge-success' if prod['stock'] > prod['stock_alerte'] else 'badge-warning'
        content += f"""<tr>
          <td><strong>{prod['sku']}</strong></td>
          <td>{prod['nom'][:50]}</td>
          <td><strong>{prod['prix_vente']:,.0f}</strong> FCFA</td>
          <td><span class="badge {stock_badge}">{prod['stock']}</span></td>
          <td><strong style="color:#10b981">{prod['total_vendu']}</strong></td>
        </tr>"""
    if not top_produits:
        content += '<tr><td colspan="5" class="empty"><i class="fas fa-box-open"></i><br>Aucune vente</td></tr>'

    content += "</tbody></table></div></div>"
    return render_page(content, active='dashboard', page_title='Dashboard')


if __name__ == '__main__':
    app.run(host='0.0.0.0', port=8000, debug=False)
