"""
Omega Shop — Plateforme E-Commerce de dernière génération
Design premium orange/gold — Développé par Omega Informatique
"""
from flask import Flask, render_template_string, request, redirect, url_for, flash, jsonify
from werkzeug.middleware.proxy_fix import ProxyFix
import sqlite3
import os
from datetime import datetime, timedelta

app = Flask(__name__)
app.secret_key = 'omega_ecommerce_2026_secret_key_premium'
app.wsgi_app = ProxyFix(app.wsgi_app, x_for=1, x_proto=1, x_host=1, x_prefix=1)

DB_PATH = "/app/data/ecommerce.db"

# ==================== AUTH ====================
try:
    from auth import (init_auth, log_action, role_required, admin_required,
                      vendeur_required, staff_required, client_required)
    init_auth(app)
    AUTH_OK = True
    print("[AUTH] ✅ Module auth chargé")
except Exception as e:
    print(f"[AUTH] ⚠️ {e}")
    AUTH_OK = False
    def role_required(*r):
        def d(f): return f
        return d
    def admin_required(f): return f
    def vendeur_required(f): return f
    def staff_required(f): return f
    def client_required(f): return f
    def log_action(*a, **k): pass

try:
    from flask_login import current_user, login_required
except ImportError:
    current_user = None
    def login_required(f): return f


def get_db():
    conn = sqlite3.connect(DB_PATH, timeout=30.0)
    conn.row_factory = sqlite3.Row
    conn.execute("PRAGMA busy_timeout=30000")
    conn.execute("PRAGMA journal_mode=WAL")
    return conn


# ==================== DESIGN ÉPOUSTOUFLANT ====================
HTML_BASE = """
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Omega Shop — {{ page_title or 'E-Commerce' }}</title>
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',system-ui,sans-serif}
body{background:#fef9f3;color:#1a1a2e;min-height:100vh}

/* ============ TOP BANNER ============ */
.top-banner{background:linear-gradient(90deg,#ff6b35 0%,#f7931e 50%,#ffb800 100%);color:white;padding:10px 25px;font-size:0.82rem;display:flex;justify-content:space-between;align-items:center;font-weight:600;letter-spacing:0.3px}
.top-banner i{color:#ffd700}
.top-banner .brand-info{display:flex;align-items:center;gap:20px;flex-wrap:wrap}
.top-banner strong{color:#ffd700;font-weight:800}

/* ============ HEADER ============ */
.header{background:white;box-shadow:0 4px 24px rgba(255,107,53,0.08);padding:16px 30px;display:flex;justify-content:space-between;align-items:center;border-bottom:3px solid #ff6b35;flex-wrap:wrap;gap:15px}
.header .logo-section{display:flex;align-items:center;gap:15px}
.logo-icon{width:56px;height:56px;background:linear-gradient(135deg,#ff6b35,#f7931e);border-radius:16px;display:flex;justify-content:center;align-items:center;color:white;font-size:1.7rem;box-shadow:0 8px 24px rgba(255,107,53,0.3);transform:rotate(-5deg)}
.header h1{font-size:1.55rem;color:#1a1a2e;font-weight:900;line-height:1.05;letter-spacing:-0.5px}
.header h1 span{color:#ff6b35}
.header .subtitle{font-size:0.72rem;color:#64748b;margin-top:4px;letter-spacing:1px;text-transform:uppercase;font-weight:700}
.user-section{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.user-badge{display:flex;align-items:center;gap:10px;padding:8px 16px;background:#fff4e6;border-radius:30px;border:1.5px solid #fed7aa}
.user-badge .avatar{width:38px;height:38px;background:linear-gradient(135deg,#ff6b35,#f7931e);border-radius:50%;display:flex;justify-content:center;align-items:center;color:white;font-weight:800;font-size:0.9rem}
.user-badge .info{display:flex;flex-direction:column;line-height:1.15}
.user-badge .name{font-weight:700;font-size:0.85rem;color:#1a1a2e}
.user-badge .role{font-size:0.68rem;color:#ff6b35;text-transform:uppercase;font-weight:800;letter-spacing:0.5px}
.btn-logout{background:linear-gradient(135deg,#dc2626,#ef4444);color:white;padding:9px 16px;border-radius:10px;text-decoration:none;font-size:0.82rem;font-weight:700;transition:0.3s;box-shadow:0 4px 12px rgba(220,38,38,0.25)}
.btn-logout:hover{transform:translateY(-2px);box-shadow:0 6px 18px rgba(220,38,38,0.35)}

/* ============ NAV ============ */
.nav{background:white;padding:0 25px;display:flex;gap:2px;border-bottom:1px solid #fed7aa;flex-wrap:wrap;box-shadow:0 2px 8px rgba(0,0,0,0.03)}
.nav a{padding:15px 18px;color:#475569;text-decoration:none;border-bottom:3px solid transparent;transition:0.3s;font-size:0.85rem;display:flex;align-items:center;gap:7px;font-weight:600}
.nav a:hover{color:#ff6b35;background:#fff4e6}
.nav a.active{color:#ff6b35;border-bottom-color:#ff6b35;background:#fff4e6}

/* ============ CONTAINER ============ */
.container{max-width:1500px;margin:28px auto;padding:0 25px}

/* ============ PAGE HEADER ============ */
.page-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px;flex-wrap:wrap;gap:15px}
.page-header h2{font-size:1.7rem;color:#1a1a2e;font-weight:900;display:flex;align-items:center;gap:12px;letter-spacing:-0.5px}
.page-header h2 i{color:#ff6b35}
.page-header .page-subtitle{color:#64748b;font-size:0.88rem;margin-top:4px}

/* ============ STATS ============ */
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:20px;margin-bottom:28px}
.stat-card{background:white;border-radius:18px;padding:24px;position:relative;overflow:hidden;box-shadow:0 6px 20px rgba(255,107,53,0.06);transition:0.3s;border-left:5px solid #ff6b35}
.stat-card:hover{transform:translateY(-5px);box-shadow:0 12px 30px rgba(255,107,53,0.15)}
.stat-card .stat-icon{position:absolute;right:18px;top:18px;font-size:2.8rem;color:#ff6b35;opacity:0.12}
.stat-card .stat-value{font-size:2.2rem;font-weight:900;color:#1a1a2e;line-height:1;letter-spacing:-1px}
.stat-card .stat-label{color:#64748b;font-size:0.75rem;text-transform:uppercase;font-weight:800;letter-spacing:1px;margin-top:10px}
.stat-card.gold{border-left-color:#ffb800}.stat-card.gold .stat-icon{color:#ffb800}
.stat-card.green{border-left-color:#10b981}.stat-card.green .stat-icon{color:#10b981}
.stat-card.purple{border-left-color:#8b5cf6}.stat-card.purple .stat-icon{color:#8b5cf6}
.stat-card.rose{border-left-color:#ec4899}.stat-card.rose .stat-icon{color:#ec4899}
.stat-card.blue{border-left-color:#3b82f6}.stat-card.blue .stat-icon{color:#3b82f6}

/* ============ CARDS ============ */
.card{background:white;border-radius:18px;padding:28px;box-shadow:0 6px 20px rgba(255,107,53,0.06);margin-bottom:22px}
.card-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:12px;padding-bottom:18px;border-bottom:2px solid #fff4e6}
.card-header h3{font-size:1.2rem;color:#1a1a2e;font-weight:800;display:flex;align-items:center;gap:10px}
.card-header h3 i{color:#ff6b35}

/* ============ BUTTONS ============ */
.btn{padding:11px 20px;border:none;border-radius:10px;cursor:pointer;font-weight:700;display:inline-flex;align-items:center;gap:8px;text-decoration:none;transition:0.3s;font-size:0.85rem;letter-spacing:0.3px}
.btn-primary{background:linear-gradient(135deg,#ff6b35,#f7931e);color:white;box-shadow:0 6px 16px rgba(255,107,53,0.3)}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(255,107,53,0.4)}
.btn-success{background:linear-gradient(135deg,#10b981,#059669);color:white}
